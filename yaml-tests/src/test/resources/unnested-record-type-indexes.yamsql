---
options:
  supported_version: !current_version
---
# Indexes on unnested record types, with one unnesting and with several.
#
# `mv_split` requires a synthetic record type: `reviewer` and `rating` both come from one review, but `region` (a
# column of the parent row) sits between them.
#
# The other three tables repeat that shape over an unnesting that is harder to reach:
#   `resta.urant$t` has non-protobuf compliant names
#   `item`          holds its array under a chain of non-repeated structs
#   `book`          holds structs inside the elements of its array
#   `venue`         names its own primary key in the index key
#
# `kiosk`, `shop`, `stall` and `booth` hold the same rows under different combinations of an index on the stored table
# and an index on the synthetic type, to test which of the two the planner picks.
#
# The last three tables have an index with more than one unnesting, so their synthetic types have one nested
# constituent per unnesting:
#   `trip`  unnests two sibling arrays, `stops` and `riders`
#   `team`  unnests the same array, `members`, twice, so it indexes every pair of members of a team
#   `store` unnests `shelves`, an array inside the elements of `aisles`, so one unnesting is nested in the other
# An index entry exists for every combination of the unnested elements, so a row with an empty array has no entries,
# and a query that unnests fewer arrays than the index produces different rows and must not be answered by it.
#
# The remaining tables cover other ways to define such an index:
#   `crate`  defines it on a view, with CREATE INDEX ... ON
#   `board`  orders its key with DESC and NULLS LAST
#   `ledger` projects a column it does not order by, has a composite primary key and an ARRAY NOT NULL column
#   `kit`    unnests a struct array and a scalar array, which stays a fan-out
#   `tri`    unnests three sibling arrays
#   `chain`  has two indexes over chained unnestings: one that reads only the outer unnesting, and one that branches
schema_template:
  CREATE TYPE AS STRUCT "review" ("reviewer" STRING, "rating" BIGINT)

  CREATE TABLE "restaurant" ("rest_no" BIGINT, "region" STRING, "reviews" "review" ARRAY, PRIMARY KEY ("rest_no"))
  CREATE INDEX "mv_split" AS
    SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
      FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
     ORDER BY SQ."reviewer", "restaurant"."region", SQ."rating"

  CREATE TYPE AS STRUCT "re.view$t" ("re.viewer" STRING, "ra$ting" BIGINT)
  CREATE TABLE "resta.urant$t" ("rest.no" BIGINT, "re.gion" STRING, "re.views" "re.view$t" ARRAY,
                                PRIMARY KEY ("rest.no"))
  CREATE INDEX "mv.split$esc" AS
    SELECT SQ."re.viewer", "resta.urant$t"."re.gion", SQ."ra$ting"
      FROM "resta.urant$t", (SELECT "re.viewer", "ra$ting" FROM "resta.urant$t"."re.views") AS SQ
     ORDER BY SQ."re.viewer", "resta.urant$t"."re.gion", SQ."ra$ting"

  CREATE TYPE AS STRUCT "tag" ("label" STRING, "weight" BIGINT)
  CREATE TYPE AS STRUCT "tag_set" ("tags" "tag" ARRAY, "note" STRING)
  CREATE TYPE AS STRUCT "item_meta" ("tag_set" "tag_set", "owner" STRING)

  CREATE TABLE "item" ("item_no" BIGINT, "kind" STRING, "meta" "item_meta", PRIMARY KEY ("item_no"))
  CREATE INDEX "mv_deep_array" AS
    SELECT SQ."label", "item"."kind", SQ."weight"
      FROM "item", (SELECT "label", "weight" FROM "item"."meta"."tag_set"."tags") AS SQ
     ORDER BY SQ."label", "item"."kind", SQ."weight"

  CREATE TYPE AS STRUCT "author_name" ("first" STRING, "last" STRING)
  CREATE TYPE AS STRUCT "author" ("name" "author_name", "score" BIGINT)

  CREATE TABLE "book" ("book_no" BIGINT, "title" STRING, "authors" "author" ARRAY, PRIMARY KEY ("book_no"))
  CREATE INDEX "mv_deep_element" AS
    SELECT "a"."name"."last", "book"."title", "a"."score"
      FROM "book", "book"."authors" AS "a"
     ORDER BY "a"."name"."last", "book"."title", "a"."score"

  CREATE TYPE AS STRUCT "slot" ("day" STRING, "seats" BIGINT)
  CREATE TABLE "venue" ("venue_no" BIGINT, "city" STRING, "slots" "slot" ARRAY, PRIMARY KEY ("venue_no"))
  CREATE INDEX "mv_pk_in_key" AS
    SELECT SQ."day", "venue"."venue_no", SQ."seats"
      FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
     ORDER BY SQ."day", "venue"."venue_no", SQ."seats"

  CREATE TYPE AS STRUCT "line" ("sku" STRING, "qty" BIGINT)

  CREATE TABLE "kiosk" ("kiosk_no" BIGINT, "city" STRING, "lines" "line" ARRAY, PRIMARY KEY ("kiosk_no"))
  CREATE INDEX "kiosk_city" AS SELECT "city" FROM "kiosk" ORDER BY "city"

  CREATE TABLE "shop" ("shop_no" BIGINT, "city" STRING, "owner" STRING, "lines" "line" ARRAY, PRIMARY KEY ("shop_no"))
  CREATE INDEX "shop_city" AS SELECT "city" FROM "shop" ORDER BY "city"
  CREATE INDEX "shop_sku_city_qty" AS
    SELECT SQ."sku", "shop"."city", SQ."qty"
      FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
     ORDER BY SQ."sku", "shop"."city", SQ."qty"

  CREATE TABLE "stall" ("stall_no" BIGINT, "city" STRING, "owner" STRING, "lines" "line" ARRAY, PRIMARY KEY ("stall_no"))
  CREATE INDEX "stall_city" AS SELECT "city" FROM "stall" ORDER BY "city"
  CREATE INDEX "stall_city_sku_owner_qty" AS
    SELECT "stall"."city", SQ."sku", "stall"."owner", SQ."qty"
      FROM "stall", (SELECT "sku", "qty" FROM "stall"."lines") AS SQ
     ORDER BY "stall"."city", SQ."sku", "stall"."owner", SQ."qty"

  CREATE TABLE "booth" ("booth_no" BIGINT, "city" STRING, "owner" STRING, "lines" "line" ARRAY, PRIMARY KEY ("booth_no"))
  CREATE INDEX "booth_city_sku_owner_qty" AS
    SELECT "booth"."city", SQ."sku", "booth"."owner", SQ."qty"
      FROM "booth", (SELECT "sku", "qty" FROM "booth"."lines") AS SQ
     ORDER BY "booth"."city", SQ."sku", "booth"."owner", SQ."qty"

  CREATE TYPE AS STRUCT "stop" ("place" STRING, "mins" BIGINT)
  CREATE TYPE AS STRUCT "rider" ("rider_name" STRING, "age" BIGINT)
  CREATE TABLE "trip" ("trip_no" BIGINT, "city" STRING, "stops" "stop" ARRAY, "riders" "rider" ARRAY,
                       PRIMARY KEY ("trip_no"))
  CREATE INDEX "trip_place_city_rider_mins" AS
    SELECT S."place", "trip"."city", R."rider_name", S."mins"
      FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S,
           (SELECT "rider_name" FROM "trip"."riders") AS R
     ORDER BY S."place", "trip"."city", R."rider_name", S."mins"

  CREATE TYPE AS STRUCT "member" ("member_name" STRING, "score" BIGINT, "role" STRING)
  CREATE TABLE "team" ("team_no" BIGINT, "sport" STRING, "members" "member" ARRAY, PRIMARY KEY ("team_no"))
  CREATE INDEX "team_pairs" AS
    SELECT X."member_name", "team"."sport", Y."role", X."score"
      FROM "team", (SELECT "member_name", "score" FROM "team"."members") AS X,
           (SELECT "role" FROM "team"."members") AS Y
     ORDER BY X."member_name", "team"."sport", Y."role", X."score"

  CREATE TYPE AS STRUCT "shelf" ("code" STRING, "qty" BIGINT)
  CREATE TYPE AS STRUCT "aisle" ("label" STRING, "shelves" "shelf" ARRAY)
  CREATE TABLE "store" ("store_no" BIGINT, "city" STRING, "aisles" "aisle" ARRAY, PRIMARY KEY ("store_no"))
  CREATE INDEX "store_code_city_label_qty" AS
    SELECT S."code", "store"."city", A."label", S."qty"
      FROM "store", "store"."aisles" AS A, A."shelves" AS S
     ORDER BY S."code", "store"."city", A."label", S."qty"

  CREATE TYPE AS STRUCT "part" ("pname" STRING, "weight" BIGINT)
  CREATE TABLE "crate" ("crate_no" BIGINT, "dock" STRING, "parts" "part" ARRAY, PRIMARY KEY ("crate_no"))
  CREATE VIEW "crate_view" AS
    SELECT P."pname", "crate"."dock", P."weight" FROM "crate", "crate"."parts" AS P
  CREATE INDEX "crate_view_idx" ON "crate_view"("pname", "dock", "weight")

  CREATE TYPE AS STRUCT "note" ("topic" STRING, "rank" BIGINT)
  CREATE TABLE "board" ("board_no" BIGINT, "zone" STRING, "notes" "note" ARRAY, PRIMARY KEY ("board_no"))
  CREATE INDEX "board_topic_desc" AS
    SELECT N."topic", "board"."zone", N."rank"
      FROM "board", (SELECT "topic", "rank" FROM "board"."notes") AS N
     ORDER BY N."topic" DESC, "board"."zone", N."rank" NULLS LAST

  CREATE TYPE AS STRUCT "ledger_entry" ("ekey" STRING, "eval" BIGINT, "extra" BIGINT)
  CREATE TABLE "ledger" ("ledger_no" BIGINT, "acct" BIGINT, "entries" "ledger_entry" ARRAY NOT NULL,
                         PRIMARY KEY ("ledger_no", "acct"))
  CREATE INDEX "ledger_kv" AS
    SELECT E."ekey", "ledger"."acct", E."eval", E."extra"
      FROM "ledger", (SELECT "ekey", "eval", "extra" FROM "ledger"."entries") AS E
     ORDER BY E."ekey", "ledger"."acct", E."eval"

  CREATE TYPE AS STRUCT "gadget" ("gname" STRING, "price" BIGINT)
  CREATE TABLE "kit" ("kit_no" BIGINT, "gadgets" "gadget" ARRAY, "labels" STRING ARRAY, PRIMARY KEY ("kit_no"))
  CREATE INDEX "kit_mixed" AS
    SELECT G."gname", "lbl", G."price"
      FROM "kit" AS K, K."gadgets" AS G, K."labels" AS "lbl"
     ORDER BY G."gname", "lbl", G."price"

  CREATE TYPE AS STRUCT "ta" ("x" BIGINT, "x2" BIGINT)
  CREATE TYPE AS STRUCT "tb" ("y" BIGINT, "y2" BIGINT)
  CREATE TYPE AS STRUCT "tc" ("z" BIGINT, "z2" BIGINT)
  CREATE TABLE "tri" ("p" BIGINT, "alist" "ta" ARRAY, "blist" "tb" ARRAY, "clist" "tc" ARRAY, PRIMARY KEY ("p"))
  CREATE INDEX "tri_three" AS
    SELECT M."x", N."y", O."z", T."p", M."x2", N."y2", O."z2"
      FROM "tri" AS T, T."alist" AS M, T."blist" AS N, T."clist" AS O
     ORDER BY M."x", N."y", O."z", T."p", M."x2", N."y2", O."z2"

  CREATE TYPE AS STRUCT "cq" ("y" BIGINT, "y2" BIGINT)
  CREATE TYPE AS STRUCT "cp" ("x" BIGINT, "x2" BIGINT, "q" "cq" ARRAY)
  CREATE TYPE AS STRUCT "cr" ("z" BIGINT, "z2" BIGINT)
  CREATE TABLE "chain" ("k" BIGINT, "p" "cp" ARRAY, "r" "cr" ARRAY, PRIMARY KEY ("k"))
  CREATE INDEX "chain_outer_split" AS
    SELECT B."x", A."k", B."x2"
      FROM "chain" AS A, A."p" AS B, B."q" AS C
     ORDER BY B."x", A."k", B."x2"
  CREATE INDEX "chain_branching" AS
    SELECT B."x", A."k", C."y", D."z"
      FROM "chain" AS A, A."p" AS B, B."q" AS C, A."r" AS D
     ORDER BY B."x", A."k", C."y", D."z"
---
setup:
  steps:
    - query: INSERT INTO "restaurant"
             VALUES (1, 'north', [('Alice', 5), ('Bob', 3)]),
                    (2, 'south', [('Carol', 4)]),
                    (3, 'north', [('Dave', 2), ('Alice', 4)])
    - query: INSERT INTO "resta.urant$t"
             VALUES (1, 'north', [('Alice', 5), ('Bob', 3)]),
                    (2, 'south', [('Carol', 4)])
    - query: INSERT INTO "item"
             VALUES (1, 'tool', (([('hammer', 7), ('nail', 2)], 'n1'), 'ann')),
                    (2, 'toy', (([('kite', 4)], 'n2'), 'bob'))
    - query: INSERT INTO "book"
             VALUES (1, 'Dune', [(('Frank', 'Herbert'), 9), (('Brian', 'Herbert'), 5)]),
                    (2, 'Emma', [(('Jane', 'Austen'), 8)])
    - query: INSERT INTO "venue"
             VALUES (1, 'SF', [('mon', 10), ('tue', 20)]),
                    (2, 'LA', [('wed', 5)])
    - query: INSERT INTO "kiosk"
             VALUES (1, 'SF', [('apple', 2), ('pear', 1), ('apple', 2)]),
                    (2, 'LA', [('apple', 5)]),
                    (3, 'SF', [('fig', 7)])
    - query: INSERT INTO "shop"
             VALUES (1, 'SF', 'ann', [('apple', 2), ('pear', 1), ('apple', 2)]),
                    (2, 'LA', 'bob', [('apple', 5)]),
                    (3, 'SF', 'cat', [('fig', 7)])
    - query: INSERT INTO "stall"
             VALUES (1, 'SF', 'ann', [('apple', 2), ('pear', 1), ('apple', 2)]),
                    (2, 'LA', 'bob', [('apple', 5)]),
                    (3, 'SF', 'cat', [('fig', 7)])
    - query: INSERT INTO "booth"
             VALUES (1, 'SF', 'ann', [('apple', 2), ('pear', 1), ('apple', 2)]),
                    (2, 'LA', 'bob', [('apple', 5)]),
                    (3, 'SF', 'cat', [('fig', 7)])
    - query: INSERT INTO "trip"
             VALUES (1, 'SF', [('park', 10), ('pier', 20)], [('ann', 30), ('bob', 40)]),
                    (2, 'LA', [('park', 5)], [('cat', 25)]),
                    (3, 'SF', [('zoo', 15)], [])
    - query: INSERT INTO "team"
             VALUES (1, 'chess', [('ann', 5, 'lead'), ('bob', 3, 'pawn')]),
                    (2, 'go', [('cat', 7, 'lead')])
    - query: INSERT INTO "store"
             VALUES (1, 'SF', [('a1', [('x', 2), ('y', 4)]), ('a2', [('x', 6)])]),
                    (2, 'LA', [('b1', [('y', 1)])]),
                    (3, 'NY', [('c1', [])])
    - query: INSERT INTO "crate"
             VALUES (1, 'east', [('bolt', 2), ('nut', 1)]),
                    (2, 'west', [('bolt', 3)])
    - query: INSERT INTO "board"
             VALUES (1, 'A', [('red', 1), ('blue', null)]),
                    (2, 'B', [('red', 2)])
    - query: INSERT INTO "ledger"
             VALUES (1, 10, [('a', 1, 100), ('b', 2, 200)]),
                    (2, 20, [('a', 3, 300)])
    - query: INSERT INTO "kit"
             VALUES (1, [('drill', 50), ('saw', 30)], ['new', 'sale']),
                    (2, [('drill', 40)], ['old'])
    - query: INSERT INTO "tri"
             VALUES (1, [(1, 10), (2, 20)], [(5, 50)], [(7, 70), (8, 80)]),
                    (2, [(1, 11)], [(6, 60)], [(7, 71)])
    - query: INSERT INTO "chain"
             VALUES (1, [(1, 10, [(5, 50), (6, 60)]), (2, 20, [])], [(7, 70)]),
                    (2, [(3, 30, [(5, 51)])], [(8, 80), (9, 90)])
---
test_block:
  tests:
    -
      # The query the index was defined for. The index supplies the requested ordering, so no sort is needed, and
      # every selected column is in the index key, so the scan is covering.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                ORDER BY SQ."reviewer", "restaurant"."region", SQ."rating"
      - explain: "COVERING(mv_split <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5},
          {reviewer: 'Bob', region: 'north', rating: 3},
          {reviewer: 'Carol', region: 'south', rating: 4},
          {reviewer: 'Dave', region: 'north', rating: 2}]
    -
      # The same unnesting without an ORDER BY. The index still answers it; the result order is not guaranteed.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
      - explain: "COVERING(mv_split <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - unorderedResult: [
          {reviewer: 'Alice', region: 'north', rating: 5},
          {reviewer: 'Bob', region: 'north', rating: 3},
          {reviewer: 'Carol', region: 'south', rating: 4},
          {reviewer: 'Dave', region: 'north', rating: 2},
          {reviewer: 'Alice', region: 'north', rating: 4}]
    -
      # Selecting a prefix of the key rather than all of it.
      - query: SELECT SQ."reviewer"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                ORDER BY SQ."reviewer"
      - explain: "COVERING(mv_split <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer)"
      - result: [
          {reviewer: 'Alice'},
          {reviewer: 'Alice'},
          {reviewer: 'Bob'},
          {reviewer: 'Carol'},
          {reviewer: 'Dave'}]
    -
      # PartiQL-style unnesting binds the array element directly rather than packing it into a subquery tuple. The
      # index is defined with the subquery spelling, but both describe the same unnesting.
      - query: SELECT "r"."reviewer", "restaurant"."region", "r"."rating"
                 FROM "restaurant", "restaurant"."reviews" AS "r"
                ORDER BY "r"."reviewer", "restaurant"."region", "r"."rating"
      - explain: "COVERING(mv_split <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5},
          {reviewer: 'Bob', region: 'north', rating: 3},
          {reviewer: 'Carol', region: 'south', rating: 4},
          {reviewer: 'Dave', region: 'north', rating: 2}]
    -
      # An equality on the leading key column. The index's placeholders live on the same select as the constituents'
      # quantifiers, so a predicate over the unnesting can be matched against them and bind the scan.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice'
      - explain: "COVERING(mv_split [EQUALS promote(@c32 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5}]
    -
      # A full key prefix, spanning the unnesting and the parent row, binds both key columns.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice' AND "restaurant"."region" = 'north'
      - explain: "COVERING(mv_split [EQUALS promote(@c32 AS STRING), EQUALS promote(@c38 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5}]
    -
      # An equality on the unnesting reached through the PartiQL spelling of the same unnesting.
      - query: SELECT "r"."reviewer", "restaurant"."region", "r"."rating"
                 FROM "restaurant", "restaurant"."reviews" AS "r"
                WHERE "r"."reviewer" = 'Alice'
      - explain: "COVERING(mv_split [EQUALS promote(@c25 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5}]
    -
      # A range on the leading key column rather than an equality. The placeholder reserved for that column takes the
      # inequality, so the scan is a one-sided range over the index instead of a scan of all of it with a filter.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" > 'Bob'
      - explain: "COVERING(mv_split [[GREATER_THAN promote(@c32 AS STRING)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Carol', region: 'south', rating: 4},
          {reviewer: 'Dave', region: 'north', rating: 2}]
    -
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" < 'Carol'
      - explain: "COVERING(mv_split [[LESS_THAN promote(@c32 AS STRING)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5},
          {reviewer: 'Bob', region: 'north', rating: 3}]
    -
      # Both sides of the same column, which bound one range rather than two.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" > 'Alice' AND SQ."reviewer" < 'Dave'
      - explain: "COVERING(mv_split [[GREATER_THAN promote(@c32 AS STRING) && LESS_THAN promote(@c38 AS STRING)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Bob', region: 'north', rating: 3},
          {reviewer: 'Carol', region: 'south', rating: 4}]
    -
      # An equality on the leading column followed by a range on the next one. The equality fixes the prefix and the
      # range bounds the column after it, so the two columns still make a single scan range.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice' AND "restaurant"."region" < 'south'
      - explain: "COVERING(mv_split [EQUALS promote(@c32 AS STRING), [LESS_THAN promote(@c38 AS STRING)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [
          {reviewer: 'Alice', region: 'north', rating: 4},
          {reviewer: 'Alice', region: 'north', rating: 5}]
    -
      # Equalities on both leading columns -- one from the unnesting, one from the parent row -- followed by a range on
      # the third.
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice' AND "restaurant"."region" = 'north' AND SQ."rating" > 4
      - explain: "COVERING(mv_split [EQUALS promote(@c32 AS STRING), EQUALS promote(@c38 AS STRING), [GREATER_THAN promote(@c44 AS LONG)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [{reviewer: 'Alice', region: 'north', rating: 5}]
    -
      - query: SELECT SQ."reviewer", "restaurant"."region", SQ."rating"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice' AND "restaurant"."region" = 'north' AND SQ."rating" < 5
      - explain: "COVERING(mv_split [EQUALS promote(@c32 AS STRING), EQUALS promote(@c38 AS STRING), [LESS_THAN promote(@c44 AS LONG)]] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [region: KEY:[1], rest_no: KEY:[4, 1]], unnesting_0: [rating: KEY:[2], reviewer: KEY:[0]]]) | MAP (_.unnesting_0.reviewer AS reviewer, _.parent.region AS region, _.unnesting_0.rating AS rating)"
      - result: [{reviewer: 'Alice', region: 'north', rating: 4}]
---
# Identifiers a protobuf field cannot be named after. Every name on the path to the unnesting -- the table, the array,
# and the columns of its elements -- needs escaping, and the index only matches if the candidate and the query agree on
# the escaped names.
test_block:
  name: escaped-identifiers
  tests:
    -
      - query: SELECT SQ."re.viewer", "resta.urant$t"."re.gion", SQ."ra$ting"
                 FROM "resta.urant$t", (SELECT "re.viewer", "ra$ting" FROM "resta.urant$t"."re.views") AS SQ
                ORDER BY SQ."re.viewer", "resta.urant$t"."re.gion", SQ."ra$ting"
      - explain: "COVERING(mv.split$esc <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [re__2gion: KEY:[1], rest__2no: KEY:[4, 1]], unnesting_0: [ra__1ting: KEY:[2], re__2viewer: KEY:[0]]]) | MAP (_.unnesting_0.re.viewer AS re.viewer, _.parent.re.gion AS re.gion, _.unnesting_0.ra$ting AS ra$ting)"
      - result: [
          {'re.viewer': 'Alice', 're.gion': 'north', 'ra$ting': 5},
          {'re.viewer': 'Bob', 're.gion': 'north', 'ra$ting': 3},
          {'re.viewer': 'Carol', 're.gion': 'south', 'ra$ting': 4}]
    -
      # The PartiQL spelling of the same unnesting, with the array reached through an escaped name.
      - query: SELECT "r"."re.viewer", "resta.urant$t"."re.gion", "r"."ra$ting"
                 FROM "resta.urant$t", "resta.urant$t"."re.views" AS "r"
                ORDER BY "r"."re.viewer", "resta.urant$t"."re.gion", "r"."ra$ting"
      - explain: "COVERING(mv.split$esc <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [re__2gion: KEY:[1], rest__2no: KEY:[4, 1]], unnesting_0: [ra__1ting: KEY:[2], re__2viewer: KEY:[0]]]) | MAP (_.unnesting_0.re.viewer AS re.viewer, _.parent.re.gion AS re.gion, _.unnesting_0.ra$ting AS ra$ting)"
      - result: [
          {'re.viewer': 'Alice', 're.gion': 'north', 'ra$ting': 5},
          {'re.viewer': 'Bob', 're.gion': 'north', 'ra$ting': 3},
          {'re.viewer': 'Carol', 're.gion': 'south', 'ra$ting': 4}]
    -
      # An equality on the leading key column binds the scan, so the escaped names also have to line up between the
      # query's predicate value and the candidate's placeholder.
      - query: SELECT SQ."re.viewer", "resta.urant$t"."re.gion", SQ."ra$ting"
                 FROM "resta.urant$t", (SELECT "re.viewer", "ra$ting" FROM "resta.urant$t"."re.views") AS SQ
                WHERE SQ."re.viewer" = 'Alice'
      - explain: "COVERING(mv.split$esc [EQUALS promote(@c32 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [re__2gion: KEY:[1], rest__2no: KEY:[4, 1]], unnesting_0: [ra__1ting: KEY:[2], re__2viewer: KEY:[0]]]) | MAP (_.unnesting_0.re.viewer AS re.viewer, _.parent.re.gion AS re.gion, _.unnesting_0.ra$ting AS ra$ting)"
      - result: [{'re.viewer': 'Alice', 're.gion': 'north', 'ra$ting': 5}]
---
# An array under a chain of non-repeated structs: the constituent's nesting expression is `meta.tag_set.tags` rather
# than a single field, so the explode's collection value is a path of field accesses.
test_block:
  name: deeply-nested-array
  tests:
    -
      - query: SELECT SQ."label", "item"."kind", SQ."weight"
                 FROM "item", (SELECT "label", "weight" FROM "item"."meta"."tag_set"."tags") AS SQ
                ORDER BY SQ."label", "item"."kind", SQ."weight"
      - explain: "COVERING(mv_deep_array <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [item_no: KEY:[4, 1], kind: KEY:[1]], unnesting_0: [label: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.label AS label, _.parent.kind AS kind, _.unnesting_0.weight AS weight)"
      - result: [
          {label: 'hammer', kind: 'tool', weight: 7},
          {label: 'kite', kind: 'toy', weight: 4},
          {label: 'nail', kind: 'tool', weight: 2}]
    -
      - query: SELECT "t"."label", "item"."kind", "t"."weight"
                 FROM "item", "item"."meta"."tag_set"."tags" AS "t"
                ORDER BY "t"."label", "item"."kind", "t"."weight"
      - explain: "COVERING(mv_deep_array <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [item_no: KEY:[4, 1], kind: KEY:[1]], unnesting_0: [label: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.label AS label, _.parent.kind AS kind, _.unnesting_0.weight AS weight)"
      - result: [
          {label: 'hammer', kind: 'tool', weight: 7},
          {label: 'kite', kind: 'toy', weight: 4},
          {label: 'nail', kind: 'tool', weight: 2}]
    -
      - query: SELECT SQ."label", "item"."kind", SQ."weight"
                 FROM "item", (SELECT "label", "weight" FROM "item"."meta"."tag_set"."tags") AS SQ
                WHERE SQ."label" = 'hammer'
      - explain: "COVERING(mv_deep_array [EQUALS promote(@c36 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [item_no: KEY:[4, 1], kind: KEY:[1]], unnesting_0: [label: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.label AS label, _.parent.kind AS kind, _.unnesting_0.weight AS weight)"
      - result: [{label: 'hammer', kind: 'tool', weight: 7}]
---
# An array whose elements carry a struct of their own, with a key column reached through it: `a.name.last` is a path
# into the exploded element rather than one of its fields.
test_block:
  name: deeply-nested-element
  tests:
    -
      - query: SELECT "a"."name"."last" AS "last", "book"."title", "a"."score"
                 FROM "book", "book"."authors" AS "a"
                ORDER BY "a"."name"."last", "book"."title", "a"."score"
      - explain: "COVERING(mv_deep_element <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [book_no: KEY:[4, 1], title: KEY:[1]], unnesting_0: [score: KEY:[2], name: [last: KEY:[0]]]]) | MAP (_.unnesting_0.name.last AS last, _.parent.title AS title, _.unnesting_0.score AS score)"
      - result: [
          {last: 'Austen', title: 'Emma', score: 8},
          {last: 'Herbert', title: 'Dune', score: 5},
          {last: 'Herbert', title: 'Dune', score: 9}]
    -
      # The subquery spelling of the same unnesting, flowing the element's struct and reaching into it outside.
      - query: SELECT SQ."name"."last" AS "last", "book"."title", SQ."score"
                 FROM "book", (SELECT "name", "score" FROM "book"."authors") AS SQ
                ORDER BY SQ."name"."last", "book"."title", SQ."score"
      - explain: "COVERING(mv_deep_element <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [book_no: KEY:[4, 1], title: KEY:[1]], unnesting_0: [score: KEY:[2], name: [last: KEY:[0]]]]) | MAP (_.unnesting_0.name.last AS last, _.parent.title AS title, _.unnesting_0.score AS score)"
      - result: [
          {last: 'Austen', title: 'Emma', score: 8},
          {last: 'Herbert', title: 'Dune', score: 5},
          {last: 'Herbert', title: 'Dune', score: 9}]
    -
      - query: SELECT "a"."name"."last" AS "last", "book"."title", "a"."score"
                 FROM "book", "book"."authors" AS "a"
                WHERE "a"."name"."last" = 'Herbert'
                ORDER BY "a"."name"."last", "book"."title", "a"."score"
      - explain: "COVERING(mv_deep_element [EQUALS promote(@c31 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [book_no: KEY:[4, 1], title: KEY:[1]], unnesting_0: [score: KEY:[2], name: [last: KEY:[0]]]]) | MAP (_.unnesting_0.name.last AS last, _.parent.title AS title, _.unnesting_0.score AS score)"
      - result: [
          {last: 'Herbert', title: 'Dune', score: 5},
          {last: 'Herbert', title: 'Dune', score: 9}]
---
# The parent table's primary key named in the index key, where the synthetic type's primary key already carries it. An
# index over an unnesting does not trim the redundant component, so the column is simply stored twice.
test_block:
  name: primary-key-in-index-key
  tests:
    -
      - query: SELECT SQ."day", "venue"."venue_no", SQ."seats"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
                ORDER BY SQ."day", "venue"."venue_no", SQ."seats"
      # `unnesting_0` sits at KEY:[5, 0] rather than KEY:[4, 0], so position 4 still holds the parent's primary key --
      # `venue_no` really is in the entry twice. The covering map reads it from KEY:[1], the index key position, as the
      # decoder keeps the first occurrence it finds and so never descends into the nested tuple for it.
      - explain: "COVERING(mv_pk_in_key <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [venue_no: KEY:[1]], unnesting_0: [day: KEY:[0], seats: KEY:[2]]]) | MAP (_.unnesting_0.day AS day, _.parent.venue_no AS venue_no, _.unnesting_0.seats AS seats)"
      - result: [
          {day: 'mon', venue_no: 1, seats: 10},
          {day: 'tue', venue_no: 1, seats: 20},
          {day: 'wed', venue_no: 2, seats: 5}]
    -
      - query: SELECT SQ."day", "venue"."venue_no", SQ."seats"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
                WHERE SQ."day" = 'mon' AND "venue"."venue_no" = 1
      # Being carried twice costs the column nothing: the occurrence in the index key is an ordinary scalar position, so
      # it still has a placeholder of its own and both predicates bind the scan.
      - explain: "COVERING(mv_pk_in_key [EQUALS promote(@c32 AS STRING), EQUALS promote(@c38 AS LONG)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [venue_no: KEY:[1]], unnesting_0: [day: KEY:[0], seats: KEY:[2]]]) | MAP (_.unnesting_0.day AS day, _.parent.venue_no AS venue_no, _.unnesting_0.seats AS seats)"
      - result: [{day: 'mon', venue_no: 1, seats: 10}]
    -
      - query: SELECT SQ."seats"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
                ORDER BY SQ."day", "venue"."venue_no", SQ."seats"
      # The sort columns are not selected, so the covering scan flows them for the sort and a second MAP drops them
      # again. `venue_no` is read from KEY:[1] here too, even though it is only wanted for the ordering.
      - explain: "COVERING(mv_pk_in_key <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [venue_no: KEY:[1]], unnesting_0: [day: KEY:[0], seats: KEY:[2]]]) | MAP (_.unnesting_0.seats AS seats, _.unnesting_0.day AS day, _.parent.venue_no AS venue_no) | MAP (_.seats AS seats)"
      - result: [{seats: 10}, {seats: 20}, {seats: 5}]
---
# Queries that select a column the index does not store.
test_block:
  name: index-scan-with-fetch
  tests:
    -
      - query: SELECT "venue"."city", SQ."day", SQ."seats"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
                WHERE SQ."day" = 'mon'
      - explain: "ISCAN(mv_pk_in_key [EQUALS promote(@c32 AS STRING)]) | MAP (_.parent.city AS city, _.unnesting_0.day AS day, _.unnesting_0.seats AS seats)"
      - result: [{city: 'SF', day: 'mon', seats: 10}]
    -
      - query: SELECT "venue"."city", SQ."day"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
                ORDER BY SQ."day"
      - explain: "ISCAN(mv_pk_in_key <,>) | MAP (_.parent.city AS city, _.unnesting_0.day AS day)"
      - result: [{city: 'SF', day: 'mon'}, {city: 'SF', day: 'tue'}, {city: 'LA', day: 'wed'}]
    -
      - query: SELECT "a"."name"."first" AS "first", "a"."name"."last" AS "last", "book"."title"
                 FROM "book", "book"."authors" AS "a"
                WHERE "a"."name"."last" = 'Herbert'
                ORDER BY "a"."name"."last", "book"."title", "a"."score"
      - explain: "ISCAN(mv_deep_element [EQUALS promote(@c35 AS STRING)]) | MAP (_.unnesting_0.name.first AS first, _.unnesting_0.name.last AS last, _.parent.title AS title, _.unnesting_0.score AS score) | MAP (_.first AS first, _.last AS last, _.title AS title)"
      - result: [
          {first: 'Brian', last: 'Herbert', title: 'Dune'},
          {first: 'Frank', last: 'Herbert', title: 'Dune'}]
    -
      - query: SELECT "item"."meta"."owner" AS "owner", SQ."label", SQ."weight"
                 FROM "item", (SELECT "label", "weight" FROM "item"."meta"."tag_set"."tags") AS SQ
                WHERE SQ."label" = 'hammer'
      - explain: "ISCAN(mv_deep_array [EQUALS promote(@c40 AS STRING)]) | MAP (_.parent.meta.owner AS owner, _.unnesting_0.label AS label, _.unnesting_0.weight AS weight)"
      - result: [{owner: 'ann', label: 'hammer', weight: 7}]
---
# Aggregates over an unnesting whose index is a plain (non-aggregate) index.
test_block:
  name: aggregations
  tests:
    -
      # no grouping
      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
      - query: SELECT COUNT(*) AS "n"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
      - explain: "ISCAN(mv_split <,>) | MAP (_.parent AS _0, _.unnesting_0 AS _1) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL | MAP (coalesce_long(_._0._0, 0l) AS n)"
      - result: [{n: 5}]
    -
      # no grouping
      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
      - query: SELECT SUM(SQ."rating") AS "total"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
      - explain: "ISCAN(mv_split <,>) | MAP (_.parent AS _0, _.unnesting_0 AS _1) | AGG (sum_l(_._1.rating) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS total)"
      - result: [{total: 18}]
    -
      # Grouping on the leading key column, which the index already orders by.
      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
      - query: SELECT SQ."reviewer" AS "reviewer", COUNT(*) AS "n"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
             GROUP BY SQ."reviewer"
      - explain: "ISCAN(mv_split <,>) | MAP (_.parent AS _0, _.unnesting_0 AS _1) | AGG (count_star(*) AS _0) GROUP BY (_._1.reviewer AS _0) | MAP (_._0._0 AS reviewer, _._1._0 AS n)"
      - unorderedResult: [
          {reviewer: 'Alice', n: 2},
          {reviewer: 'Bob', n: 1},
          {reviewer: 'Carol', n: 1},
          {reviewer: 'Dave', n: 1}]
    -
      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
      - query: SELECT SQ."reviewer" AS "reviewer", SUM(SQ."rating") AS "total", MAX(SQ."rating") AS "best"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
             GROUP BY SQ."reviewer"
      - explain: "ISCAN(mv_split <,>) | MAP (_.parent AS _0, _.unnesting_0 AS _1) | AGG (sum_l(_._1.rating) AS _0, max_l(_._1.rating) AS _1) GROUP BY (_._1.reviewer AS _0) | MAP (_._0._0 AS reviewer, _._1._0 AS total, _._1._1 AS best)"
      - unorderedResult: [
          {reviewer: 'Alice', total: 9, best: 5},
          {reviewer: 'Bob', total: 3, best: 3},
          {reviewer: 'Carol', total: 4, best: 4},
          {reviewer: 'Dave', total: 2, best: 2}]
    -
      - query: SELECT "restaurant"."region" AS "region", COUNT(*) AS "n"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
             GROUP BY "restaurant"."region"
      - error: "0AF02"
    -
      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
      - query: SELECT SUM(SQ."rating") AS "total"
                 FROM "restaurant", (SELECT "reviewer", "rating" FROM "restaurant"."reviews") AS SQ
                WHERE SQ."reviewer" = 'Alice'
      - explain: "ISCAN(mv_split [EQUALS promote(@c29 AS STRING)]) | MAP (_.parent AS _0, _.unnesting_0 AS _1) | AGG (sum_l(_._1.rating) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS total)"
      - result: [{total: 9}]
#    -
#      # TODO Issue #4720: every column read is in the index, so this should be a covering scan.
#      - query: SELECT "a"."name"."last" AS "last", MAX("a"."score") AS "best"
#                 FROM "book", "book"."authors" AS "a"
#             GROUP BY "a"."name"."last"
#      - explain: "ISCAN(mv_deep_element <,>) | MAP (_.parent AS _0, (_.unnesting_0 AS _0) AS _1) | AGG (max_l(_._1._0.score) AS _0) GROUP BY (_._1._0.name.last AS _0) | MAP (_._0._0 AS last, _._1._0 AS best)"
#      - unorderedResult: [{last: 'Austen', best: 8}, {last: 'Herbert', best: 9}]
    -
      - query: SELECT "venue"."venue_no" AS "venue_no", SUM(SQ."seats") AS "total"
                 FROM "venue", (SELECT "day", "seats" FROM "venue"."slots") AS SQ
             GROUP BY "venue"."venue_no"
      - explain: "SCAN([IS venue]) | FLATMAP q0 -> { TF explode(q0.slots) AS q1 RETURN (q0 AS _0, q1._0 AS _1) } | AGG (sum_l(_._1.seats) AS _0) GROUP BY (_._0.venue_no AS _0) | MAP (_._0._0 AS venue_no, _._1._0 AS total)"
      - unorderedResult: [{venue_no: 1, total: 30}, {venue_no: 2, total: 5}]
---
# These tests focus on which index the planner picks when a query that unnests could use either an index on the stored
# table or an index on the synthetic type.
#
# An index on the stored table only serves the parent leg (explode is nested-loop joined):
#   ISCAN(<stored table index>) | FLATMAP q0 -> { EXPLODE q0.lines ... }
# On the other hand, an index on the synthetic record type serves both legs together, so it applies only to a query
# that unnests.
#
# The cost model, hence, play a decisive role - prefer plan with fewer residual predicates, and only on a tie the plan
# with fewer fetches.
test_block:
  name: stored-table-index-vs-synthetic-type-index
  tests:
    -
      # only simple index.
      - query: SELECT "kiosk"."kiosk_no", SQ."sku", SQ."qty"
                 FROM "kiosk", (SELECT "sku", "qty" FROM "kiosk"."lines") AS SQ
                WHERE "kiosk"."city" = 'SF'
      - explain: "ISCAN(kiosk_city [EQUALS promote(@c32 AS STRING)]) | FLATMAP q0 -> { TF explode(q0.lines) AS q1 RETURN (q0.kiosk_no AS kiosk_no, q1._0.sku AS sku, q1._0.qty AS qty) }"
      - unorderedResult: [
          {kiosk_no: 1, sku: 'apple', qty: 2},
          {kiosk_no: 1, sku: 'pear', qty: 1},
          {kiosk_no: 1, sku: 'apple', qty: 2},
          {kiosk_no: 3, sku: 'fig', qty: 7}]
    -
      # simple index with binding, and residual `sku = 'apple'` filters on explode
      # produces.
      - query: SELECT "kiosk"."kiosk_no", SQ."qty"
                 FROM "kiosk", (SELECT "sku", "qty" FROM "kiosk"."lines") AS SQ
                WHERE "kiosk"."city" = 'SF' AND SQ."sku" = 'apple'
      - explain: "ISCAN(kiosk_city [EQUALS promote(@c28 AS STRING)]) | FLATMAP q0 -> { TF explode(q0.lines) | FILTER _._0.sku EQUALS promote(@c34 AS STRING) AS q1 RETURN (q0.kiosk_no AS kiosk_no, q1._0.qty AS qty) }"
      - unorderedResult: [{kiosk_no: 1, qty: 2}, {kiosk_no: 1, qty: 2}]
    -
      # both index considered. simple index has lesser number of predicates. The index on the synthetic type covers the
      # query but cannot seek on `city`.
      - query: SELECT "shop"."shop_no", SQ."sku", SQ."qty"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE "shop"."city" = 'SF'
      - explain: "ISCAN(shop_city [EQUALS promote(@c32 AS STRING)]) | FLATMAP q0 -> { TF explode(q0.lines) AS q1 RETURN (q0.shop_no AS shop_no, q1._0.sku AS sku, q1._0.qty AS qty) }"
      - unorderedResult: [
          {shop_no: 1, sku: 'apple', qty: 2},
          {shop_no: 1, sku: 'pear', qty: 1},
          {shop_no: 1, sku: 'apple', qty: 2},
          {shop_no: 3, sku: 'fig', qty: 7}]
    -
      # `sku` only. index on the synthetic type is covering and absorbs the predicate.
      - query: SELECT "shop"."city", SQ."qty"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE SQ."sku" = 'apple'
      - explain: "COVERING(shop_sku_city_qty [EQUALS promote(@c28 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [city: KEY:[1], shop_no: KEY:[4, 1]], unnesting_0: [qty: KEY:[2], sku: KEY:[0]]]) | MAP (_.parent.city AS city, _.unnesting_0.qty AS qty)"
      - unorderedResult: [{city: 'SF', qty: 2}, {city: 'SF', qty: 2}, {city: 'LA', qty: 5}]
    -
      # 2 predicates. index on the synthetic type absorbs more predicates (both).
      - query: SELECT SQ."qty"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE SQ."sku" = 'apple' AND "shop"."city" = 'SF'
      - explain: "COVERING(shop_sku_city_qty [EQUALS promote(@c24 AS STRING), EQUALS promote(@c30 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [city: KEY:[1], shop_no: KEY:[4, 1]], unnesting_0: [qty: KEY:[2], sku: KEY:[0]]]) | MAP (_.unnesting_0.qty AS qty)"
      - unorderedResult: [{qty: 2}, {qty: 2}]
    -
      # both index would need to fetch. index on the stored table applies it.
      - query: SELECT "shop"."owner", SQ."sku"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE "shop"."city" = 'SF'
      - explain: "ISCAN(shop_city [EQUALS promote(@c28 AS STRING)]) | FLATMAP q0 -> { TF explode(q0.lines) AS q1 RETURN (q0.owner AS owner, q1._0.sku AS sku) }"
      - unorderedResult: [
          {owner: 'ann', sku: 'apple'},
          {owner: 'ann', sku: 'pear'},
          {owner: 'ann', sku: 'apple'},
          {owner: 'cat', sku: 'fig'}]
    -
      - query: SELECT "shop"."owner", SQ."qty"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE SQ."sku" = 'apple'
      - explain: "ISCAN(shop_sku_city_qty [EQUALS promote(@c28 AS STRING)]) | MAP (_.parent.owner AS owner, _.unnesting_0.qty AS qty)"
      - unorderedResult: [{owner: 'ann', qty: 2}, {owner: 'ann', qty: 2}, {owner: 'bob', qty: 5}]
    -
      - query: SELECT "shop"."owner", SQ."qty"
                 FROM "shop", (SELECT "sku", "qty" FROM "shop"."lines") AS SQ
                WHERE "shop"."city" = 'SF' AND SQ."sku" = 'apple'
      - explain: "ISCAN(shop_sku_city_qty [EQUALS promote(@c34 AS STRING), EQUALS promote(@c28 AS STRING)]) | MAP (_.parent.owner AS owner, _.unnesting_0.qty AS qty)"
      - unorderedResult: [{owner: 'ann', qty: 2}, {owner: 'ann', qty: 2}]
    -
      # Both indexes absorb predicate. Covering index (on synthetic record type) wins.
      - query: SELECT "stall"."stall_no", "stall"."owner", SQ."sku", SQ."qty"
                 FROM "stall", (SELECT "sku", "qty" FROM "stall"."lines") AS SQ
                WHERE "stall"."city" = 'SF'
      - explain: "COVERING(stall_city_sku_owner_qty [EQUALS promote(@c36 AS STRING)] -> [__positions: [unnesting_0: KEY:[6, 0]], parent: [city: KEY:[0], owner: KEY:[2], stall_no: KEY:[5, 1]], unnesting_0: [qty: KEY:[3], sku: KEY:[1]]]) | MAP (_.parent.stall_no AS stall_no, _.parent.owner AS owner, _.unnesting_0.sku AS sku, _.unnesting_0.qty AS qty)"
      - unorderedResult: [
          {stall_no: 1, owner: 'ann', sku: 'apple', qty: 2},
          {stall_no: 1, owner: 'ann', sku: 'pear', qty: 1},
          {stall_no: 1, owner: 'ann', sku: 'apple', qty: 2},
          {stall_no: 3, owner: 'cat', sku: 'fig', qty: 7}]
    -
      # no unnesting, the index on the synthetic type does not apply.
      - query: SELECT "stall_no", "owner" FROM "stall" WHERE "city" = 'SF'
      - explain: "ISCAN(stall_city [EQUALS promote(@c9 AS STRING)]) | MAP (_.stall_no AS stall_no, _.owner AS owner)"
      - unorderedResult: [{stall_no: 1, owner: 'ann'}, {stall_no: 3, owner: 'cat'}]
    -
      # no index on the stored table and the index on the synthetic type does not apply. Fall back to primary scan.
      - query: SELECT "booth_no", "owner" FROM "booth" WHERE "city" = 'SF'
      - explain: "SCAN([IS booth]) | FILTER _.city EQUALS promote(@c9 AS STRING) | MAP (_.booth_no AS booth_no, _.owner AS owner)"
      - unorderedResult: [{booth_no: 1, owner: 'ann'}, {booth_no: 3, owner: 'cat'}]
---
test_block:
  name: sibling-unnestings
  tests:
    -
      # The query the index was defined for: one row per stop and rider of a trip. Trip 3 has no riders, so it has
      # no rows.
      - query: SELECT S."place", "trip"."city", R."rider_name", S."mins"
                 FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S,
                      (SELECT "rider_name" FROM "trip"."riders") AS R
                ORDER BY S."place", "trip"."city", R."rider_name", S."mins"
      - explain: "COVERING(trip_place_city_rider_mins <,> -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - result: [
          {place: 'park', city: 'LA', rider_name: 'cat', mins: 5},
          {place: 'park', city: 'SF', rider_name: 'ann', mins: 10},
          {place: 'park', city: 'SF', rider_name: 'bob', mins: 10},
          {place: 'pier', city: 'SF', rider_name: 'ann', mins: 20},
          {place: 'pier', city: 'SF', rider_name: 'bob', mins: 20}]
    -
      # The PartiQL spelling of the same two unnestings.
      - query: SELECT "s"."place", "trip"."city", "r"."rider_name", "s"."mins"
                 FROM "trip", "trip"."stops" AS "s", "trip"."riders" AS "r"
                ORDER BY "s"."place", "trip"."city", "r"."rider_name", "s"."mins"
      - explain: "COVERING(trip_place_city_rider_mins <,> -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - result: [
          {place: 'park', city: 'LA', rider_name: 'cat', mins: 5},
          {place: 'park', city: 'SF', rider_name: 'ann', mins: 10},
          {place: 'park', city: 'SF', rider_name: 'bob', mins: 10},
          {place: 'pier', city: 'SF', rider_name: 'ann', mins: 20},
          {place: 'pier', city: 'SF', rider_name: 'bob', mins: 20}]
    -
      # The unnestings listed in the other order.
      - query: SELECT S."place", "trip"."city", R."rider_name", S."mins"
                 FROM "trip", (SELECT "rider_name" FROM "trip"."riders") AS R,
                      (SELECT "place", "mins" FROM "trip"."stops") AS S
                ORDER BY S."place", "trip"."city", R."rider_name", S."mins"
      - explain: "COVERING(trip_place_city_rider_mins <,> -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - result: [
          {place: 'park', city: 'LA', rider_name: 'cat', mins: 5},
          {place: 'park', city: 'SF', rider_name: 'ann', mins: 10},
          {place: 'park', city: 'SF', rider_name: 'bob', mins: 10},
          {place: 'pier', city: 'SF', rider_name: 'ann', mins: 20},
          {place: 'pier', city: 'SF', rider_name: 'bob', mins: 20}]
    -
      # An equality on the leading column, from the first unnesting.
      - query: SELECT S."place", "trip"."city", R."rider_name", S."mins"
                 FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S,
                      (SELECT "rider_name" FROM "trip"."riders") AS R
                WHERE S."place" = 'park'
      - explain: "COVERING(trip_place_city_rider_mins [EQUALS promote(@c47 AS STRING)] -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - unorderedResult: [
          {place: 'park', city: 'LA', rider_name: 'cat', mins: 5},
          {place: 'park', city: 'SF', rider_name: 'ann', mins: 10},
          {place: 'park', city: 'SF', rider_name: 'bob', mins: 10}]
    -
      # Equalities on a key prefix that spans the first unnesting, the parent row and the second unnesting.
      - query: SELECT S."place", "trip"."city", R."rider_name", S."mins"
                 FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S,
                      (SELECT "rider_name" FROM "trip"."riders") AS R
                WHERE S."place" = 'park' AND "trip"."city" = 'SF' AND R."rider_name" = 'bob'
      - explain: "COVERING(trip_place_city_rider_mins [EQUALS promote(@c47 AS STRING), EQUALS promote(@c53 AS STRING), EQUALS promote(@c59 AS STRING)] -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - result: [
          {place: 'park', city: 'SF', rider_name: 'bob', mins: 10}]
    -
      # A range on the leading column.
      - query: SELECT S."place", "trip"."city", R."rider_name", S."mins"
                 FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S,
                      (SELECT "rider_name" FROM "trip"."riders") AS R
                WHERE S."place" > 'park'
      - explain: "COVERING(trip_place_city_rider_mins [[GREATER_THAN promote(@c47 AS STRING)]] -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [city: KEY:[1], trip_no: KEY:[5, 1]], unnesting_0: [mins: KEY:[3], place: KEY:[0]], unnesting_1: [rider_name: KEY:[2]]]) | MAP (_.unnesting_0.place AS place, _.parent.city AS city, _.unnesting_1.rider_name AS rider_name, _.unnesting_0.mins AS mins)"
      - unorderedResult: [
          {place: 'pier', city: 'SF', rider_name: 'ann', mins: 20},
          {place: 'pier', city: 'SF', rider_name: 'bob', mins: 20}]
    -
      # Only one of the two unnestings. The index has an entry per stop and rider, and none for trip 3, so it cannot
      # answer this query, which has one row per stop.
      - query: SELECT S."place", "trip"."city", S."mins"
                 FROM "trip", (SELECT "place", "mins" FROM "trip"."stops") AS S
      - explain: "SCAN([IS trip]) | FLATMAP q0 -> { TF explode(q0.stops) AS q1 RETURN (q1._0.place AS place, q0.city AS city, q1._0.mins AS mins) }"
      - unorderedResult: [
          {place: 'park', city: 'SF', mins: 10},
          {place: 'pier', city: 'SF', mins: 20},
          {place: 'park', city: 'LA', mins: 5},
          {place: 'zoo', city: 'SF', mins: 15}]
---
test_block:
  name: same-array-unnested-twice
  tests:
    -
      # The query the index was defined for: one row per ordered pair of members of a team, including a member
      # paired with itself.
      - query: SELECT X."member_name", "team"."sport", Y."role", X."score"
                 FROM "team", (SELECT "member_name", "score" FROM "team"."members") AS X,
                      (SELECT "role" FROM "team"."members") AS Y
                ORDER BY X."member_name", "team"."sport", Y."role", X."score"
      - explain: "COVERING(team_pairs <,> -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [sport: KEY:[1], team_no: KEY:[5, 1]], unnesting_0: [member_name: KEY:[0], score: KEY:[3]], unnesting_1: [role: KEY:[2]]]) | MAP (_.unnesting_0.member_name AS member_name, _.parent.sport AS sport, _.unnesting_1.role AS role, _.unnesting_0.score AS score)"
      - result: [
          {member_name: 'ann', sport: 'chess', role: 'lead', score: 5},
          {member_name: 'ann', sport: 'chess', role: 'pawn', score: 5},
          {member_name: 'bob', sport: 'chess', role: 'lead', score: 3},
          {member_name: 'bob', sport: 'chess', role: 'pawn', score: 3},
          {member_name: 'cat', sport: 'go', role: 'lead', score: 7}]
    -
      # An equality on the leading column, from the first of the two unnestings.
      - query: SELECT X."member_name", "team"."sport", Y."role", X."score"
                 FROM "team", (SELECT "member_name", "score" FROM "team"."members") AS X,
                      (SELECT "role" FROM "team"."members") AS Y
                WHERE X."member_name" = 'bob'
      - explain: "COVERING(team_pairs [EQUALS promote(@c47 AS STRING)] -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [sport: KEY:[1], team_no: KEY:[5, 1]], unnesting_0: [member_name: KEY:[0], score: KEY:[3]], unnesting_1: [role: KEY:[2]]]) | MAP (_.unnesting_0.member_name AS member_name, _.parent.sport AS sport, _.unnesting_1.role AS role, _.unnesting_0.score AS score)"
      - unorderedResult: [
          {member_name: 'bob', sport: 'chess', role: 'lead', score: 3},
          {member_name: 'bob', sport: 'chess', role: 'pawn', score: 3}]
    -
      # Equalities on a key prefix that reaches into the second unnesting of the same array.
      - query: SELECT X."member_name", "team"."sport", Y."role", X."score"
                 FROM "team", (SELECT "member_name", "score" FROM "team"."members") AS X,
                      (SELECT "role" FROM "team"."members") AS Y
                WHERE X."member_name" = 'ann' AND "team"."sport" = 'chess' AND Y."role" = 'pawn'
      - explain: "COVERING(team_pairs [EQUALS promote(@c47 AS STRING), EQUALS promote(@c53 AS STRING), EQUALS promote(@c59 AS STRING)] -> [__positions: [unnesting_0: KEY:[6, 0], unnesting_1: KEY:[7, 0]], parent: [sport: KEY:[1], team_no: KEY:[5, 1]], unnesting_0: [member_name: KEY:[0], score: KEY:[3]], unnesting_1: [role: KEY:[2]]]) | MAP (_.unnesting_0.member_name AS member_name, _.parent.sport AS sport, _.unnesting_1.role AS role, _.unnesting_0.score AS score)"
      - result: [
          {member_name: 'ann', sport: 'chess', role: 'pawn', score: 5}]
    -
      # A single unnesting of the array. The index has an entry per pair of members, so it cannot answer this query,
      # which has one row per member.
      - query: SELECT X."member_name", "team"."sport", X."score"
                 FROM "team", (SELECT "member_name", "score" FROM "team"."members") AS X
      - explain: "SCAN([IS team]) | FLATMAP q0 -> { TF explode(q0.members) AS q1 RETURN (q1._0.member_name AS member_name, q0.sport AS sport, q1._0.score AS score) }"
      - unorderedResult: [
          {member_name: 'ann', sport: 'chess', score: 5},
          {member_name: 'bob', sport: 'chess', score: 3},
          {member_name: 'cat', sport: 'go', score: 7}]
---
test_block:
  name: nested-unnestings
  # TODO: the index on the nested unnesting is not matched yet, so these queries scan `store` and explode both arrays,
  #       and a query that needs the order of the index cannot be planned at all.
  tests:
    -
      # The query the index was defined for. It needs the order of the index, which no other plan provides.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", "store"."aisles" AS A, A."shelves" AS S
                ORDER BY S."code", "store"."city", A."label", S."qty"
      - error: "0AF02"
    -
      # The same query without the ORDER BY: one row per shelf of an aisle of a store. Aisle `c1` has no shelves, so
      # store 3 has no rows.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", "store"."aisles" AS A, A."shelves" AS S
      - explain: "SCAN([IS store]) | FLATMAP q0 -> { TF explode(q0.aisles) | FLATMAP q1 -> { TF explode(q1._0.shelves) AS q2 RETURN (q1 AS _0, q2 AS _1) } AS q3 RETURN (q3._1._0.code AS code, q0.city AS city, q3._0._0.label AS label, q3._1._0.qty AS qty) }"
      - unorderedResult: [
          {code: 'x', city: 'SF', label: 'a1', qty: 2},
          {code: 'x', city: 'SF', label: 'a2', qty: 6},
          {code: 'y', city: 'LA', label: 'b1', qty: 1},
          {code: 'y', city: 'SF', label: 'a1', qty: 4}]
    -
      # The subquery spelling of the same two unnestings.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", (SELECT * FROM "store"."aisles") AS A, (SELECT * FROM A."shelves") AS S
      - explain: "SCAN([IS store]) | FLATMAP q0 -> { TF explode(q0.aisles) | FLATMAP q1 -> { TF explode(q1._0.shelves) AS q2 RETURN (q1 AS _0, q2 AS _1) } AS q3 RETURN (q3._1._0.code AS code, q0.city AS city, q3._0._0.label AS label, q3._1._0.qty AS qty) }"
      - unorderedResult: [
          {code: 'x', city: 'SF', label: 'a1', qty: 2},
          {code: 'x', city: 'SF', label: 'a2', qty: 6},
          {code: 'y', city: 'LA', label: 'b1', qty: 1},
          {code: 'y', city: 'SF', label: 'a1', qty: 4}]
    -
      # An equality on the leading column, from the inner unnesting.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", "store"."aisles" AS A, A."shelves" AS S
                WHERE S."code" = 'x'
      - explain: "SCAN([IS store]) | FLATMAP q0 -> { TF explode(q0.aisles) | FLATMAP q1 -> { TF explode(q1._0.shelves) | FILTER _._0.code EQUALS promote(@c35 AS STRING) AS q2 RETURN (q2 AS _0, q1 AS _1) } AS q3 RETURN (q3._0._0.code AS code, q0.city AS city, q3._1._0.label AS label, q3._0._0.qty AS qty) }"
      - unorderedResult: [
          {code: 'x', city: 'SF', label: 'a1', qty: 2},
          {code: 'x', city: 'SF', label: 'a2', qty: 6}]
    -
      # Equalities on a key prefix that spans the inner unnesting, the parent row and the outer unnesting.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", "store"."aisles" AS A, A."shelves" AS S
                WHERE S."code" = 'x' AND "store"."city" = 'SF' AND A."label" = 'a2'
      - explain: "SCAN([IS store]) | FILTER _.city EQUALS promote(@c41 AS STRING) | FLATMAP q0 -> { TF explode(q0.aisles) | FLATMAP q1 -> { TF explode(q1._0.shelves) | FILTER _._0.code EQUALS promote(@c35 AS STRING) AND q1._0.label EQUALS promote(@c47 AS STRING) | MAP (q1 AS _0, _ AS _1) AS q2 RETURN q2 } AS q3 RETURN (q3._1._0.code AS code, q0.city AS city, q3._0._0.label AS label, q3._1._0.qty AS qty) }"
      - result: [
          {code: 'x', city: 'SF', label: 'a2', qty: 6}]
    -
      # A range on the leading column.
      - query: SELECT S."code", "store"."city", A."label", S."qty"
                 FROM "store", "store"."aisles" AS A, A."shelves" AS S
                WHERE S."code" > 'x'
      - explain: "SCAN([IS store]) | FLATMAP q0 -> { TF explode(q0.aisles) | FLATMAP q1 -> { TF explode(q1._0.shelves) | FILTER _._0.code GREATER_THAN promote(@c35 AS STRING) AS q2 RETURN (q2 AS _0, q1 AS _1) } AS q3 RETURN (q3._0._0.code AS code, q0.city AS city, q3._1._0.label AS label, q3._0._0.qty AS qty) }"
      - unorderedResult: [
          {code: 'y', city: 'LA', label: 'b1', qty: 1},
          {code: 'y', city: 'SF', label: 'a1', qty: 4}]
    -
      # Only the outer unnesting. The index has an entry per shelf, and none for aisle `c1`, so it cannot answer this
      # query, which has one row per aisle.
      - query: SELECT A."label", "store"."city"
                 FROM "store", "store"."aisles" AS A
      - explain: "SCAN([IS store]) | FLATMAP q0 -> { TF explode(q0.aisles) AS q1 RETURN (q1._0.label AS label, q0.city AS city) }"
      - unorderedResult: [
          {label: 'a1', city: 'SF'},
          {label: 'a2', city: 'SF'},
          {label: 'b1', city: 'LA'},
          {label: 'c1', city: 'NY'}]
---
test_block:
  name: index-over-view
  tests:
    -
      # The index is defined on a view over the unnesting rather than with CREATE INDEX ... AS SELECT.
      - query: SELECT P."pname", "crate"."dock", P."weight"
                 FROM "crate", "crate"."parts" AS P
                ORDER BY P."pname", "crate"."dock", P."weight"
      - explain: "COVERING(crate_view_idx <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [crate_no: KEY:[4, 1], dock: KEY:[1]], unnesting_0: [pname: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.pname AS pname, _.parent.dock AS dock, _.unnesting_0.weight AS weight)"
      - result: [
          {pname: 'bolt', dock: 'east', weight: 2},
          {pname: 'bolt', dock: 'west', weight: 3},
          {pname: 'nut', dock: 'east', weight: 1}]
    -
      # Reading the view itself.
      - query: SELECT "pname", "dock", "weight" FROM "crate_view" ORDER BY "pname", "dock", "weight"
      - explain: "COVERING(crate_view_idx <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [crate_no: KEY:[4, 1], dock: KEY:[1]], unnesting_0: [pname: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.pname AS pname, _.parent.dock AS dock, _.unnesting_0.weight AS weight) | MAP (_.pname AS pname, _.dock AS dock, _.weight AS weight)"
      - result: [
          {pname: 'bolt', dock: 'east', weight: 2},
          {pname: 'bolt', dock: 'west', weight: 3},
          {pname: 'nut', dock: 'east', weight: 1}]
    -
      - query: SELECT P."pname", "crate"."dock", P."weight"
                 FROM "crate", "crate"."parts" AS P
                WHERE P."pname" = 'bolt'
      - explain: "COVERING(crate_view_idx [EQUALS promote(@c25 AS STRING)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [crate_no: KEY:[4, 1], dock: KEY:[1]], unnesting_0: [pname: KEY:[0], weight: KEY:[2]]]) | MAP (_.unnesting_0.pname AS pname, _.parent.dock AS dock, _.unnesting_0.weight AS weight)"
      - unorderedResult: [
          {pname: 'bolt', dock: 'east', weight: 2},
          {pname: 'bolt', dock: 'west', weight: 3}]
---
test_block:
  name: ordering-directions
  tests:
    -
      # The order of the index: `topic` descending, and a null `rank` last.
      - query: SELECT N."topic", "board"."zone", N."rank"
                 FROM "board", (SELECT "topic", "rank" FROM "board"."notes") AS N
                ORDER BY N."topic" DESC, "board"."zone", N."rank" NULLS LAST
      - explain: "COVERING(board_topic_desc <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [board_no: KEY:[4, 1], zone: KEY:[1]], unnesting_0: [rank: from_ordered_bytes(KEY:[2], ASC_NULLS_LAST), topic: from_ordered_bytes(KEY:[0], DESC_NULLS_LAST)]]) | MAP (_.unnesting_0.topic AS topic, _.parent.zone AS zone, _.unnesting_0.rank AS rank)"
      - result: [
          {topic: 'red', zone: 'A', rank: 1},
          {topic: 'red', zone: 'B', rank: 2},
          {topic: 'blue', zone: 'A', rank: !null _}]
    -
      # The reverse of the order of the index.
      - query: SELECT N."topic", "board"."zone", N."rank"
                 FROM "board", (SELECT "topic", "rank" FROM "board"."notes") AS N
                ORDER BY N."topic" ASC NULLS FIRST, "board"."zone" DESC NULLS LAST, N."rank" DESC NULLS FIRST
      - explain: "COVERING(board_topic_desc <,> REVERSE -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [board_no: KEY:[4, 1], zone: KEY:[1]], unnesting_0: [rank: from_ordered_bytes(KEY:[2], ASC_NULLS_LAST), topic: from_ordered_bytes(KEY:[0], DESC_NULLS_LAST)]]) | MAP (_.unnesting_0.topic AS topic, _.parent.zone AS zone, _.unnesting_0.rank AS rank)"
      - result: [
          {topic: 'blue', zone: 'A', rank: !null _},
          {topic: 'red', zone: 'B', rank: 2},
          {topic: 'red', zone: 'A', rank: 1}]
    -
      - query: SELECT N."topic", "board"."zone", N."rank"
                 FROM "board", (SELECT "topic", "rank" FROM "board"."notes") AS N
                WHERE N."topic" = 'red'
      - explain: "COVERING(board_topic_desc [EQUALS to_ordered_bytes(promote(@c32 AS STRING), DESC_NULLS_LAST)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [board_no: KEY:[4, 1], zone: KEY:[1]], unnesting_0: [rank: from_ordered_bytes(KEY:[2], ASC_NULLS_LAST), topic: from_ordered_bytes(KEY:[0], DESC_NULLS_LAST)]]) | MAP (_.unnesting_0.topic AS topic, _.parent.zone AS zone, _.unnesting_0.rank AS rank)"
      - unorderedResult: [
          {topic: 'red', zone: 'A', rank: 1},
          {topic: 'red', zone: 'B', rank: 2}]
---
test_block:
  name: key-with-value
  tests:
    -
      # `extra` is projected by the index but not ordered by, so it is in the value of the index entry rather than in
      # its key. The table has a composite primary key and an `ARRAY NOT NULL` column.
      - query: SELECT E."ekey", "ledger"."acct", E."eval", E."extra"
                 FROM "ledger", (SELECT "ekey", "eval", "extra" FROM "ledger"."entries") AS E
                ORDER BY E."ekey", "ledger"."acct", E."eval"
      - explain: "COVERING(ledger_kv <,> -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [acct: KEY:[1], ledger_no: KEY:[4, 1]], unnesting_0: [ekey: KEY:[0], eval: KEY:[2], extra: VALUE:[0]]]) | MAP (_.unnesting_0.ekey AS ekey, _.parent.acct AS acct, _.unnesting_0.eval AS eval, _.unnesting_0.extra AS extra)"
      - result: [
          {ekey: 'a', acct: 10, eval: 1, extra: 100},
          {ekey: 'a', acct: 20, eval: 3, extra: 300},
          {ekey: 'b', acct: 10, eval: 2, extra: 200}]
    -
      - query: SELECT E."ekey", "ledger"."acct", E."eval", E."extra"
                 FROM "ledger", (SELECT "ekey", "eval", "extra" FROM "ledger"."entries") AS E
                WHERE E."ekey" = 'a' AND "ledger"."acct" = 20
      - explain: "COVERING(ledger_kv [EQUALS promote(@c38 AS STRING), EQUALS promote(@c44 AS LONG)] -> [__positions: [unnesting_0: KEY:[5, 0]], parent: [acct: KEY:[1], ledger_no: KEY:[4, 1]], unnesting_0: [ekey: KEY:[0], eval: KEY:[2], extra: VALUE:[0]]]) | MAP (_.unnesting_0.ekey AS ekey, _.parent.acct AS acct, _.unnesting_0.eval AS eval, _.unnesting_0.extra AS extra)"
      - result: [
          {ekey: 'a', acct: 20, eval: 3, extra: 300}]
---
test_block:
  name: struct-and-scalar-unnestings
  # TODO: the index over a struct array and a scalar array is not matched yet, so these queries scan `kit`, and a query
  #       that needs the order of the index cannot be planned at all.
  tests:
    -
      # A struct array and a scalar array. Only the struct array becomes a nested constituent; the scalar array is
      # fanned out under the parent. The query needs the order of the index, which no other plan provides.
      - query: SELECT G."gname", "lbl", G."price"
                 FROM "kit" AS K, K."gadgets" AS G, K."labels" AS "lbl"
                ORDER BY G."gname", "lbl", G."price"
      - error: "0AF02"
    -
      # The same query without the ORDER BY: one row per gadget and label of a kit.
      - query: SELECT G."gname", "lbl", G."price"
                 FROM "kit" AS K, K."gadgets" AS G, K."labels" AS "lbl"
      - explain: "SCAN([IS kit]) | FLATMAP q0 -> { TF explode(q0.gadgets) | FLATMAP q1 -> { TF explode(q0.labels) AS q2 RETURN (q1 AS _0, q2 AS _1) } AS q3 RETURN (q3._0._0.gname AS gname, q3._1._0 AS lbl, q3._0._0.price AS price) }"
      - unorderedResult: [
          {gname: 'drill', lbl: 'new', price: 50},
          {gname: 'drill', lbl: 'old', price: 40},
          {gname: 'drill', lbl: 'sale', price: 50},
          {gname: 'saw', lbl: 'new', price: 30},
          {gname: 'saw', lbl: 'sale', price: 30}]
    -
      - query: SELECT G."gname", "lbl", G."price"
                 FROM "kit" AS K, K."gadgets" AS G, K."labels" AS "lbl"
                WHERE G."gname" = 'drill' AND "lbl" = 'old'
      - explain: "SCAN([IS kit]) | FLATMAP q0 -> { TF explode(q0.labels) | FILTER _._0 EQUALS @c35 | FLATMAP q1 -> { TF explode(q0.gadgets) | FILTER _._0.gname EQUALS promote(@c31 AS STRING) AS q2 RETURN (q2 AS _0, q1 AS _1) } AS q3 RETURN (q3._0._0.gname AS gname, q3._1._0 AS lbl, q3._0._0.price AS price) }"
      - result: [
          {gname: 'drill', lbl: 'old', price: 40}]
    -
      # Only the struct array. The index has an entry per gadget and label, so it cannot answer this query.
      - query: SELECT G."gname", G."price"
                 FROM "kit" AS K, K."gadgets" AS G
      - explain: "SCAN([IS kit]) | FLATMAP q0 -> { TF explode(q0.gadgets) AS q1 RETURN (q1._0.gname AS gname, q1._0.price AS price) }"
      - unorderedResult: [
          {gname: 'drill', price: 50},
          {gname: 'saw', price: 30},
          {gname: 'drill', price: 40}]
---
test_block:
  name: three-sibling-unnestings
  tests:
    -
      - query: SELECT M."x", N."y", O."z", T."p", M."x2", N."y2", O."z2"
                 FROM "tri" AS T, T."alist" AS M, T."blist" AS N, T."clist" AS O
                ORDER BY M."x", N."y", O."z", T."p", M."x2", N."y2", O."z2"
      - explain: "COVERING(tri_three <,> -> [__positions: [unnesting_0: KEY:[9, 0], unnesting_1: KEY:[10, 0], unnesting_2: KEY:[11, 0]], parent: [p: KEY:[3]], unnesting_0: [x: KEY:[0], x2: KEY:[4]], unnesting_1: [y: KEY:[1], y2: KEY:[5]], unnesting_2: [z: KEY:[2], z2: KEY:[6]]]) | MAP (_.unnesting_0.x AS x, _.unnesting_1.y AS y, _.unnesting_2.z AS z, _.parent.p AS p, _.unnesting_0.x2 AS x2, _.unnesting_1.y2 AS y2, _.unnesting_2.z2 AS z2)"
      - result: [
          {x: 1, y: 5, z: 7, p: 1, x2: 10, y2: 50, z2: 70},
          {x: 1, y: 5, z: 8, p: 1, x2: 10, y2: 50, z2: 80},
          {x: 1, y: 6, z: 7, p: 2, x2: 11, y2: 60, z2: 71},
          {x: 2, y: 5, z: 7, p: 1, x2: 20, y2: 50, z2: 70},
          {x: 2, y: 5, z: 8, p: 1, x2: 20, y2: 50, z2: 80}]
    -
      # Equalities on the leading column of each of the three unnestings.
      - query: SELECT M."x", N."y", O."z", T."p", M."x2", N."y2", O."z2"
                 FROM "tri" AS T, T."alist" AS M, T."blist" AS N, T."clist" AS O
                WHERE M."x" = 1 AND N."y" = 5 AND O."z" = 8
      - explain: "COVERING(tri_three [EQUALS promote(@c55 AS LONG), EQUALS promote(@c61 AS LONG), EQUALS promote(@c67 AS LONG)] -> [__positions: [unnesting_0: KEY:[9, 0], unnesting_1: KEY:[10, 0], unnesting_2: KEY:[11, 0]], parent: [p: KEY:[3]], unnesting_0: [x: KEY:[0], x2: KEY:[4]], unnesting_1: [y: KEY:[1], y2: KEY:[5]], unnesting_2: [z: KEY:[2], z2: KEY:[6]]]) | MAP (_.unnesting_0.x AS x, _.unnesting_1.y AS y, _.unnesting_2.z AS z, _.parent.p AS p, _.unnesting_0.x2 AS x2, _.unnesting_1.y2 AS y2, _.unnesting_2.z2 AS z2)"
      - result: [
          {x: 1, y: 5, z: 8, p: 1, x2: 10, y2: 50, z2: 80}]
---
test_block:
  name: chained-unnesting-shapes
  # TODO: indexes on nested unnestings are not matched yet (see `nested-unnestings`), so these queries scan `chain`.
  tests:
    -
      # `chain_outer_split` reads only the outer unnesting, but the inner one is part of its definition, so it has an
      # entry per element of `q`: two for the first element of `p` of row 1, none for its second, whose `q` is empty.
      - query: SELECT B."x", A."k", B."x2"
                 FROM "chain" AS A, A."p" AS B, B."q" AS C
      - explain: "SCAN([IS chain]) | FLATMAP q0 -> { TF explode(q0.p) | FLATMAP q1 -> { TF explode(q1._0.q) AS q2 RETURN q1 } AS q1 RETURN (q1._0.x AS x, q0.k AS k, q1._0.x2 AS x2) }"
      - unorderedResult: [
          {x: 1, k: 1, x2: 10},
          {x: 1, k: 1, x2: 10},
          {x: 3, k: 2, x2: 30}]
    -
      # Without the inner unnesting there is one row per element of `p`, which `chain_outer_split` cannot answer.
      - query: SELECT B."x", A."k", B."x2"
                 FROM "chain" AS A, A."p" AS B
      - explain: "SCAN([IS chain]) | FLATMAP q0 -> { TF explode(q0.p) AS q1 RETURN (q1._0.x AS x, q0.k AS k, q1._0.x2 AS x2) }"
      - unorderedResult: [
          {x: 1, k: 1, x2: 10},
          {x: 2, k: 1, x2: 20},
          {x: 3, k: 2, x2: 30}]
    -
      # `chain_branching` unnests `q` inside `p`, and `r` beside `p`.
      - query: SELECT B."x", A."k", C."y", D."z"
                 FROM "chain" AS A, A."p" AS B, B."q" AS C, A."r" AS D
      - explain: "SCAN([IS chain]) | FLATMAP q0 -> { TF explode(q0.r) | FLATMAP q1 -> { TF explode(q0.p) | FLATMAP q2 -> { TF explode(q2._0.q) AS q3 RETURN (q2 AS _0, q3 AS _1) } AS q4 RETURN (q4 AS _0, q1 AS _1) } AS q5 RETURN (q5._0._0._0.x AS x, q0.k AS k, q5._0._1._0.y AS y, q5._1._0.z AS z) }"
      - unorderedResult: [
          {x: 1, k: 1, y: 5, z: 7},
          {x: 1, k: 1, y: 6, z: 7},
          {x: 3, k: 2, y: 5, z: 8},
          {x: 3, k: 2, y: 5, z: 9}]
---
setup:
  connect: 0
  steps:
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_aggregate
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_predicate
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_version
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_arithmetic
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_scalar_twice
    - query: DROP SCHEMA TEMPLATE IF EXISTS unnested_rejected_join
---
# Index definitions that would need an unnested synthetic table, but that it does not support.
test_block:
  name: unsupported-index-definitions
  connect: 0
  preset: single_repetition_ordered
  tests:
    -
      # An aggregate index.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_aggregate
                 CREATE TYPE AS STRUCT A(x bigint, x2 bigint)
                 CREATE TABLE T(p bigint, a A array, primary key(p))
                 CREATE INDEX mv1 AS SELECT M.x, t.p, SUM(M.x2) FROM T AS t, t.a AS M GROUP BY M.x, t.p ORDER BY M.x, t.p
      - error: UNSUPPORTED_OPERATION
    -
      # A predicate in the index definition.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_predicate
                 CREATE TYPE AS STRUCT A(col2 string, col3 bigint, col4 bigint)
                 CREATE TABLE T1(col1 bigint, a A Array, col5 bigint, primary key(col1))
                 CREATE INDEX mv1 AS SELECT X.col2, T1.col5, X.col3 FROM T1, (SELECT col2, col3 FROM T1.A) X
                   WHERE T1.col5 > 10 ORDER BY X.col2, T1.col5, X.col3
      - error: UNSUPPORTED_OPERATION
    -
      # The row version as an index column.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_version
                 CREATE TYPE AS STRUCT A(col2 string, col3 bigint, col4 bigint)
                 CREATE TABLE T1(col1 bigint, a A Array, primary key(col1))
                 CREATE INDEX mv1 AS SELECT X.col2, T1."__ROW_VERSION", X.col3, X.col4 FROM T1, (SELECT col2, col3, col4 FROM T1.A) X
                   ORDER BY X.col2, T1."__ROW_VERSION", X.col3
                 WITH OPTIONS(store_row_versions=true)
      - error: UNSUPPORTED_OPERATION
    -
      # A computed column rather than a plain column reference.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_arithmetic
                 CREATE TYPE AS STRUCT A(col2 string, col3 bigint, col4 bigint)
                 CREATE TABLE T1(col1 bigint, a A Array, col5 bigint, primary key(col1))
                 CREATE INDEX mv1 AS SELECT X.col2, T1.col5, X.col3, T1.col5 + 1 AS pp FROM T1, (SELECT col2, col3 FROM T1.A) X
                   ORDER BY X.col2, T1.col5, X.col3, pp
      - error: UNSUPPORTED_OPERATION
    -
      # One unnesting of a scalar array at two key positions.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_scalar_twice
                 CREATE TYPE AS STRUCT A(col2 string, col3 bigint)
                 CREATE TABLE T1(col1 bigint, a A Array, s string array, primary key(col1))
                 CREATE INDEX mv1 AS SELECT X.col2, V.s AS v1, X.col3, V.s AS v2 FROM T1, (SELECT col2, col3 FROM T1.A) X,
                   (SELECT s FROM T1.S) V ORDER BY X.col2, v1, X.col3, v2
      - error: UNSUPPORTED_OPERATION
    -
      # An unnesting combined with a join of two tables.
      - query: CREATE SCHEMA TEMPLATE unnested_rejected_join
                 CREATE TYPE AS STRUCT A(x bigint, y bigint)
                 CREATE TABLE T1(id bigint, a A array, primary key(id))
                 CREATE TABLE T2(id bigint, y bigint, primary key(id))
                 CREATE INDEX mv1 AS SELECT M.x, b.y, M.y FROM T1 AS a, T2 AS b, a.a AS M ORDER BY M.x, b.y, M.y
      - error: UNSUPPORTED_OPERATION
...
