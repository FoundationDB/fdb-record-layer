array-agg-with-aggregate-indexyEXPLAIN SELECT t.id, sq.vals FROM T1 t, (SELECT ARRAY_AGG((d.*)) AS vals FROM T4 d WHERE d.grp = t.grp) sq WHERE t.id = 1ñ#
‹Ô·¯Ô ˆﬂ€(R0ª·‹8c@ÅSCAN([IS T1, EQUALS promote(@c42 AS LONG)]) | FLATMAP q0 -> { ISCAN(T4_grp [EQUALS q0.grp]) | MAP (_ AS _0) | AGG (array_agg((_._0.id AS id, _._0.grp AS grp, _._0.val AS val)) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (q0.id AS id, q0._0._0 AS vals) }Ú digraph G {
