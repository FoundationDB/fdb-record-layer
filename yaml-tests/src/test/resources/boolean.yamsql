---
schema_template:
    create table lb(a bigint, b boolean, primary key(a))
---
setup:
  steps:
    - query: insert into lb values (1, true), (2, false), (3, null), (4, true), (5, false);
---
test_block:
  name: boolean-tests
  tests:
    -
      - query: select lb.* from lb where B = true
      - unorderedResult: [ { 1,true }, { 4,true } ]
    -
      - query: select lb.* from lb where B = false
      - unorderedResult: [ { 2, false }, { 5, false } ]
    -
      - query: select lb.* from lb where B <> TRUE
      - unorderedResult: [ { 2, false }, { 5, false } ]
    -
      - query: select lb.* from lb where B <> FALSE
      - unorderedResult: [ { 1, true }, { 4, true } ]
    -
      - query: select lb.* from lb where B is true
      - unorderedResult: [ { 1,true }, { 4,true } ]
    -
      - query: select lb.* from lb where B is false
      - unorderedResult: [ { 2,false }, { 5,false } ]
    -
      - query: select lb.* from lb where B is null
      - result: [ { 3, !null } ]
    -
      - query: select lb.* from lb where B is not true
      - unorderedResult: [ { A: 2, B: false }, { A: 3, B: !null }, { A: 5, B: false } ]
    -
      - query: select lb.* from lb where B is not false
      - unorderedResult: [ { 1,true }, { 3, !null }, { 4,true } ]
    -
      - query: select lb.* from lb where B is not null
      - unorderedResult: [ { 1,true }, { 2, false }, { 4,true }, { 5,false } ]
    -
      - query: select B = true from lb
      - result: [ { true }, { false }, { !null }, { true }, { false } ]
    -
      - query: select B = false from lb
      - result: [ { false }, { true }, { !null }, { false }, { true } ]
    -
      - query: select B <> TRUE from lb
      - result: [ { false }, { true }, { !null }, { false }, { true } ]
    -
      - query: select B <> FALSE from lb
      - result: [ { true }, { false }, { !null }, { true }, { false } ]
    -
      - query: select B IS TRUE from lb
      - result: [ { true }, { false }, { false }, { true }, { false } ]
    -
      - query: select B IS FALSE from lb
      - result: [ { false }, { true }, { false}, { false }, { true } ]
    -
      - query: select B IS NULL FROM lb
      - result: [ { false }, { false }, { true }, { false }, { false } ]
    -
      - query: select B IS NOT TRUE from lb
      - result: [ { false }, { true }, { true }, { false }, { true } ]
    -
      - query: select B IS NOT FALSE from lb
      - result: [ { true }, { false }, { true }, { true }, { false } ]
    -
      - query: select B IS NOT NULL from lb
      - result: [ { true }, { true }, { false }, { true }, { true } ]
    -
      - query: select B AND TRUE from lb
      - result: [ { true }, { false }, { !null }, { true }, { false } ]
    -
      - query: select B AND FALSE from lb
      - result: [ { false }, { false }, { false }, { false }, { false } ]
    -
      - query: select B AND NULL from lb
      - result: [ { !null }, { false }, { !null }, { !null }, { false } ]
    -
      - query: select B OR TRUE from lb
      - result: [ { true }, { true }, { true }, { true }, { true } ]
    -
      - query: select B OR FALSE from lb
      - result: [ { true }, { false }, { !null }, { true }, { false } ]
    -
      - query: select B OR NULL from lb
      - result: [ { true }, { !null }, { !null }, { true }, { !null } ]
    -
      - query: select NOT B from lb
      - result: [ { false }, { true }, { !null }, { false }, { true } ]
...
---
# All queries above only put AND/OR/NOT in the select list, where the value is never converted to a
# QueryPredicate. This block exercises the same operators in a WHERE clause, where a boolean literal, constant,
# or column (anything that isn't a BooleanValue) is just as legitimate an operand as a comparison.
test_block:
  name: boolean-predicate-conjunction-tests
  options:
    # Not yet supported by any released version -- older servers still fail here with an internal error.
    supported_version: !current_version
  tests:
    -
      # `true` here is a query-context literal, so it becomes a ConstantObjectValue (not a LiteralValue), and is
      # therefore not constant-folded away by AndOrValue's short-circuit logic -- both conjuncts remain in the plan.
      - query: select a from lb where a > 1 and true;
      - explain: "SCAN([IS LB, [GREATER_THAN promote(@c7 AS LONG)]]) | MAP (_.A AS A)"
      - unorderedResult: [ {2}, {3}, {4}, {5} ]
    -
      - query: select a from lb where true and a > 1;
      - explain: "SCAN([IS LB, [GREATER_THAN promote(@c9 AS LONG)]]) | MAP (_.A AS A)"
      - unorderedResult: [ {2}, {3}, {4}, {5} ]
    -
      - query: select a from lb where b and b;
      - explain: "SCAN([IS LB]) | FILTER _.B EQUALS true | MAP (_.A AS A)"
      - unorderedResult: [ {1}, {4} ]
    -
      - query: select a from lb where a < 3 or b;
      - explain: "SCAN([IS LB]) | FILTER _.A LESS_THAN promote(@c7 AS LONG) OR _.B EQUALS true | MAP (_.A AS A)"
      - unorderedResult: [ {1}, {2}, {4} ]
    -
      - query: select a from lb where not b;
      - explain: "SCAN([IS LB]) | FILTER _.B NOT_EQUALS true | MAP (_.A AS A)"
      - unorderedResult: [ {2}, {5} ]
    -
      # Baseline: the boolean value as the *entire* predicate (no conjunction) already works today.
      - query: select a from lb where true;
      - explain: "SCAN([IS LB]) | MAP (_.A AS A)"
      - unorderedResult: [ {1}, {2}, {3}, {4}, {5} ]
    -
      - query: select a from lb where b;
      - explain: "SCAN([IS LB]) | FILTER _.B EQUALS true | MAP (_.A AS A)"
      - unorderedResult: [ {1}, {4} ]
    -
      # Baseline: both children of AND are RelOpValues, not boolean-typed leaves -- already works today.
      - query: select a from lb where a > 1 and 1 = 1;
      - explain: "SCAN([IS LB, [GREATER_THAN promote(@c7 AS LONG)]]) | FILTER @c7 EQUALS @c7 | MAP (_.A AS A)"
      - unorderedResult: [ {2}, {3}, {4}, {5} ]
...
