---
options:
  supported_version: 4.12.6.0
---
schema_template:
    CREATE TABLE "l" ("id" BIGINT, "k" BIGINT, "v" STRING, PRIMARY KEY ("id"))
    CREATE TABLE "r" ("id" BIGINT, "k" BIGINT, "w" STRING, PRIMARY KEY ("id"))
    CREATE INDEX "r$k" AS SELECT "k" FROM "r" ORDER BY "k"
---
setup:
  steps:
    - query:
        INSERT INTO "l"
        VALUES (1, 10, 'a'),
               (2, 20, 'b'),
               (3, NULL, 'c'),
               (4, 10, 'd')
    - query:
        INSERT INTO "r"
        VALUES (1, 10, 'x'),
               (2, 10, 'y'),
               (3, NULL, 'z'),
               (4, 30, 'w')
---
test_block:
  name: left-outer-join-auto-qa
  preset: single_repetition_ordered
  tests:
    -
      # NULL join keys on both sides must never match each other, and duplicate matches on the right are all returned.
      - query: SELECT "l"."id", "r"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k";
      - unorderedResult: [
          {!l 1, 'x'},
          {!l 1, 'y'},
          {!l 2, !null _},
          {!l 3, !null _},
          {!l 4, 'x'},
          {!l 4, 'y'}]
    -
      # An ON-clause predicate on the preserved side only restricts matching; it must not remove preserved rows.
      - query: SELECT "l"."id", "r"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" AND "l"."v" = 'a';
      - unorderedResult: [
          {!l 1, 'x'},
          {!l 1, 'y'},
          {!l 2, !null _},
          {!l 3, !null _},
          {!l 4, !null _}]
    -
      # Null-accepting WHERE predicate (COALESCE) on the null-supplying side must be evaluated after null-padding.
      - query: SELECT "l"."id" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" WHERE COALESCE("r"."w", 'none') = 'none';
      - unorderedResult: [
          {!l 2},
          {!l 3}]
    -
      # NOT over a comparison with a null-padded column is UNKNOWN and must reject the null-padded rows.
      - query: SELECT "l"."id", "r"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" WHERE NOT ("r"."w" = 'x');
      - unorderedResult: [
          {!l 1, 'y'},
          {!l 4, 'y'}]
    -
      # A WHERE IS NULL over a derived table wrapping the LEFT JOIN must not be pushed below the outer join.
      - query: SELECT "sq"."lid" FROM (SELECT "l"."id" AS "lid", "r"."w" AS "rw" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k") "sq" WHERE "sq"."rw" IS NULL;
      - unorderedResult: [
          {!l 2},
          {!l 3}]
    -
      # Second LEFT JOIN correlated to the null-supplying side of the first: null-padded rows stay null-padded.
      - query: SELECT "l"."id", "r"."w", "r2"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" LEFT JOIN "r" "r2" ON "r2"."id" = "r"."id" + 2;
      - unorderedResult: [
          {!l 1, 'x', 'z'},
          {!l 1, 'y', 'w'},
          {!l 2, !pos 2: !null _, !pos 3: !null _},
          {!l 3, !pos 2: !null _, !pos 3: !null _},
          {!l 4, 'x', 'z'},
          {!l 4, 'y', 'w'}]
    -
      # LEFT JOIN against a grouped derived table: the NULL group must not match the left row with a NULL key.
      - query: SELECT "l"."id", "g"."c" FROM "l" LEFT JOIN (SELECT "k", COUNT(*) AS "c" FROM "r" GROUP BY "k") "g" ON "l"."k" = "g"."k";
      - unorderedResult: [
          {!l 1, !l 2},
          {!l 2, !null _},
          {!l 3, !null _},
          {!l 4, !l 2}]
    -
      # Continuations over a LEFT JOIN ordered by the preserved side, crossing matched and null-padded rows.
      - query: SELECT "l"."id", "r"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" ORDER BY "l"."id";
      - maxRows: 2
      - unorderedResult: [{!l 1, 'x'}, {!l 1, 'y'}]
      - unorderedResult: [{!l 2, !null _}, {!l 3, !null _}]
      - unorderedResult: [{!l 4, 'x'}, {!l 4, 'y'}]
      - unorderedResult: []
---
test_block:
  name: right-outer-join-auto-qa
  preset: single_repetition_ordered
  tests:
    -
      # RIGHT JOIN with a WHERE on the null-supplying (left) side that accepts NULL via OR must keep null-padded rows.
      - query: SELECT "l"."id", "r"."id" FROM "l" RIGHT JOIN "r" ON "l"."k" = "r"."k" WHERE "l"."v" = 'a' OR "l"."v" IS NULL;
      - unorderedResult: [
          {!pos 1: !l 1, !pos 2: !l 1},
          {!pos 1: !l 1, !pos 2: !l 2},
          {!pos 1: !null _, !pos 2: !l 3},
          {!pos 1: !null _, !pos 2: !l 4}]
---
test_block:
  name: left-then-inner-join-auto-qa
  preset: single_repetition_ordered
  tests:
    -
      # LEFT JOIN followed by an INNER JOIN on the null-supplying side: the inner join discards the null-padded rows.
      # BUG AQA-20: the Cascades planner fails with an internal IllegalArgumentException ("Node ... is not an element
      # of this graph", Traversal.pruneUnreferencedRefs) instead of planning this query. Spec: JOIN.rst lists INNER and
      # LEFT OUTER JOIN as supported, with no restriction on chaining them.
      - query: SELECT "l"."id", "r2"."w" FROM "l" LEFT JOIN "r" ON "l"."k" = "r"."k" JOIN "r" "r2" ON "r2"."id" = "r"."id";
      - unorderedResult: [
          {!l 1, 'x'},
          {!l 1, 'y'},
          {!l 4, 'x'},
          {!l 4, 'y'}]
