---
options:
    # Steps 3 and 5 only became covering once the plan cache stopped picking by plan hash, see
    # https://github.com/FoundationDB/fdb-record-layer/issues/4642
    supported_version: !current_version
---
schema_template:
    CREATE TABLE T ("id" INTEGER, "x" INTEGER, PRIMARY KEY ("id"))
    CREATE INDEX idx_x_gt_200 AS SELECT "x" FROM T WHERE "x" > 200 ORDER BY "x"
---
setup:
  steps:
    - query: INSERT INTO T VALUES (1, 50), (2, 150), (3, 220), (4, 260), (5, 320), (6, 400)
---
test_block:
  name: cached-plan-costing-tests
  preset: single_repetition_ordered
  tests:
    -
      # Implies the index predicate: the covering plan is cached.
      - query: SELECT "x" FROM T WHERE "x" > 250
      - explain: "COVERING(IDX_X_GT_200 [[GREATER_THAN promote(@c7 AS INT)]] -> [id: KEY:[2], x: KEY:[0]]) | MAP (_.x AS x)"
      - unorderedResult: [{x: 260}, {x: 320}, {x: 400}]
    -
      # Does not imply it: the unconstrained scan joins the entry -- the poison.
      - query: SELECT "x" FROM T WHERE "x" > 100
      - explain: "SCAN([IS T]) | FILTER _.x GREATER_THAN promote(@c7 AS INT) | MAP (_.x AS x)"
      - unorderedResult: [{x: 150}, {x: 220}, {x: 260}, {x: 320}, {x: 400}]
    -
      # Both match; the covering one has no residual filter, so it must win.
      - query: SELECT "x" FROM T WHERE "x" > 300
      - explain: "COVERING(IDX_X_GT_200 [[GREATER_THAN promote(@c7 AS INT)]] -> [id: KEY:[2], x: KEY:[0]]) | MAP (_.x AS x)"
      - unorderedResult: [{x: 320}, {x: 400}]
    -
      # No over-correction: still gets the only plan it qualifies for.
      - query: SELECT "x" FROM T WHERE "x" > 150
      - explain: "SCAN([IS T]) | FILTER _.x GREATER_THAN promote(@c7 AS INT) | MAP (_.x AS x)"
      - unorderedResult: [{x: 220}, {x: 260}, {x: 320}, {x: 400}]
    -
      # The choice is stable.
      - query: SELECT "x" FROM T WHERE "x" > 260
      - explain: "COVERING(IDX_X_GT_200 [[GREATER_THAN promote(@c7 AS INT)]] -> [id: KEY:[2], x: KEY:[0]]) | MAP (_.x AS x)"
      - unorderedResult: [{x: 320}, {x: 400}]
...
