# Regression test for loading metadata JSON whose RecordTypeUnion has multiple fields that
# reference the same record type, distinguished only by a custom FieldOptions extension.
# CommandUtil.loadRecordMetaDataFromJson must recover that extension from the raw JSON since
# JsonFormat itself cannot parse proto2 extensions; otherwise the fields collapse to identical
# FieldOptions and loading fails with "Duplicated options for different generations of Table
# MyRecord".
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template if exists field_options_extension_template
    - query: drop database if exists /FRL/FIELD_OPTIONS_EXTENSION_YAML
    - query: create database /FRL/FIELD_OPTIONS_EXTENSION_YAML
    - load schema template: FIELD_OPTIONS_EXTENSION_TEMPLATE from src/test/resources/field-options-extension-metadata.json
    - query: create schema /FRL/FIELD_OPTIONS_EXTENSION_YAML/test with template FIELD_OPTIONS_EXTENSION_TEMPLATE
    - set schema state: "{\"name\": \"TEST\", \"database_id\": \"/FRL/FIELD_OPTIONS_EXTENSION_YAML\", \"template_name\": \"FIELD_OPTIONS_EXTENSION_TEMPLATE\", \"store_info\" : {\"formatVersion\": 2}}"
---
setup:
  connect: "jdbc:embed:/FRL/FIELD_OPTIONS_EXTENSION_YAML?schema=TEST"
  steps:
    - query: INSERT INTO "MyRecord" VALUES (1), (2), (3)
---
test_block:
  connect: "jdbc:embed:/FRL/FIELD_OPTIONS_EXTENSION_YAML?schema=TEST"
  name: field-options-extension
  tests:
    -
      - query: select "ID" from "MyRecord" order by "ID"
      - result: [{ID: !l 1}, {ID: !l 2}, {ID: !l 3}]
    -
      - query: select count(*) from "MyRecord"
      - result: [{!l 3}]
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template field_options_extension_template
    - query: drop database /FRL/FIELD_OPTIONS_EXTENSION_YAML
...
