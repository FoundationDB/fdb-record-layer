---
options:
  supported_version: 4.18.4.0
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template if exists WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_TEMPLATE
    - query: drop database if exists /FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML
    - query: create database /FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML
    - load schema template: WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_TEMPLATE from src/test/resources/user_defined_functions_and_types_metadata.json
    - query: create schema /FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML/TEST with template WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_TEMPLATE
---
setup:
  connect: "jdbc:embed:/FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML?schema=TEST"
  steps:
    - query: INSERT INTO U VALUES (1, ( 5, 'foo') ), (2, ( 4, 'bar') )
---
test_block:
  connect: "jdbc:embed:/FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML?schema=TEST"
  name: user-defined-function-in-metadata-tests
  tests:
    -
      - query: SELECT "x", "id" FROM U
      - unorderedResult: [{ id: !l 1, x: {a: !l 5, b: 'foo'} },
                          { id: !l 2, x: {a: !l 4, b: 'bar'} }]
    -
      - query: SELECT * FROM "basic_sql_function"(1l)
      - explain: "SCAN([IS U, EQUALS @c5])"
      - result: [{ id: !l 1, x: {a: !l 5, b: "foo"} }]
    -
      - query: SELECT "macro_func_for_x"("U"."x") FROM U
      - explain: "COVERING(U$x <,> -> [id: KEY:[3], x: [a: KEY:[0], b: KEY:[1]]]) | MAP (_.x.b AS _0)"
      - unorderedResult: [{ "foo" }, { "bar" }]
    -
      - query: SELECT "add_one"(0l) FROM range(1, 2)
      - explain: "TF range(promote(@c8 AS LONG), promote(@c10 AS LONG), STEP 1l) | MAP (@c3 + 1 AS _0)"
      - unorderedResult: [{!l 1}]
    -
      - query: SELECT "macro_func_for_y"((5l, 'bar')) FROM range(1, 2)
      - explain: "TF range(promote(@c12 AS LONG), promote(@c14 AS LONG), STEP 1l) | MAP (promote((@c4 AS _0, @c6 AS _1) AS LONG AS a, STRING AS b).a AS _0)"
      - unorderedResult: [{!l 5 }]
    -
      - query: SELECT "macro_func_for_z1"((5l, 'foo', 'bar')) FROM range(1, 2)
      - explain: "TF range(promote(@c14 AS LONG), promote(@c16 AS LONG), STEP 1l) | MAP (promote((@c4 AS _0, @c6 AS _1, @c8 AS _2) AS LONG AS a, STRING AS b, STRING AS c).a AS _0)"
      - unorderedResult: [{!l 5 }]
    -
      - query: SELECT "macro_func_returning_z1"(5l) AS z1 FROM range(1, 2)
      - explain: "TF range(promote(@c10 AS LONG), promote(@c12 AS LONG), STEP 1l) | MAP (promote((@c3 AS a, 'foo' AS _1, 'bar' AS _2) AS LONG AS a, STRING AS b, STRING AS c) AS Z1)"
      - resultMetadata: [{Z1: [Z, {a: BIGINT}, {b: STRING}, {c: STRING}]}]
      - unorderedResult: [{z1: {a: !l 5, b: 'foo', c: 'bar'}}]
    -
      - query: SELECT "macro_func_returning_z2"('a') AS z2 FROM range(1, 2)
      - explain: "TF range(promote(@c10 AS LONG), promote(@c12 AS LONG), STEP 1l) | MAP (promote((@c3 AS a, 'foo' AS _1, 'bar' AS _2) AS STRING AS a, STRING AS b, STRING AS c) AS Z2)"
      - resultMetadata: [{Z2: [Z, {a: STRING}, {b: STRING}, {c: STRING}]}]
      - unorderedResult: [{z2: {a: 'a', b: 'foo', c: 'bar'}}]
    -
      - query: SELECT "macro_func_returning_y1"(5l) AS y1, "macro_func_returning_y2"(5l) AS y2 FROM range(1, 2)
      - resultMetadata: [ { Y1: [ Y, { a: BIGINT }, { b: STRING } ] }, { Y2: [ Y, { a: BIGINT }, { b: STRING } ] } ]
      - unorderedResult: [ { y1: { a: !l 5, b: 'foo' }, y2: { a: !l 5, b: 'foo' } } ]
    -
      # TODO: The two 'Z' types here have different fields, so adding them to the type repository with the same name
      #       fails. This should be fixed as part of https://github.com/FoundationDB/fdb-record-layer/issues/3789.
      - query: SELECT "macro_func_returning_z1"(5l) AS z1, "macro_func_returning_z2"('a') AS z2 FROM range(1, 2)
      - error: UNKNOWN
    -
      - query: SELECT "add_func"(5l, 6l) FROM range(1, 2)
      - explain: "TF range(promote(@c10 AS LONG), promote(@c12 AS LONG), STEP 1l) | MAP (@c3 + @c5 AS _0)"
      - unorderedResult: [{!l 11 }]
---
test_block:
  connect: "jdbc:embed:/FRL/WITH_USER_DEFINED_FUNCTIONS_AND_TYPES_YAML?schema=TEST"
  name: temporary-functions-with-user-defined-types-tests
  tests:
    -
      - query: SELECT * FROM temp_func((5l, 'foo'))
      - setup: create temporary function temp_func(IN R TYPE "com.apple.foundationdb.relational.yamltests.generated.tobeimported.X") on commit drop function AS select * from U where R."a" = "x"."a" and R."b" = "x"."b"
      - explain: "ISCAN(U$x [EQUALS promote((@c6 AS _0, @c8 AS _1) AS LONG AS a, STRING AS b).a, EQUALS promote((@c6 AS _0, @c8 AS _1) AS LONG AS a, STRING AS b).b])"
      - result: [{ id: !l 1, x: {a: !l 5, b: "foo"} }]
    -
      - query: SELECT * FROM temp_func((5l, 'foo'))
      - setup: create temporary function temp_func(IN R TYPE "Y") on commit drop function AS select * from U where R."a" = "x"."a" and R."b" = "x"."b"
      - explain: "ISCAN(U$x [EQUALS promote((@c6 AS _0, @c8 AS _1) AS LONG AS a, STRING AS b).a, EQUALS promote((@c6 AS _0, @c8 AS _1) AS LONG AS a, STRING AS b).b])"
      - result: [{ id: !l 1, x: {a: !l 5, b: "foo"} }]
    -
      - query: SELECT temp_func((5l, 'foo')) FROM range(1, 2)
      - setup: create temporary function temp_func(IN R TYPE "Y") on commit drop function AS R."a"
      - explain: "TF range(promote(@c12 AS LONG), promote(@c14 AS LONG), STEP 1l) | MAP (promote((@c4 AS _0, @c6 AS _1) AS LONG AS a, STRING AS b).a AS _0)"
      - result: [{ !l 5 }]
    -
      - query: SELECT temp_func_2((5l, 'foo')) FROM range(1, 2)
      - setup: create temporary function temp_func_1(IN R TYPE "Y") on commit drop function AS R."a"
      - setup: create temporary function temp_func_2(IN R TYPE "com.apple.foundationdb.relational.yamltests.generated.tobeimported.X") on commit drop function AS R."a"
      - explain: "TF range(promote(@c12 AS LONG), promote(@c14 AS LONG), STEP 1l) | MAP (promote((@c4 AS _0, @c6 AS _1) AS LONG AS a, STRING AS b).a AS _0)"
      - result: [{ !l 5 }]
    -
      - query: select red_color() from range(1, 2)
      - setup: create temporary function red_color() returns "Color" on commit drop function return 'Red'
      - explain: "TF range(promote(@c7 AS LONG), promote(@c9 AS LONG), STEP 1l) | MAP (promote('Red' AS ENUM<Red(0), Blue(1), Green(2)>) AS _0)"
      - resultMetadata: [{_0: OTHER}]
      - result: [ { 'Red' } ]
    -
      - query: select zero_number() from range(1, 2)
      - setup: create temporary function zero_number() returns "com.apple.foundationdb.relational.yamltests.generated.tobeimported.X.Number" on commit drop function return 'Zero'
      - explain: "TF range(promote(@c7 AS LONG), promote(@c9 AS LONG), STEP 1l) | MAP (promote('Zero' AS ENUM<Zero(0), One(1), Two(2)>) AS _0)"
      - resultMetadata: [{_0: OTHER}]
      - result: [ { 'Zero' } ]
    -
      - query: select y_constructor() from range(1, 2)
      - setup: create temporary function y_constructor() returns "Y" on commit drop function return (5l, 'foo')
      - explain: "TF range(promote(@c7 AS LONG), promote(@c9 AS LONG), STEP 1l) | MAP (promote((5l AS _0, 'foo' AS _1) AS LONG AS a, STRING AS b) AS _0)"
      - resultMetadata: [{_0: [Y, {a: BIGINT}, {b: STRING}]}]
      - result: [ {{a: !l 5, b: "foo"}} ]
...
