---
schema_template:
    create table products(id bigint, name string, category string, price bigint, stock integer, primary key(id))
    create index price_idx as select price from products order by price
    create index category_idx as select category from products order by category
    create index name_idx as select name from products order by name
    create table files(id bigint, filename string, primary key(id))
    create table name_patterns(id bigint, pattern string, escape_char string, primary key(id))
---
setup:
  steps:
    - query: insert into products
            values (1, 'Widget A', 'Electronics', 100, 50),
                   (2, 'Widget B', 'Electronics', 150, 30),
                   (3, 'Gadget X', 'Electronics', 200, 20),
                   (4, 'Tool A', 'Hardware', 80, 100),
                   (5, 'Tool B', 'Hardware', 120, 15),
                   (6, 'Book A', 'Media', 25, 200),
                   (7, 'Book B', 'Media', 30, 150)
    - query: insert into files values
        (1, 'report_2024.pdf'),
        (2, 'data%summary.txt'),
        (3, 'test_file.csv')
    - query: insert into name_patterns values
        (1, 'final%', null),
        (2, '%\_%', '\'),
        (3, null, null)
---
test_block:
  name: like-operator-tests
  preset: single_repetition_ordered
  tests:
    # LIKE prefix matching
    -
      - query: SELECT name
              FROM products
              WHERE name LIKE 'W%'
              ORDER BY name
      - result: [{name: "Widget A"},
                 {name: "Widget B"}]

    # LIKE suffix matching
    -
      - query: SELECT name
              FROM products
              WHERE name LIKE '%B'
              ORDER BY name
      - result: [{name: "Book B"},
                 {name: "Tool B"},
                 {name: "Widget B"}]

    # LIKE substring matching
    -
      - query: SELECT name
              FROM products
              WHERE name LIKE '%oo%'
              ORDER BY name
      - result: [{name: "Book A"},
                 {name: "Book B"},
                 {name: "Tool A"},
                 {name: "Tool B"}]

    # NOT LIKE
    -
      - query: SELECT name
              FROM products
              WHERE name NOT LIKE 'Widget%'
              ORDER BY name
      - result: [{name: "Book A"},
                 {name: "Book B"},
                 {name: "Gadget X"},
                 {name: "Tool A"},
                 {name: "Tool B"}]

    # ESCAPE clause
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE '%\_%' ESCAPE '\'
      - result: [
         {"report_2024.pdf"},
         {"test_file.csv"},
        ]
    -
      - query: INSERT INTO files VALUES
          (4, 'final_report.pdf'),
          (5, 'final-report.pdf'),
          (6, 'final\-report.pdf')
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final_report.pdf'
      - result: [
         {"final_report.pdf"},
         {"final-report.pdf"},
        ]
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final\_report.pdf' ESCAPE '\'
      - result: [
         {"final_report.pdf"},
        ]
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final\\_report.pdf' ESCAPE '\'
      - supported_version: 4.13.1.0
      - result: [
         {"final\\-report.pdf"},
        ]
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final%_report.pdf' ESCAPE '%'
      - supported_version: 4.13.1.0
      - error: '2200B'
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final##_report.pdf' ESCAPE '##'
      - initialVersionAtLeast: 4.13.1.0
      - error: '22019'
      - initialVersionLessThan: 4.13.1.0
      - error: 'XX000'
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'rfrirnrarlr_rrrerprorrrtr.rprdrf' ESCAPE 'r'
      - supported_version: 4.13.1.0
      - error: '22025'
---
test_block:
  name: like-operator-expression-tests
  preset: single_repetition_ordered
  options:
    supported_version: 4.19.4.0
  tests:
    # Patterns from columns (uses the files inserted by the previous block)
    -
      - query:
         SELECT p.id AS pattern_id, f.filename
         FROM name_patterns AS p, files AS f
         WHERE f.filename LIKE p.pattern ESCAPE p.escape_char
      - unorderedResult: [
         {pattern_id: 1, filename: "final_report.pdf"},
         {pattern_id: 1, filename: "final-report.pdf"},
         {pattern_id: 1, filename: "final\\-report.pdf"},
         {pattern_id: 2, filename: "report_2024.pdf"},
         {pattern_id: 2, filename: "test_file.csv"},
         {pattern_id: 2, filename: "final_report.pdf"},
        ]

    # NULL pattern
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE NULL
      - result: []
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename NOT LIKE NULL
      - result: []

    # NULL escape character
    -
      - query:
         SELECT filename
         FROM files
         WHERE filename LIKE 'final\_report.pdf' ESCAPE NULL
      - result: [
         {"final\\-report.pdf"},
        ]
...
