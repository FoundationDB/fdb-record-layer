---
options:
    supported_version: 4.14.1.0
    connection_options:
      CASE_SENSITIVE_IDENTIFIERS: true
---
# The schema includes indexes on the grouping column so `GROUP BY grp` can be planned by the streaming aggregation.
schema_template:
    CREATE TABLE T1 (id BIGINT, grp BIGINT, val BIGINT, PRIMARY KEY (id))
    CREATE INDEX T1_grp AS SELECT grp FROM T1 ORDER BY grp

    CREATE TABLE keywords (array_agg BIGINT, respect BIGINT, PRIMARY KEY (array_agg))

    CREATE TYPE AS STRUCT Struct1 (a BIGINT, b BIGINT)
    CREATE TABLE T2 (id BIGINT, grp BIGINT, s Struct1, PRIMARY KEY (id))
    CREATE INDEX T2_grp AS SELECT grp FROM T2 ORDER BY grp

    CREATE TYPE AS STRUCT Struct2 (u UUID, b BYTES)
    CREATE TABLE T3 (id BIGINT, grp BIGINT, u UUID, b BYTES, s Struct2, PRIMARY KEY (id))
    CREATE INDEX T3_grp AS SELECT grp FROM T3 ORDER BY grp

    CREATE TABLE T5 (id BIGINT, grp BIGINT, val BIGINT, other BIGINT, PRIMARY KEY (id))
    CREATE INDEX T5_grp_val AS SELECT grp, val FROM T5 ORDER BY grp, val
    CREATE INDEX T5_grp_other AS SELECT grp, other FROM T5 ORDER BY grp, other
    CREATE INDEX T5_val AS SELECT val FROM T5 ORDER BY val
    CREATE INDEX T5_grp_val_other AS SELECT grp, val, other FROM T5 ORDER BY grp, val, other
    CREATE INDEX T5_grp_other_val AS SELECT grp, other, val FROM T5 ORDER BY grp, other, val

    CREATE TABLE doc_meta (mid BIGINT, owner STRING, PRIMARY KEY (mid))
    CREATE TABLE doc_rev (rid BIGINT, title STRING, tags STRING ARRAY, PRIMARY KEY (rid))
    CREATE TABLE doc_asset (aid BIGINT, rid BIGINT, url STRING, PRIMARY KEY (aid))
    CREATE INDEX doc_asset_by_rid AS SELECT rid FROM doc_asset ORDER BY rid

    CREATE TABLE big (id BIGINT, val BIGINT, PRIMARY KEY (id))

    CREATE TABLE T4 (id BIGINT, grp BIGINT, val BIGINT, PRIMARY KEY (id))
    CREATE INDEX T4_grp AS SELECT grp FROM T4 ORDER BY grp
    CREATE INDEX T4_count AS SELECT COUNT(*) FROM T4
    CREATE INDEX T4_count_by_grp AS SELECT COUNT(*) FROM T4 GROUP BY grp
    CREATE INDEX T4_sum_by_grp AS SELECT SUM(val) FROM T4 GROUP BY grp
---
setup:
  steps:
    - query: INSERT INTO T1
             VALUES (1, 10, 100),
                    (2, 10, 200),
                    (3, 10, 300),
                    (4, 20, 400),
                    (5, 20, 500),
                    (6, 30, NULL)
    - query: INSERT INTO keywords
             VALUES (1, 2)
    - query: INSERT INTO T2
             VALUES (1, 10, (1, 2)),
                    (2, 10, (3, 4)),
                    (3, 20, (5, 6))
    - query: INSERT INTO T3
             VALUES (1, 10, '0920df1c-be81-4ec1-8a06-2180226f051d', X'0a0b', ('64120112-4e39-40c3-94b9-2cc88a52e8df', X'0c0d')),
                    (2, 10, 'c35ba01f-f8fc-47d7-bb00-f077e8a75682', X'0e0f', ('5394a912-aa8e-40fc-a4bb-ddf3f89ac45b', X'1011'))
    - query: INSERT INTO T5
             VALUES (1, 10, 300, 1),
                    (2, 10, 100, 3),
                    (3, 10, 200, 2),
                    (4, 20, 500, 1),
                    (5, 20, 400, 2)
    - query: INSERT INTO doc_meta
             VALUES (1, 'ann')
    - query: INSERT INTO doc_rev
             VALUES (10, 'draft', ['internal']),
                    (20, 'final', ['featured', 'public'])
    - query: INSERT INTO doc_asset
             VALUES (1, 10, 'a1.png'),
                    (2, 20, 'b1.png'),
                    (3, 20, 'b2.png')
    - query: INSERT INTO T4
             VALUES (1, 10, 100),
                    (2, 10, 200),
                    (3, 20, 300)
---
# ARRAY_AGG() cannot back an aggregate index, since there is no index type that materializes it.
test_block:
  name: array-agg-not-indexable
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  preset: single_repetition_ordered
  tests:
    -
      - query: CREATE SCHEMA TEMPLATE array_agg_index_template
               CREATE TABLE tab (id BIGINT, grp BIGINT, val BIGINT, PRIMARY KEY (id))
               CREATE INDEX idx AS SELECT ARRAY_AGG(val) FROM tab GROUP BY grp
      - error: UNSUPPORTED_OPERATION
---
# Tests for grammar-level behavior.
test_block:
  name: array-agg-syntax
  tests:
    -
      # The ALL set quantifier is accepted and behaves like the bare form.
      - query: SELECT ARRAY_AGG(ALL val) FROM T1 WHERE grp = 10
      - result: [{[100, 200, 300]}]
    -
      # DISTINCT is grammatically accepted but rejected at semantic analysis time (like other aggregates such as SUM).
      - query: SELECT ARRAY_AGG(DISTINCT val) FROM T1
      - error: UNSUPPORTED_QUERY
    -
      # The grammar admits the null treatment clause for ARRAY_AGG() only, so it is a parse error elsewhere.
      # (The ordinary aggregates ignore NULL inputs implicitly.)
      - query: SELECT SUM(val IGNORE NULLS) FROM T1
      - error: SYNTAX_ERROR
    -
      # An in-call ORDER BY clause is honored by asking the planner for a suitably ordered input. If there’s no index
      # that can provide the ordering, the query cannot be planned.
      - query: SELECT ARRAY_AGG(val ORDER BY val) FROM T1
      - error: UNSUPPORTED_QUERY
    -
      # The ORDER BY expressions undergo the usual semantic analysis, so a bogus one is reported as such.
      - query: SELECT ARRAY_AGG(val ORDER BY bogus) FROM T1
      - error: UNDEFINED_COLUMN
    -
      # ORDER BY can take an arbitrary expression, not just a column reference.
      - query: SELECT ARRAY_AGG(val ORDER BY val + 1) FROM T1
      - error: UNSUPPORTED_QUERY
    -
      - query: SELECT ARRAY_AGG(val ORDER BY GREATEST(val, 0 - val)) FROM T1
      - error: UNSUPPORTED_QUERY
    -
      # The aggregate’s own argument is resolved before the ORDER BY clause, so a bogus argument is reported first.
      - query: SELECT ARRAY_AGG(bogus ORDER BY val) FROM T1
      - error: UNDEFINED_COLUMN
    -
      # The null treatment clause precedes the in-call ORDER BY clause.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS ORDER BY val) FROM T1
      - error: UNSUPPORTED_QUERY
    -
      # The opposite order is a parse error.
      - query: SELECT ARRAY_AGG(val ORDER BY val IGNORE NULLS) FROM T1
      - error: SYNTAX_ERROR
    -
      # Using ARRAY_AGG() as a window function is grammatically accepted but rejected at semantic analysis time
      # (like other aggregates such as MAX).
      - query: SELECT ARRAY_AGG(val) OVER () FROM T1
      - error: UNSUPPORTED_QUERY
    -
      # ARRAY_AGG and RESPECT are in `keywordsCanBeId`, so they are usable as identifiers.
      - query: SELECT array_agg, respect FROM keywords
      - result: [{array_agg: 1, respect: 2}]
    -
      - query: SELECT val AS array_agg, val AS respect FROM T1 WHERE id = 1
      - result: [{array_agg: 100, respect: 100}]
    -
      - query: SELECT array_agg.val FROM T1 AS array_agg WHERE array_agg.id = 1
      - result: [{val: 100}]
    -
      # The in-call LIMIT clause follows the null treatment clause.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT 2) FROM T1
      - result: [{[100, 200]}]
    -
      # The opposite order is a syntax error.
      - query: SELECT ARRAY_AGG(val LIMIT 2 IGNORE NULLS) FROM T1
      - error: SYNTAX_ERROR
    -
      # The grammar admits the LIMIT clause for ARRAY_AGG() only.
      - query: SELECT SUM(val LIMIT 2) FROM T1
      - error: SYNTAX_ERROR
    -
      # The LIMIT clause takes no OFFSET, unlike the `limitClause` used for a query.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT 2 OFFSET 1) FROM T1
      - error: SYNTAX_ERROR
    -
      # LIMIT takes a literal only, not a prepared-statement parameter, since the limit gets baked into the plan.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT ?) FROM T1
      - error: SYNTAX_ERROR
    -
      # A negative limit is a syntax error.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT -1) FROM T1
      - error: SYNTAX_ERROR
---
test_block:
  name: array-agg-tests
  tests:
    -
      # Basic ARRAY_AGG() over the whole table produces a single implicit group.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS) FROM T1
      - resultMetadata: [{_0: {array: BIGINT}}]
      - result: [{[100, 200, 300, 400, 500]}]
    -
      # IGNORE NULLS omits NULL elements. A group whose only value is NULL yields an empty array (which indicates that
      # the group did see rows, in contrast to the empty-input case below, which yields NULL).
      - query: SELECT ARRAY_AGG(val IGNORE NULLS) FROM T1 WHERE grp = 30
      - result: [{[]}]
    -
      # Empty input with no GROUP BY yields a single row whose aggregate is NULL (as prescribed by SQL:2011).
      - query: SELECT ARRAY_AGG(val) FROM T1 WHERE grp = 999
      - result: [{!null _}]
    -
      # ARRAY_AGG() with GROUP BY produces one array per group.
      - query: SELECT grp, ARRAY_AGG(val IGNORE NULLS) FROM T1 GROUP BY grp
      - resultMetadata: [{grp: BIGINT}, {_1: {array: BIGINT}}]
      - result: [{10, [100, 200, 300]}, {20, [400, 500]}, {30, []}]
    -
      # Empty input yields no rows when grouped with GROUP BY.
      - query: SELECT grp, ARRAY_AGG(val) FROM T1 WHERE grp = 999 GROUP BY grp
      - result: []
    -
      # The bare ARRAY_AGG() form means RESPECT NULLS. This currently fails at runtime, since T1 contains a NULL value
      # that cannot be represented as an array element (Issue #3646).
      - query: SELECT ARRAY_AGG(val) FROM T1
      - error: UNSUPPORTED_OPERATION
    -
      # An explicit RESPECT NULLS behaves the same way.
      - query: SELECT ARRAY_AGG(val RESPECT NULLS) FROM T1
      - error: UNSUPPORTED_OPERATION
    -
      # An untyped NULL argument is rejected, as its type, and hence the element type of the resulting array, cannot be
      # determined. This is the same rejection an untyped element of an IN list gets.
      - query: SELECT ARRAY_AGG(NULL) FROM T1
      - error: UNKNOWN_TYPE
    -
      # … which holds under IGNORE NULLS as well.
      - query: SELECT ARRAY_AGG(NULL IGNORE NULLS) FROM T1
      - error: UNKNOWN_TYPE
    -
      # A typed NULL is accepted, and under IGNORE NULLS this yields an empty array.
      - query: SELECT ARRAY_AGG(CAST(NULL AS BIGINT) IGNORE NULLS) FROM T1
      - result: [{[]}]
    -
      # The bare ARRAY_AGG() form (with RESPECT NULLS semantics) succeeds if the input doesn’t contain any NULL.
      - query: SELECT ARRAY_AGG(val) FROM T1 WHERE grp = 10
      - result: [{[100, 200, 300]}]
    -
      # … as does ARRAY_AGG() with an explicit RESPECT NULLS.
      - query: SELECT ARRAY_AGG(val RESPECT NULLS) FROM T1 WHERE grp = 10
      - result: [{[100, 200, 300]}]
    -
      # The argument can be an arbitrary expression.
      - query: SELECT ARRAY_AGG(val + 1 IGNORE NULLS) FROM T1
      - result: [{[101, 201, 301, 401, 501]}]
    -
      # COALESCE() can be used to wrap a nullable argument and make the element type non-nullable.
      - query: SELECT ARRAY_AGG(COALESCE(val, 0)) FROM T1
      - result: [{[100, 200, 300, 400, 500, 0]}]
    -
      # ARRAY_AGG() over a non-primitive (struct) element type. This exercises the accumulator’s wrapper-record
      # serialization for a nested element type.
      - query: SELECT grp, ARRAY_AGG(s) FROM T2 GROUP BY grp
      - resultMetadata: [{grp: BIGINT}, {_1: {array: [STRUCT1, {a: BIGINT}, {b: BIGINT}]}}]
      - result: [{10, [{1, 2}, {3, 4}]}, {20, [{5, 6}]}]
    -
      # The struct element type may itself have an ARRAY-typed member, which puts a nested array one level down.
      - query: SELECT ARRAY_AGG((rid, tags)) FROM doc_rev
      - resultMetadata: [{_0: {array: [{rid: BIGINT}, {tags: {array: STRING}}]}}]
      - result: [{[{10, ['internal']}, {20, ['featured', 'public']}]}]
    -
      # Aggregating an ARRAY-typed argument directly, on the other hand, yields an array of arrays, which is not
      # supported (Issue #4167).
      - query: SELECT ARRAY_AGG(tags) FROM doc_rev
      - error: UNSUPPORTED_OPERATION
    -
      # The Issue #4167 limitation also applies to the select elements of a subquery, even where the nested array never
      # reaches the result set.
      - query: SELECT sq.agg[1] FROM (SELECT ARRAY_AGG(tags) AS agg FROM doc_rev) sq
      - error: UNSUPPORTED_OPERATION
    -
      # Paginating a grouped ARRAY_AGG() returns one group per page, each with its array fully collected.
      # The `grp=30` group additionally covers a group that consists of only NULL values (and yields an empty array due
      # to IGNORE NULLS).
      - query: SELECT grp, ARRAY_AGG(val IGNORE NULLS) FROM T1 GROUP BY grp
      - maxRows: 1
      - result: [{10, [100, 200, 300]}]
      - result: [{20, [400, 500]}]
      - result: [{30, []}]
      - result: []
    -
      # Two ARRAY_AGG() aggregates differing only in their null treatment must not be conflated. They are distinct
      # values, with distinct element type nullability, so both survive into the plan.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS) AS a, ARRAY_AGG(val RESPECT NULLS) AS b FROM T1 WHERE grp = 10
      - explain: "ISCAN(T1_grp [EQUALS promote(@c23 AS LONG)]) | MAP (_ AS _0) | AGG (array_agg(_._0.val IGNORE NULLS) AS _0, array_agg(_._0.val) AS _1) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS a, _._0._1 AS b)"
      - result: [{a: [100, 200, 300], b: [100, 200, 300]}]
    -
      # ARRAY_AGG() next to a scalar aggregate, grouped. The `grp=30` group has only NULL values, so SUM() aggregates to
      # NULL there while ARRAY_AGG(IGNORE NULLS) aggregates to an empty array.
      - query: SELECT grp, SUM(val) AS s, ARRAY_AGG(val IGNORE NULLS) AS a FROM T1 GROUP BY grp
      - result: [{10, 600, [100, 200, 300]}, {20, 900, [400, 500]}, {30, !null _, []}]
    -
      # The resulting array can be consumed like any other array, e.g. subscripted …
      - query: SELECT sq.a[2] AS elem FROM (SELECT ARRAY_AGG(val IGNORE NULLS) AS a FROM T1 WHERE grp = 10) sq
      - result: [{elem: 200}]
    -
      # … or passed to a function taking an array.
      - query: SELECT CARDINALITY(sq.a) AS n FROM (SELECT ARRAY_AGG(val IGNORE NULLS) AS a FROM T1) sq
      - result: [{n: 5}]
    -
      # Variant with a STRING element type, i.e. a primitive other than the BIGINT used everywhere else in this file.
      - query: SELECT ARRAY_AGG(title) FROM doc_rev
      - result: [{['draft', 'final']}]
    -
      # The following tests exercise the in-call LIMIT clause to cap the collected array. Absent ORDER BY, it is
      # unspecified which elements are retained; here the scan order happens to be by primary key. The cap is part of
      # the aggregate value, so it shows up in the plan.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT 3) FROM T1
      - explain: "ISCAN(T1_grp <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val IGNORE NULLS LIMIT 3) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0)"
      - result: [{[100, 200, 300]}]
    -
      # A limit at or above the group size retains everything.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT 99) FROM T1
      - result: [{[100, 200, 300, 400, 500]}]
    -
      # A LIMIT 0 collects no elements at all. The group did see rows, so the result is an empty array rather than NULL.
      - query: SELECT ARRAY_AGG(val IGNORE NULLS LIMIT 0) FROM T1
      - result: [{[]}]
    -
      # The limit applies per group.
      - query: SELECT grp, ARRAY_AGG(val IGNORE NULLS LIMIT 2) FROM T1 GROUP BY grp
      - result: [{10, [100, 200]}, {20, [400, 500]}, {30, []}]
    -
      # Once the limit is reached, a subsequent NULL is ignored rather than reported as unsupported.
      - query: SELECT ARRAY_AGG(val LIMIT 5) FROM T1
      - result: [{[100, 200, 300, 400, 500]}]
    -
      # … whereas a limit that the NULL still fits into fails with UNSUPPORTED_OPERATION as usual.
      - query: SELECT ARRAY_AGG(val LIMIT 6) FROM T1
      - error: UNSUPPORTED_OPERATION
    -
      # The following tests aggregate rows as a whole by passing a bare table alias to ARRAY_AGG(). The alias resolves
      # to the row as a struct (just like for `SELECT T FROM T`).
      - query: SELECT ARRAY_AGG(a) FROM doc_asset a WHERE a.rid = 20
      - result: [{[{2, 20, 'b1.png'}, {3, 20, 'b2.png'}]}]
    -
      # Control: Outside an aggregate, the bare alias yields the whole row as a struct, as usual.
      - query: SELECT a FROM doc_asset a WHERE a.rid = 20
      - result: [{a: {2, 20, 'b1.png'}}, {a: {3, 20, 'b2.png'}}]
    -
      # The unaliased table name works the same way.
      - query: SELECT ARRAY_AGG(doc_asset) FROM doc_asset WHERE rid = 20
      - result: [{[{2, 20, 'b1.png'}, {3, 20, 'b2.png'}]}]
    -
      # Bare alias with GROUP BY. This yields one array of rows per group.
      - query: SELECT a.rid, ARRAY_AGG(a) FROM doc_asset a GROUP BY a.rid
      - result: [{10, [{1, 10, 'a1.png'}]}, {20, [{2, 20, 'b1.png'}, {3, 20, 'b2.png'}]}]
    -
      # In a join, each alias resolves to its own row.
      - query: SELECT ARRAY_AGG(a), ARRAY_AGG(r) FROM doc_asset a, doc_rev r WHERE a.rid = r.rid AND r.rid = 20
      - result: [{[{2, 20, 'b1.png'}, {3, 20, 'b2.png'}], [{20, 'final', ['featured', 'public']}, {20, 'final', ['featured', 'public']}]}]
    -
      # A column of the same name takes precedence over the row alias. Here, `array_agg` resolves to the `keywords`
      # table column, so the aggregate is over BIGINT rather than a struct.
      - query: SELECT ARRAY_AGG(array_agg) FROM keywords AS array_agg
      - result: [{[1]}]
    -
      # An identifier that names neither a column nor a table in scope fails with UNDEFINED_COLUMN, as usual.
      - query: SELECT ARRAY_AGG(b) FROM doc_asset a
      - error: UNDEFINED_COLUMN
---
# ARRAY_AGG() over constant inputs.
test_block:
  name: array-agg-constant-inputs
  tests:
    -
      # Unnest an array literal and collect it back, reproducing the original array (duplicates and order included).
      - query: SELECT ARRAY_AGG(x) AS agg
                 FROM (SELECT a FROM VALUES ([2, 1, -2, 3, -2, 1, 2]) AS T(a)) AS sq,
                      sq.a AS x
      - result: [{agg: [2, 1, -2, 3, -2, 1, 2]}]
    -
      # IGNORE NULLS example where the NULL inputs come from rows via VALUES.
      - query: SELECT ARRAY_AGG(x IGNORE NULLS) AS agg
                 FROM VALUES (1, 2), (2, 1), (3, CAST(NULL AS BIGINT)), (4, 3),
                             (5, CAST(NULL AS BIGINT)), (6, 1), (7, 2) AS T (id, x)
      - result: [{agg: [2, 1, 3, 1, 2]}]
    -
      # An array literal that contains NULLs is not supported currently (Issue #3646), so IGNORE NULLS cannot be
      # demonstrated that way. The NULL element is rejected while the array literal itself is resolved, before
      # ARRAY_AGG() ever sees it.
      - query: SELECT ARRAY_AGG(x IGNORE NULLS) AS agg
          FROM (SELECT a FROM VALUES ([2, 1, NULL, 3, NULL, 1, 2]) AS T(a)) AS sq,
          sq.a AS x
      - error: UNSUPPORTED_OPERATION
    -
      # Same rejection when the NULL element arrives as a typed CAST rather than as the bare NULL literal. This one is
      # caught while the array is evaluated rather than while it is resolved.
      - query: SELECT ARRAY_AGG(x IGNORE NULLS) AS agg
          FROM (SELECT a FROM VALUES ([1, CAST(NULL AS INTEGER)]) AS T(a)) AS sq,
          sq.a AS x
      - error: UNSUPPORTED_OPERATION
    -
      # Ungrouped ARRAY_AGG() example where the rows come from constant SELECTs in a common-table expression.
      - query: WITH vals AS (
                 SELECT 1 AS x, 'a' AS y UNION ALL
                 SELECT 1 AS x, 'b' AS y UNION ALL
                 SELECT 2 AS x, 'a' AS y UNION ALL
                 SELECT 2 AS x, 'c' AS y
               )
               SELECT ARRAY_AGG(y) AS agg FROM vals
      - result: [{agg: ['a', 'b', 'a', 'c']}]
---
# Tests involving element types whose runtime representation differs from their protobuf one. The accumulator has to
# convert such types, both when it serializes its partial state and when it hands its result to the enclosing record
# constructor.
test_block:
  name: array-agg-converted-element-types
  tests:
    -
      # A UUID is a `java.util.UUID` at runtime but a message on the wire.
      - query: SELECT ARRAY_AGG(u) FROM T3
      - result: [{[!uuid '0920df1c-be81-4ec1-8a06-2180226f051d', !uuid 'c35ba01f-f8fc-47d7-bb00-f077e8a75682']}]
    -
      # BYTES is `byte[]` at runtime and a `ByteString` on the wire.
      - query: SELECT ARRAY_AGG(b) FROM T3
      - result: [{[X'0a0b', X'0e0f']}]
    -
      # Same, but moved one level down: A struct element type with UUID and BYTES members.
      - query: SELECT ARRAY_AGG(s) FROM T3
      - result: [{[{!uuid '64120112-4e39-40c3-94b9-2cc88a52e8df', X'0c0d'}, {!uuid '5394a912-aa8e-40fc-a4bb-ddf3f89ac45b', X'1011'}]}]
    -
      # GROUP BY variant, so that the elements go through the accumulator’s partial-state serialization per group.
      - query: SELECT grp, ARRAY_AGG(u) FROM T3 GROUP BY grp
      - result: [{10, [!uuid '0920df1c-be81-4ec1-8a06-2180226f051d', !uuid 'c35ba01f-f8fc-47d7-bb00-f077e8a75682']}]
---
# Exercises a larger, more realistic scenario. Alongside scalar columns drawn from two independent row sources, this
# example query projects a nested collection of related detail rows, restricted by a membership test against an
# ARRAY-typed column.
test_block:
  name: array-agg-scenario
  tests:
    -
      # Variant 1: This places the ARRAY_AGG() subquery directly in the projection, which is (arguably) the most natural
      # way to express the query. This is not yet supported in the grammar.
      - query: SELECT m.mid, r.rid,
                      (SELECT ARRAY_AGG(a.url) FROM doc_asset a WHERE a.rid = r.rid) AS assets
                 FROM doc_meta m, doc_rev r
                WHERE m.owner IS NOT NULL
                  AND 'featured' IN r.tags
                  AND r.rid = 20
      - error: SYNTAX_ERROR
    -
      # Variant 2: Moves the correlated ARRAY_AGG() subquery into the FROM clause.
      - query: SELECT m.mid, r.rid, sq.assets
                 FROM doc_meta m,
                      doc_rev r,
                      (SELECT ARRAY_AGG(a.url) AS assets FROM doc_asset a WHERE a.rid = r.rid) sq
                WHERE m.owner IS NOT NULL
                  AND 'featured' IN r.tags
                  AND r.rid = 20
      - resultMetadata: [{mid: BIGINT}, {rid: BIGINT}, {assets: {array: STRING}}]
      - explain: "SCAN([IS doc_rev, EQUALS promote(@c60 AS LONG)]) | FILTER @c50 IN _.tags | FLATMAP q0 -> { ISCAN(doc_asset_by_rid [EQUALS q0.rid]) | MAP (_ AS _0) | AGG (array_agg(_._0.url) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (q0 AS _0, q0 AS _1) } | FLATMAP q1 -> { SCAN([IS doc_meta]) | FILTER _.owner NOT_NULL AS q2 RETURN (q2.mid AS mid, q1._0.rid AS rid, q1._1._0._0 AS assets) }"
      - result: [{1, 20, ['b1.png', 'b2.png']}]
    -
      # Variant 3: Joins in the assets and then groups via GROUP BY. This cannot currently be planned because the
      # streaming aggregation needs its input sorted on the grouping columns, and no index provides that ordering for
      # the result of a join.
      - query: SELECT m.mid, r.rid, ARRAY_AGG(a.url) AS assets
                 FROM doc_meta m,
                      doc_rev r,
                      doc_asset a
                WHERE m.owner IS NOT NULL
                  AND 'featured' IN r.tags
                  AND r.rid = 20
                  AND a.rid = r.rid
                GROUP BY m.mid, r.rid
      - error: UNSUPPORTED_QUERY
    -
      # Variant 4: Aggregates the detail table on its own, grouping by the join column, and joins in the result. Unlike
      # the two variants above, the subquery here is not correlated. The `doc_asset_by_rid` index provides the ordering
      # that the GROUP BY needs.
      - query: SELECT m.mid, r.rid, sq.assets
                 FROM doc_meta m,
                      doc_rev r,
                      (SELECT a.rid AS rid, ARRAY_AGG(a.url) AS assets FROM doc_asset a GROUP BY a.rid) sq
                WHERE m.owner IS NOT NULL
                  AND 'featured' IN r.tags
                  AND r.rid = 20
                  AND sq.rid = r.rid
      - explain: "ISCAN(doc_asset_by_rid <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.url) AS _0) GROUP BY (_._0.rid AS _0) | FLATMAP q0 -> { SCAN([IS doc_rev, EQUALS promote(@c63 AS LONG)]) | FILTER @c53 IN _.tags AND q0._0._0 EQUALS _.rid | FLATMAP q1 -> { SCAN([IS doc_meta]) | FILTER _.owner NOT_NULL AS q2 RETURN (q2 AS _0, q1 AS _1) } AS q3 RETURN (q3._0.mid AS mid, q3._1.rid AS rid, q0._1._0 AS assets) }"
      - result: [{1, 20, ['b1.png', 'b2.png']}]
    -
      # Variant 5: Collects the detail rows as a whole into an array of structs, via a star-derived record constructor.
      - query: SELECT m.mid, r.rid, sq.assets
                 FROM doc_meta m,
                      doc_rev r,
                      (SELECT ARRAY_AGG((a.*)) AS assets FROM doc_asset a WHERE a.rid = r.rid) sq
                WHERE m.owner IS NOT NULL
                  AND 'featured' IN r.tags
                  AND r.rid = 20
      - resultMetadata: [{mid: BIGINT}, {rid: BIGINT}, {assets: {array: [{aid: BIGINT}, {rid: BIGINT}, {url: STRING}]}}]
      - explain: "SCAN([IS doc_rev, EQUALS promote(@c62 AS LONG)]) | FILTER @c52 IN _.tags | FLATMAP q0 -> { ISCAN(doc_asset_by_rid [EQUALS q0.rid]) | MAP (_ AS _0) | AGG (array_agg((_._0.aid AS aid, _._0.rid AS rid, _._0.url AS url)) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (q0 AS _0, q0 AS _1) } | FLATMAP q1 -> { SCAN([IS doc_meta]) | FILTER _.owner NOT_NULL AS q2 RETURN (q2.mid AS mid, q1._0.rid AS rid, q1._1._0._0 AS assets) }"
      - result: [{1, 20, [{2, 20, 'b1.png'}, {3, 20, 'b2.png'}]}]
---
# Tests for the interaction between ARRAY_AGG() and aggregate indexes. Since aggregate indexes do not support
# ARRAY_AGG(), a candidate aggregate index on the same table can never match an ARRAY_AGG() query. The following tests
# verify that the planner rejects such candidates gracefully and falls back to a scan plus a streaming aggregation.
# The T4 table carries a COUNT index, a grouped COUNT index and a grouped SUM index. Each of these indexes is considered
# as a match candidate for the queries below.
test_block:
  name: array-agg-with-aggregate-index
  options:
    supported_version: 4.15.1.0
  tests:
    -
      - query: SELECT ARRAY_AGG(val) FROM T4
      - explain: "ISCAN(T4_grp <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0)"
      - result: [{[100, 200, 300]}]
    -
      # The GROUP BY form, which additionally has the two grouped aggregate indexes as candidates.
      - query: SELECT grp, ARRAY_AGG(val) FROM T4 GROUP BY grp
      - explain: "ISCAN(T4_grp <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - result: [{10, [100, 200]}, {20, [300]}]
    -
      # The STRUCT form, whose aggregate result type is an array of records rather than an array of primitives.
      - query: SELECT ARRAY_AGG((T4.*)) FROM T4
      - explain: "ISCAN(T4_grp <,>) | MAP (_ AS _0) | AGG (array_agg((_._0.id AS id, _._0.grp AS grp, _._0.val AS val)) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0)"
      - result: [{[{1, 10, 100}, {2, 10, 200}, {3, 20, 300}]}]
    -
      # Mixing ARRAY_AGG() with an aggregate that *is* indexable. The whole group-by nevertheless has to be computed by
      # the streaming aggregation, since the index can contribute only one of the two aggregates.
      - query: SELECT grp, COUNT(*), ARRAY_AGG(val) FROM T4 GROUP BY grp
      - explain: "ISCAN(T4_grp <,>) | MAP (_ AS _0) | AGG (count_star(*) AS _0, array_agg(_._0.val) AS _1) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1, _._1._1 AS _2)"
      - result: [{10, 2, [100, 200]}, {20, 1, [300]}]
    -
      # The indexable aggregates on their own continue to match their indexes.
      - query: SELECT COUNT(*) FROM T4
      - explain: "AISCAN(T4_count <,> BY_GROUP -> [_0: VALUE:[0]]) | MAP (_ AS _0) | ON EMPTY NULL | MAP (coalesce_long(_._0._0, 0l) AS _0)"
      - result: [{3}]
    -
      - query: SELECT grp, SUM(val) FROM T4 GROUP BY grp
      - explain: "AISCAN(T4_sum_by_grp <,> BY_GROUP -> [_0: KEY:[0], _1: VALUE:[0]]) | MAP (_._0 AS grp, _._1 AS _1)"
      - result: [{10, 300}, {20, 300}]
    -
      # A correlated ARRAY_AGG() subquery in the FROM clause, collecting the detail rows as an array of structs. This
      # repeats the realistic scenario of the block above, but over a detail table that has aggregate indexes.
      - query: SELECT t.id, sq.vals
                 FROM T1 t,
                      (SELECT ARRAY_AGG((d.*)) AS vals FROM T4 d WHERE d.grp = t.grp) sq
                WHERE t.id = 1
      - explain: "SCAN([IS T1, EQUALS promote(@c42 AS LONG)]) | FLATMAP q0 -> { ISCAN(T4_grp [EQUALS q0.grp]) | MAP (_ AS _0) | AGG (array_agg((_._0.id AS id, _._0.grp AS grp, _._0.val AS val)) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (q0.id AS id, q0._0._0 AS vals) }"
      - result: [{1, [{1, 10, 100}, {2, 10, 200}]}]
---
test_block:
  name: array-agg-large-group
  preset: single_repetition_ordered
  tests:
    -
      # Produce a fairly large group of 256 BIGINTs for ARRAY_AGG() to aggregate. (Note: With this method of generating
      # the data, we can’t go much larger than 256, since a single INSERT would otherwise exceed the FDB transaction
      # time limit.)
      - query: INSERT INTO big VALUES
                  (1, 1),  (2, 1),  (3, 1),  (4, 1),  (5, 1),  (6, 1),  (7, 1),  (8, 1),
                  (9, 1), (10, 1), (11, 1), (12, 1), (13, 1), (14, 1), (15, 1), (16, 1),
                 (17, 1), (18, 1), (19, 1), (20, 1), (21, 1), (22, 1), (23, 1), (24, 1),
                 (25, 1), (26, 1), (27, 1), (28, 1), (29, 1), (30, 1), (31, 1), (32, 1)
      - count: 32
    -
      - query: INSERT INTO big SELECT id + 32, val FROM big
      - count: 32
    -
      - query: INSERT INTO big SELECT id + 64, val FROM big
      - count: 64
    -
      - query: INSERT INTO big SELECT id + 128, val FROM big
      - count: 128
    -
      # Aggregate a single group of all 256 elements. This in particular exercises a large partial ARRAY_AGG() state.
      - query: SELECT CARDINALITY(sq.a) FROM (SELECT ARRAY_AGG(id) AS a FROM big) sq
      - result: [{256}]
    -
      # Test that every row of the group contributes (via a predicate that is satisfied by all 256 rows).
      - query: SELECT CARDINALITY(sq.a) FROM (SELECT ARRAY_AGG(val) AS a FROM big WHERE val = 1) sq
      - result: [{256}]
---
# Exercise the continuation that carries the partial ARRAY_AGG() state. To trigger a stop inside a group we need a
# record scan limit (not `maxRows`, which is applied _above_ the aggregate cursor). So this block sets
# EXECUTION_SCANNED_ROWS_LIMIT and lets the framework resume across the pages. The `grp=10` group holds three rows,
# so the limit of 2 will stop within that group.
test_block:
  name: array-agg-continuation
  preset: single_repetition_ordered
  options:
    connection_options:
      EXECUTION_SCANNED_ROWS_LIMIT: 2
  tests:
    -
      - query: SELECT grp, ARRAY_AGG(val IGNORE NULLS) FROM T1 GROUP BY grp
      - result: []
      - result: [{10, [100, 200, 300]}]
      - result: [{20, [400, 500]}]
      - result: [{30, []}]
    -
      # The same, but with an in-call LIMIT of 2. The cap is a total for the group rather than a budget per page, so
      # the `grp=10` group stays at two elements even though its third row is only read after the resume.
      - query: SELECT grp, ARRAY_AGG(val IGNORE NULLS LIMIT 2) FROM T1 GROUP BY grp
      - result: []
      - result: [{10, [100, 200]}]
      - result: [{20, [400, 500]}]
      - result: [{30, []}]
---
# Tests for the in-call ORDER BY clause. It is evaluated purely by requesting a suitably ordered input from the planner,
# so that the accumulator, which collects in stream order, produces the array in the desired order for free.
# An index on the full group-by-plus-sort key is needed. The grouping key parts may come in any order, but the sort keys
# have to follow them exactly.
test_block:
  name: array-agg-order-by
  options:
    # The in-call ORDER BY clause is new, so a released server cannot plan these queries.
    supported_version: !current_version
  tests:
    -
      # Ordering by the aggregated column itself. The `T5_grp_val` index provides (grp, val).
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [100, 200, 300]},
                          {grp: 20, [400, 500]}]
    -
      # ORDER BY … ASC (the default)
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val ASC) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [100, 200, 300]},
                          {grp: 20, [400, 500]}]
    -
      # ORDER BY … DESC is served by a REVERSE scan of the same index. The reverse scan also reverses the group order,
      # but that does not get in the way because the grouping key may come in any order.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val DESC) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,> REVERSE) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↓) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [300, 200, 100]},
                          {grp: 20, [500, 400]}]
    -
      # Ordering by a column other than the aggregated one. `T5_grp_other` provides the order, and `val` comes from the
      # record fetch, which preserves it.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY other) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_other <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.other ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [300, 200, 100]},
                          {grp: 20, [500, 400]}]
    -
      # An ungrouped aggregate needs an ordering on the sort key alone, here from `T5_val`.
      - query: SELECT ARRAY_AGG(val ORDER BY val) FROM T5
      - explain: "ISCAN(T5_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0)"
      - result: [{[100, 200, 300, 400, 500]}]
    -
      # ORDER BY combined with the in-call LIMIT collects a top-n list.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val DESC LIMIT 2) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,> REVERSE) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↓ LIMIT 2) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [300, 200]},
                          {grp: 20, [500, 400]}]
    -
      # An aggregate without an in-call ORDER BY imposes no ordering of its own, so it composes with one that does.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val), COUNT(*) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0, count_star(*) AS _1) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1, _._1._1 AS _2)"
      - unorderedResult: [{grp: 10, [100, 200, 300], 3},
                          {grp: 20, [400, 500], 2}]
    -
      # A plain ARRAY_AGG() alongside an ordered one. The plain one imposes no ordering of its own, but it does observe
      # the one the ordered one asks for, since both collect from the same stream. Here the rows arrive ordered by
      # `val`, so the plain aggregate collects `other` in that same order.
      - query: SELECT grp, ARRAY_AGG(other), ARRAY_AGG(val ORDER BY val) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.other) AS _0, array_agg(_._0.val ORDER BY _._0.val ↑) AS _1) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1, _._1._1 AS _2)"
      - unorderedResult: [{grp: 10, [3, 2, 1], [100, 200, 300]},
                          {grp: 20, [2, 1], [400, 500]}]
    -
      # Several aggregates may share one ordering.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val), ARRAY_AGG(other ORDER BY val) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0, array_agg(_._0.other ORDER BY _._0.val ↑) AS _1) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1, _._1._1 AS _2)"
      - unorderedResult: [{grp: 10, [100, 200, 300], [3, 2, 1]},
                          {grp: 20, [400, 500], [2, 1]}]
    -
      # Two aggregates demanding different orderings cannot both be served by one ordered stream.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val), ARRAY_AGG(other ORDER BY other) FROM T5 GROUP BY grp
      - error: UNSUPPORTED_QUERY
    -
      # Without an index providing (grp, id) the query cannot be planned.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY id) FROM T5 GROUP BY grp
      - error: UNSUPPORTED_QUERY
    -
      # In the natural tuple order, nulls come first, so an explicit NULLS LAST cannot be evaluated.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val ASC NULLS LAST) FROM T5 GROUP BY grp
      - error: UNSUPPORTED_QUERY
    -
      # Several grouping keys. The sort key has to follow all of them, so the index needs (grp, other, val). Note that
      # the grouping key parts are requested in the order they are written, so an index on (other, grp, val) would not
      # be explored even though the rows it enumerates would group just as well.
      - query: SELECT grp, other, ARRAY_AGG(val ORDER BY val) FROM T5 GROUP BY grp, other
      - explain: "ISCAN(T5_grp_other_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0, _._0.other AS _1) | MAP (_._0._0 AS grp, _._0._1 AS other, _._1._0 AS _2)"
      - unorderedResult: [{grp: 10, other: 1, [300]},
                          {grp: 10, other: 2, [200]},
                          {grp: 10, other: 3, [100]},
                          {grp: 20, other: 1, [500]},
                          {grp: 20, other: 2, [400]}]
    -
      # The natural null orders are the ones the tuple order already provides, so they need no further index.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val ASC NULLS FIRST) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [100, 200, 300]},
                          {grp: 20, [400, 500]}]
    -
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val DESC NULLS LAST) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,> REVERSE) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↓) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [300, 200, 100]},
                          {grp: 20, [500, 400]}]
    -
      # An ORDER BY clause cannot reach outside the input of its own aggregate; here `m.owner` belongs to the enclosing
      # query. This is rejected rather than failing an assertion inside the planner.
      - query: SELECT m.mid, sq.vals
               FROM doc_meta m,
                    (SELECT ARRAY_AGG(a.url ORDER BY m.owner) AS vals FROM doc_asset a WHERE a.rid = m.mid) sq
      - error: UNSUPPORTED_QUERY
    -
      # A repeated sort key adds nothing to what its first occurrence already requires, so it is dropped rather than
      # making the requested ordering unsatisfiable.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY val, val) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.val ↑, _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [100, 200, 300]},
                          {grp: 20, [400, 500]}]
    -
      # Two sort keys, where the second breaks ties of the first. T5_grp_val_other provides (grp, val, other).
      - query: SELECT grp, ARRAY_AGG(other ORDER BY val, other) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val_other <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.other ORDER BY _._0.val ↑, _._0.other ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [3, 2, 1]},
                          {grp: 20, [2, 1]}]
    -
      # A sort key that is also a grouping key is constant within the group, so it imposes no requirement of its own
      # and is dropped. Here only the `val` part remains, which `T5_grp_val` provides.
      - query: SELECT grp, ARRAY_AGG(val ORDER BY grp, val) FROM T5 GROUP BY grp
      - explain: "ISCAN(T5_grp_val <,>) | MAP (_ AS _0) | AGG (array_agg(_._0.val ORDER BY _._0.grp ↑, _._0.val ↑) AS _0) GROUP BY (_._0.grp AS _0) | MAP (_._0._0 AS grp, _._1._0 AS _1)"
      - unorderedResult: [{grp: 10, [100, 200, 300]},
                          {grp: 20, [400, 500]}]
...
