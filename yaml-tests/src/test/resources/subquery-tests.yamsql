---
options:
    connection_options:
      CASE_SENSITIVE_IDENTIFIERS: true
---
schema_template: |
  -- Column T2 has the same name as table T2, to test name resolution.
  CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
  CREATE TABLE T2 (id INTEGER, PRIMARY KEY(id))

  CREATE TYPE AS STRUCT s (f INTEGER)
  CREATE TABLE T3 (id INTEGER, i INTEGER, nr s ARRAY, PRIMARY KEY(id))
  CREATE INDEX T3_id_i AS SELECT id, i FROM T3 ORDER BY id, i

  CREATE TABLE T4 (id INTEGER, i INTEGER, PRIMARY KEY(id))
  CREATE INDEX T4_i AS SELECT i FROM T4

  CREATE TABLE T5 (id BIGINT, name STRING, PRIMARY KEY(id))
  CREATE TABLE T6 (id BIGINT, i1 BIGINT, i2 BIGINT, PRIMARY KEY(id))
  CREATE INDEX T6_i1 AS SELECT i1 FROM T6 ORDER BY i1

  -- A view and a function featuring an EXISTS subquery.
  CREATE VIEW V1 AS SELECT T4.i FROM T4 WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1)
  CREATE FUNCTION F1() AS SELECT T4.i FROM T4 WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1)

  -- View featuring a FROM-clause subquery.
  CREATE VIEW V2 AS SELECT sq.id FROM (SELECT * FROM T4 WHERE i > 10) sq

  -- Views and a function with further EXISTS subqueries.
  CREATE VIEW V3 AS SELECT p.id, EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id) AS e FROM T5 p
  CREATE VIEW V4 AS SELECT T4.i FROM T4 WHERE NOT EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1)
  CREATE FUNCTION F2(IN x BIGINT) AS SELECT p.id FROM T5 p WHERE EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id AND c.i2 > x)
---
setup:
  steps:
    - query: INSERT INTO T1 VALUES (1, 1), (2, 2), (3, 3)
    - query: INSERT INTO T2 VALUES (4), (5), (6)
    - query: INSERT INTO T3 VALUES
               (1, 10, [(11), (12), (13)]),
               (2, 20, [(21), (22), (23)]),
               (3, 30, [(31), (32), (33)])
    - query: INSERT INTO T4 VALUES (1, 10), (2, 20), (3, 30)
    - query: INSERT INTO T5 VALUES (1, 'a'), (2, 'b'), (3, 'c')
    - query: INSERT INTO T6 VALUES (1, 1, 100), (2, 1, 200), (3, 2, 300), (4, 2, NULL)
---
transaction_setups:
  temporary_function_with_exists:
    CREATE TEMPORARY FUNCTION TF1() ON COMMIT DROP FUNCTION AS
    SELECT T4.i FROM T4 WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1)
  temporary_function_with_grouped_exists:
    CREATE TEMPORARY FUNCTION TF2() ON COMMIT DROP FUNCTION AS
    SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
---
# Tests for (non-scalar) subqueries in the FROM clause.
test_block:
  name: subquery-from
  tests:
    -
      # PartiQL-style unnesting of an ARRAY column in the FROM clause.
      - query: SELECT id FROM T3, T3.nr AS nest WHERE nest.f = 23;
      - explain: "ISCAN(T3_id_i <,>) | FLATMAP q0 -> { EXPLODE q0.nr | FILTER _.f EQUALS promote(@c15 AS INT) AS q1 RETURN (q0.id AS id) }"
      - result: [{2}]
    -
      # The same unnesting, expressed as a FROM-clause subquery. The plan is the same as for the direct unnesting above.
      - query: SELECT id FROM T3, (SELECT * FROM T3.nr) AS nest WHERE nest.f = 23;
      - explain: "ISCAN(T3_id_i <,>) | FLATMAP q0 -> { EXPLODE q0.nr | FILTER _.f EQUALS promote(@c20 AS INT) AS q1 RETURN (q0.id AS id) }"
      - result: [{2}]
    -
      # FROM-clause subquery correlated to a preceding table source (`T1.T2`).
      - query: SELECT T2, sq.id, sq.nr FROM T1, (SELECT * FROM T3 WHERE T3.id = T1.T2) sq;
      - explain: "SCAN([IS T1]) | FLATMAP q0 -> { ISCAN(T3_id_i [EQUALS q0.T2]) AS q1 RETURN (q0.T2 AS T2, q1.id AS id, q1.nr AS nr) }"
      - result: [{T2: 1, 1, [{11}, {12}, {13}]}, {T2: 2, 2, [{21}, {22}, {23}]}, {T2: 3, 3, [{31}, {32}, {33}]}]
    -
      # Two FROM-clause subqueries, the second unnesting an ARRAY of the first, with further predicates in the outer
      # WHERE clause. Plans that push these predicates down into the subqueries should be preferred.
      - query: SELECT sq.id, sq.i
                 FROM (SELECT * FROM T3 WHERE id = 1) sq,
                      (SELECT f FROM sq.nr WHERE f > 10) sq2
                WHERE sq.i = 10
                  AND sq2.f IS NOT NULL
      - explain: "ISCAN(T3_id_i [EQUALS promote(@c17 AS INT), EQUALS promote(@c31 AS INT)]) | FLATMAP q0 -> { EXPLODE q0.nr | FILTER _.f GREATER_THAN promote(@c31 AS INT) AND _.f NOT_NULL AS q1 RETURN (q0.id AS id, q0.i AS i) }"
      - result: [{1, 10}, {1, 10}, {1, 10}]
    -
      # FROM-clause subquery containing a grouped query.
      - query: SELECT sq.i1, sq.n FROM (SELECT c.i1, COUNT(*) AS n FROM T6 c GROUP BY c.i1) sq
      - explain: "ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY (_._0.i1 AS _0) | MAP (_._0._0 AS i1, _._1._0 AS n)"
      - unorderedResult: [{i1: 1, n: 2}, {i1: 2, n: 2}]
    -
      # GROUP BY over a FROM-clause subquery.
      - query: SELECT sq.i1, COUNT(*) AS n FROM (SELECT * FROM T6) sq GROUP BY sq.i1
      - explain: "ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY (_._0.i1 AS _0) | MAP (_._0._0 AS i1, _._1._0 AS n)"
      - unorderedResult: [{i1: 1, n: 2}, {i1: 2, n: 2}]
    -
      # ORDER BY over a FROM-clause subquery.
      - query: SELECT sq.id FROM (SELECT * FROM T4) sq ORDER BY sq.i
      - explain: "COVERING(T4_i <,> -> [i: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id)"
      - result: [{1}, {2}, {3}]
    -
      # Nested FROM-clause subqueries.
      - query: SELECT sq2.id FROM (SELECT sq.id FROM (SELECT * FROM T4 WHERE i > 10) sq) sq2
      - explain: "COVERING(T4_i [[GREATER_THAN promote(@c19 AS INT)]] -> [i: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id)"
      - unorderedResult: [{2}, {3}]
    -
      # View featuring a FROM-clause subquery.
      - query: SELECT * FROM V2
      - explain: "COVERING(T4_i ([10],> -> [i: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id)"
      - unorderedResult: [{2}, {3}]
---
# Tests for EXISTS subqueries.
test_block:
  name: exists-subquery
  tests:
    -
      # Correlated EXISTS subquery in the SELECT list.
      - query: SELECT p.id, EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id) AS e FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0.id] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL AS q1 RETURN (q0.id AS id, exists(q1) AS e) }"
      - result: [{id: 1, e: true}, {id: 2, e: true}, {id: 3, e: false}]
    -
      # Uncorrelated EXISTS subquery in the SELECT list that is false for every row.
      - query: SELECT p.id, EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = 99) AS e FROM T5 p
      - explain: "COVERING(T6_i1 [EQUALS promote(@c19 AS LONG)] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) AS q1 RETURN (q1.id AS id, exists(q0) AS e) }"
      - result: [{id: 1, e: false}, {id: 2, e: false}, {id: 3, e: false}]
    -
      # Uncorrelated EXISTS subquery in the SELECT list of a grouped query.
      # It is evaluated on top of the grouping, where it is constant for every group.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - unorderedResult: [{i: 10, e: true}, {i: 20, e: true}, {i: 30, e: true}]
    -
      # The same but with an EXISTS subquery that is false for every group.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99) AS e FROM T4 GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - unorderedResult: [{i: 10, e: false}, {i: 20, e: false}, {i: 30, e: false}]
    -
      # The same but with a correlated EXISTS subquery in the WHERE clause as well, which is evaluated below the
      # grouping.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e
                 FROM T4
                WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1)
             GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c42 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | FLATMAP q1 -> { SCAN([IS T1, [GREATER_THAN promote(@c42 AS INT)]]) | FILTER _.T2 EQUALS q1.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q2 RETURN (q1 AS _0, q2 AS _1) } | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - unorderedResult: [{i: 20, e: true}, {i: 30, e: true}]
    -
      # The same but selecting an aliased grouping column.
      - query: SELECT g, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i AS g
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c14 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS g, exists(q0) AS e) }"
      - unorderedResult: [{g: 10, e: true}, {g: 20, e: true}, {g: 30, e: true}]
    -
      # The same but with NOT EXISTS.
      - query: SELECT T4.i, NOT EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c17 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, NOT exists(q0) AS e) }"
      - unorderedResult: [{i: 10, e: false}, {i: 20, e: false}, {i: 30, e: false}]
    -
      # The same but grouping a join.
      - query: SELECT p.id, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e, COUNT(*) AS n
                 FROM T5 p JOIN T6 c ON c.i1 = p.id
             GROUP BY p.id
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) | FLATMAP q1 -> { ISCAN(T6_i1 [EQUALS q1.id]) AS q2 RETURN (q1 AS _0, q2 AS _1) } | AGG (count_star(*) AS _0) GROUP BY (_._0.id AS _0) AS q0 RETURN (q0._0._0 AS id, exists(q0) AS e, q0._1._0 AS n) }"
      - unorderedResult: [{id: 1, e: true, n: 2}, {id: 2, e: true, n: 2}]
    -
      # The same but in both legs of a UNION ALL.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i
               UNION ALL
               SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99) AS e FROM T4 GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) } ⊎ SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c45 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q1 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q1) AS e) }"
      - unorderedResult: [{i: 10, e: true}, {i: 20, e: true}, {i: 30, e: true},
                          {i: 10, e: false}, {i: 20, e: false}, {i: 30, e: false}]
    -
      # The same but in a CTE.
      - query: WITH g AS (SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i)
               SELECT * FROM g
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c20 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - unorderedResult: [{i: 10, e: true}, {i: 20, e: true}, {i: 30, e: true}]
    -
      # EXISTS subquery in the SELECT list of a grouped query, correlated to a non-grouping column (`T4.id`).
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id) AS e FROM T4 GROUP BY T4.i
      - error: GROUPING_ERROR
    -
      # Uncorrelated EXISTS subquery in the SELECT list of an aggregate query without GROUP BY.
      - query: SELECT COUNT(*) AS n, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c19 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (coalesce_long(q0._0._0, 0l) AS n, exists(q0) AS e) }"
      - result: [{n: 3, e: true}]
    -
      # The same but over an empty input, which still yields a single row.
      - query: SELECT COUNT(*) AS n, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 WHERE T4.i > 100
      - supported_version: 4.16.3.0
      - explain: "ISCAN(T4_i [[GREATER_THAN promote(@c30 AS INT)]]) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL | FLATMAP q0 -> { SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c19 AS INT) | MAP (_.id AS id) | DEFAULT NULL AS q1 RETURN (coalesce_long(q0._0._0, 0l) AS n, exists(q1) AS e) }"
      - result: [{n: 0, e: true}]
    -
      # Uncorrelated EXISTS subquery inside an aggregate function argument of a grouped query.
      - query: SELECT T4.i, SUM(CASE WHEN EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) THEN 1 ELSE 0 END) AS s
                 FROM T4
             GROUP BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c20 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG (sum_i(pick(ConditionSelector(exists(q0), TRUE), @c20, @c25)) AS _0) GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, q0._1._0 AS s) }"
      - unorderedResult: [{i: 10, s: 1}, {i: 20, s: 1}, {i: 30, s: 1}]
    -
      # The same but in an aggregate query without GROUP BY, so that the aggregate sees several rows.
      - query: SELECT SUM(CASE WHEN EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) THEN 1 ELSE 0 END) AS s FROM T4
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG (sum_i(pick(ConditionSelector(exists(q0), TRUE), @c16, @c21)) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (q0._0._0 AS s) }"
      - result: [{s: 3}]
    -
      # EXISTS subquery inside an aggregate function argument of a grouped query, correlated to the grouped rows (`T4.id`).
      # TODO This is valid SQL, but currently rejected.
      # Supporting it would require evaluating the subquery below the grouping, as part of the aggregate function argument.
      - query: SELECT T4.i, SUM(CASE WHEN EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id) THEN 1 ELSE 0 END) AS s
                 FROM T4
             GROUP BY T4.i
      - supported_version: 4.16.3.0
      - error: GROUPING_ERROR
    -
      # EXISTS subquery in the SELECT list, containing a grouped query with an EXISTS subquery in its own SELECT list.
      - query: SELECT p.id,
                      EXISTS (SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) FROM T4 GROUP BY T4.i) AS e
                 FROM T5 p
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c23 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS _1) } | DEFAULT NULL | FLATMAP q1 -> { SCAN([IS T5]) AS q2 RETURN (q2.id AS id, exists(q1) AS e) }"
      - unorderedResult: [{id: 1, e: true}, {id: 2, e: true}, {id: 3, e: true}]
    -
      # EXISTS subquery in a row of an inline VALUES table in the FROM clause.
      - query: SELECT * FROM VALUES (1, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)) AS t (a, e)
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c5 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { EXPLODE array((@c5 AS a, exists(q0) AS e)) AS q1 RETURN q1 }"
      - result: [{a: 1, e: true}]
    -
      # Correlated EXISTS subquery in the ON clause of an INNER JOIN.
      - query: SELECT p.id, c.id AS cid FROM T5 p JOIN T6 c ON c.i1 = p.id AND EXISTS (SELECT id FROM T1 WHERE T1.id = c.id)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | FLATMAP q1 -> { SCAN([IS T1]) | FILTER promote(_.id AS LONG) EQUALS q1.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | MAP (1 AS _0) AS q2 RETURN q1 } AS q1 RETURN (q0.id AS id, q1.id AS cid) }"
      - unorderedResult: [{id: 1, cid: 1}, {id: 1, cid: 2}, {id: 2, cid: 3}]
    -
      # Uncorrelated EXISTS subquery in the WHERE clause, over the same table as the outer query. The column `id`
      # resolves within the subquery.
      - query: SELECT id FROM T1 WHERE EXISTS (SELECT id FROM T1 WHERE id = 1)
      - explain: "SCAN([IS T1, EQUALS promote(@c14 AS INT)]) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { SCAN([IS T1]) AS q1 RETURN (q1.id AS id) }"
      - result: [{1}, {2}, {3}]
    -
      # EXISTS subquery in the WHERE clause, projecting `T2`, which names both a column of the subquery table `T1` and
      # the outer table. The name resolves within the subquery; an outer query block is only consulted if resolution
      # in the current block fails.
      - query: SELECT id FROM T2 WHERE EXISTS (SELECT T2 FROM T1 WHERE id = 1)
      - explain: "SCAN([IS T1, EQUALS promote(@c14 AS INT)]) | MAP (_.T2 AS T2) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { SCAN([IS T2]) AS q1 RETURN (q1.id AS id) }"
      - result: [{4}, {5}, {6}]
    -
      # Correlated EXISTS subquery in the WHERE clause. The row of T5 with id 3 has no children.
      - query: SELECT p.id FROM T5 p WHERE EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0.id] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.id AS id) }"
      - unorderedResult: [{1}, {2}]
    -
      # The same subquery with NOT EXISTS.
      - query: SELECT p.id FROM T5 p WHERE NOT EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0.id] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL | FILTER NOT _ NOT_NULL AS q1 RETURN (q0.id AS id) }"
      - unorderedResult: [{3}]
    -
      # Correlated EXISTS subquery in the WHERE clause, as one term of an OR disjunction.
      - query: SELECT p.id FROM T5 p WHERE p.id = 3 OR EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id AND c.i2 > 250)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | FILTER _.i2 GREATER_THAN promote(@c36 AS LONG) | MAP (_.id AS id) | DEFAULT NULL | FILTER q0.id EQUALS promote(@c12 AS LONG) OR _ NOT_NULL AS q1 RETURN (q0.id AS id) }"
      - unorderedResult: [{2}, {3}]
    -
      # View with a correlated EXISTS subquery in its WHERE clause.
      - query: SELECT * FROM V1
      - supported_version: 4.15.3.0
      - explain: "ISCAN(T4_i <,>) | FLATMAP q0 -> { SCAN([IS T1, [GREATER_THAN 1]]) | FILTER _.T2 EQUALS q0.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.i AS i) }"
      - unorderedResult: [{20}, {30}]
    -
      # The same for a function.
      - query: SELECT * FROM F1()
      - supported_version: 4.15.3.0
      - explain: "ISCAN(T4_i <,>) | FLATMAP q0 -> { SCAN([IS T1, [GREATER_THAN 1]]) | FILTER _.T2 EQUALS q0.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.i AS i) }"
      - unorderedResult: [{20}, {30}]
    -
      # The same for a temporary function.
      - query: SELECT * FROM TF1()
      - setupReference: temporary_function_with_exists
      - explain: "ISCAN(T4_i <,>) | FLATMAP q0 -> { SCAN([IS T1, [GREATER_THAN promote(@cTF137 AS INT)]]) | FILTER _.T2 EQUALS q0.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.i AS i) }"
      - unorderedResult: [{20}, {30}]
    -
      # View with a correlated NOT EXISTS subquery in its WHERE clause.
      - query: SELECT * FROM V4
      - supported_version: 4.15.3.0
      - explain: "ISCAN(T4_i <,>) | FLATMAP q0 -> { SCAN([IS T1, [GREATER_THAN 1]]) | FILTER _.T2 EQUALS q0.id | MAP (_.id AS id) | DEFAULT NULL | FILTER NOT _ NOT_NULL AS q1 RETURN (q0.i AS i) }"
      - unorderedResult: [{10}]
    -
      # Function with an EXISTS subquery correlated to a parameter of the function (`x`).
      - query: SELECT * FROM F2(150)
      - supported_version: 4.15.3.0
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | FILTER _.i2 GREATER_THAN promote(@c5 AS LONG) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.id AS id) }"
      - unorderedResult: [{1}, {2}]
    -
      # View with a correlated EXISTS subquery in its SELECT list.
      - query: SELECT * FROM V3
      - supported_version: 4.15.3.0
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0.id] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL AS q1 RETURN (q0.id AS id, exists(q1) AS e) }"
      - unorderedResult: [{id: 1, e: true}, {id: 2, e: true}, {id: 3, e: false}]
    -
      # Temporary function with an uncorrelated EXISTS subquery in the HAVING clause of a grouped query.
      - query: SELECT * FROM TF2()
      - supported_version: 4.16.3.0
      - setupReference: temporary_function_with_grouped_exists
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@cTF234 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i) }"
      - unorderedResult: [{10}, {20}, {30}]
    -
      # Correlated EXISTS subquery in the WHERE clause, containing a grouped query that projects a qualified outer
      # column (`T1.T2`).
      - query: SELECT T2 FROM T1 WHERE EXISTS (SELECT T1.T2, MAX(id) FROM T4 WHERE i > T1.T2 * 10 GROUP BY i)
      - explain: "SCAN([IS T1]) | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN q0.T2 * @c25]]) | MAP (_ AS _0) | AGG (max_i(_._0.id) AS _0) GROUP BY (_._0.i AS _0) | MAP (q0.T2 AS T2, _._1._0 AS _1) | DEFAULT NULL | FILTER _ NOT_NULL AS q0 RETURN (q0.T2 AS T2) }"
      - unorderedResult: [{1}, {2}]
    -
      # The same but with an unqualified outer column (`T2`).
      - query: SELECT T2 FROM T1 WHERE EXISTS (SELECT T2, MAX(id) FROM T4 WHERE i > T2 * 10 GROUP BY i)
      - explain: "SCAN([IS T1]) | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN q0.T2 * @c21]]) | MAP (_ AS _0) | AGG (max_i(_._0.id) AS _0) GROUP BY (_._0.i AS _0) | MAP (q0.T2 AS T2, _._1._0 AS _1) | DEFAULT NULL | FILTER _ NOT_NULL AS q0 RETURN (q0.T2 AS T2) }"
      - unorderedResult: [{1}, {2}]
    -
      # Correlated EXISTS subquery in the WHERE clause, containing a grouped query that aggregates an unqualified outer
      # column (`MAX(T2)`).
      - query: SELECT T2 FROM T1 WHERE EXISTS (SELECT MAX(T2), MAX(id) FROM T4 WHERE i > T2 * 10 GROUP BY i)
      - explain: "SCAN([IS T1]) | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN q0.T2 * @c24]]) | MAP (_ AS _0) | AGG (max_i(q0.T2) AS _0, max_i(_._0.id) AS _1) GROUP BY (_._0.i AS _0) | MAP (_._1._0 AS _0, _._1._1 AS _1) | DEFAULT NULL | FILTER _ NOT_NULL AS q0 RETURN (q0.T2 AS T2) }"
      - unorderedResult: [{1}, {2}]
    -
      # The same but with a qualified outer column (`MAX(T1.T2)`).
      - query: SELECT T2 FROM T1 WHERE EXISTS (SELECT MAX(T1.T2), MAX(id) FROM T4 WHERE i > T2 * 10 GROUP BY i)
      - explain: "SCAN([IS T1]) | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN q0.T2 * @c26]]) | MAP (_ AS _0) | AGG (max_i(q0.T2) AS _0, max_i(_._0.id) AS _1) GROUP BY (_._0.i AS _0) | MAP (_._1._0 AS _0, _._1._1 AS _1) | DEFAULT NULL | FILTER _ NOT_NULL AS q0 RETURN (q0.T2 AS T2) }"
      - unorderedResult: [{1}, {2}]
    -
      # EXISTS subquery in GROUP BY. This is not supported.
      - query: SELECT COUNT(*) AS n FROM T4 GROUP BY EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - error: UNSUPPORTED_QUERY
    -
      # Uncorrelated EXISTS subquery in the HAVING clause.
      # It is evaluated on top of the grouping, where it is constant for every group.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c23 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i) }"
      - unorderedResult: [{10}, {20}, {30}]
    -
      # The same but with an empty subquery, which rejects every group.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c23 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i) }"
      - unorderedResult: []
    -
      # The same but with NOT EXISTS.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i HAVING NOT EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c24 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER NOT _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i) }"
      - unorderedResult: [{10}, {20}, {30}]
    -
      # The same but as one term of an OR disjunction.
      # Unlike above, the plan evaluates the EXISTS subquery inside the FLATMAP over the groups, i.e., once per group.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i HAVING T4.i = 10 OR EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99)
      - supported_version: 4.16.3.0
      - explain: "ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) | FLATMAP q0 -> { SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c29 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER q0._0._0 EQUALS promote(@c16 AS INT) OR _ NOT_NULL AS q1 RETURN (q0._0._0 AS i) }"
      - unorderedResult: [{10}]
    -
      # Uncorrelated EXISTS subquery in the HAVING clause of an aggregate query without GROUP BY, over an empty input.
      # The single group is kept.
      - query: SELECT COUNT(*) AS n FROM T4 WHERE T4.i > 100 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c27 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN promote(@c14 AS INT)]]) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (coalesce_long(q0._0._0, 0l) AS n) }"
      - result: [{n: 0}]
    -
      # The same but with an empty subquery, which rejects the single group.
      - query: SELECT COUNT(*) AS n FROM T4 WHERE T4.i > 100 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c27 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i [[GREATER_THAN promote(@c14 AS INT)]]) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL AS q0 RETURN (coalesce_long(q0._0._0, 0l) AS n) }"
      - result: []
    -
      # Uncorrelated EXISTS subquery in the HAVING clause of a query without GROUP BY or aggregate functions.
      # The HAVING clause alone makes all rows a single group, so the query yields a single row.
      - query: SELECT 7 AS x FROM T4 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c18 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY () | ON EMPTY NULL AS q0 RETURN (7 AS x) }"
      - result: [{x: 7}]
    -
      # The same but with an empty subquery, which rejects the single group.
      - query: SELECT 7 AS x FROM T4 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 99)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c18 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY () | ON EMPTY NULL AS q0 RETURN (7 AS x) }"
      - result: []
    -
      # The same but over an empty input, which still forms a single group.
      - query: SELECT 7 AS x FROM T4 WHERE T4.i > 100 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - explain: "ISCAN(T4_i [[GREATER_THAN promote(@c11 AS INT)]]) | MAP (_ AS _0) | AGG () GROUP BY () | ON EMPTY NULL | FLATMAP q0 -> { SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c24 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (7 AS x) }"
      - result: [{x: 7}]
    -
      # The same but with an aggregate function only in the HAVING clause, and without a subquery.
      - query: SELECT 7 AS x FROM T4 HAVING COUNT(*) > 5
      - supported_version: 4.16.3.0
      - explain: "ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL | FILTER coalesce_long(_._0._0, 0l) GREATER_THAN promote(@c12 AS LONG) | MAP (7 AS x)"
      - result: []
    -
      # The same but selecting a column that is neither grouped nor aggregated.
      - query: SELECT T4.i FROM T4 HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - error: GROUPING_ERROR
    -
      # The same but with an aliased grouping column.
      - query: SELECT g FROM T4 GROUP BY T4.i AS g HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c23 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS g) }"
      - unorderedResult: [{10}, {20}, {30}]
    -
      # EXISTS subquery in the HAVING clause, correlated to an aliased grouping column (`g`).
      - query: SELECT g FROM T4 GROUP BY T4.i AS g HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 * 10 = g)
      - error: GROUPING_ERROR
    -
      # Uncorrelated EXISTS subqueries in both the SELECT list and the HAVING clause.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e
                 FROM T4
             GROUP BY T4.i
               HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 2)
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c39 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN q0 } | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - unorderedResult: [{i: 10, e: true}, {i: 20, e: true}, {i: 30, e: true}]
    -
      # EXISTS subquery in the HAVING clause of a grouped subquery, correlated to the enclosing query (`p.id`) rather
      # than to the grouped rows.
      - query: SELECT p.id
                 FROM T5 p
                WHERE EXISTS (SELECT T4.i
                                FROM T4
                            GROUP BY T4.i
                              HAVING EXISTS (SELECT id FROM T1 WHERE T1.id = p.id AND T1.id > 1))
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { SCAN([IS T1, [GREATER_THAN promote(@c41 AS INT)]]) | FILTER promote(_.id AS LONG) EQUALS q0.id | MAP (_.id AS id) | DEFAULT NULL | FILTER _ NOT_NULL | FLATMAP q1 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i) } | DEFAULT NULL | FILTER _ NOT_NULL AS q1 RETURN (q0.id AS id) }"
      - unorderedResult: [{2}, {3}]
    -
      # EXISTS subquery in the HAVING clause, correlated to a grouping column (`T4.i`).
      # TODO This is valid SQL, but currently rejected.
      # Supporting it would require rewriting the correlation to the grouped rows into one to the output of the grouping.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.i)
      - error: GROUPING_ERROR
    -
      # EXISTS subquery in the HAVING clause, whose nested EXISTS subquery is correlated to the grouped rows
      # (`T4.id`).
      - query: SELECT T4.i
                 FROM T4
             GROUP BY T4.i
               HAVING EXISTS (SELECT id FROM T1 WHERE EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = T4.id))
      - error: GROUPING_ERROR
    -
      # EXISTS subquery in ORDER BY. This is not supported.
      - query: SELECT p.id FROM T5 p ORDER BY EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id)
      - error: UNSUPPORTED_QUERY
    -
      # EXISTS subquery in the SELECT list, referred to by its alias in ORDER BY. This is not supported.
      - query: SELECT p.id, EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id) AS e FROM T5 p ORDER BY e
      - error: UNSUPPORTED_QUERY
    -
      # The same in a grouped query.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i ORDER BY e
      - supported_version: 4.16.3.0
      - error: UNSUPPORTED_QUERY
    -
      # Uncorrelated EXISTS subquery in the SELECT list, referred to by its alias in ORDER BY. This is not supported.
      - query: SELECT p.id, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T5 p ORDER BY e
      - error: UNSUPPORTED_QUERY
    -
      # The same but after the primary key in ORDER BY.
      - query: SELECT p.id, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T5 p ORDER BY p.id, e
      - error: UNSUPPORTED_QUERY
    -
      # Correlated EXISTS subquery in the SELECT list of a query that is sorted by the alias of another column.
      - query: SELECT p.id AS x, EXISTS (SELECT c.id FROM T6 c WHERE c.i1 = p.id) AS e FROM T5 p ORDER BY x
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0.id] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (_.id AS id) | DEFAULT NULL AS q1 RETURN (q0.id AS x, exists(q1) AS e) }"
      - result: [{x: 1, e: true}, {x: 2, e: true}, {x: 3, e: false}]
    -
      # The same in a grouped query, with an uncorrelated EXISTS subquery.
      - query: SELECT T4.i AS g, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i ORDER BY g
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c18 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS g, exists(q0) AS e) }"
      - result: [{g: 10, e: true}, {g: 20, e: true}, {g: 30, e: true}]
    -
      # EXISTS subquery in the ORDER BY clause of a grouped query. This is not supported.
      - query: SELECT T4.i FROM T4 GROUP BY T4.i ORDER BY EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - error: UNSUPPORTED_QUERY
    -
      # Uncorrelated EXISTS subquery in the SELECT list of a grouped query that is sorted by its grouping column.
      - query: SELECT T4.i, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e FROM T4 GROUP BY T4.i ORDER BY T4.i
      - supported_version: 4.16.3.0
      - explain: "SCAN([IS T1]) | FILTER _.T2 EQUALS promote(@c16 AS INT) | MAP (_.id AS id) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T4_i <,>) | MAP (_ AS _0) | AGG () GROUP BY (_._0.i AS _0) AS q0 RETURN (q0._0._0 AS i, exists(q0) AS e) }"
      - result: [{i: 10, e: true}, {i: 20, e: true}, {i: 30, e: true}]
---
# Tests for scalar subqueries.
test_block:
  name: scalar-subquery
  options:
    supported_version: !current_version
  tests:
    -
      # Subquery projecting more than 1 column. This is rejected up front, before planning.
      - query: SELECT p.id, (SELECT c.id, c.i2 FROM T6 c WHERE c.i1 = p.id) AS v FROM T5 p
      - error: SUBQUERY_INCORRECT_COLUMN_COUNT
    -
      # Subquery projecting more than 1 column via SELECT *. This is rejected for the same reason, as the table has more
      # than 1 column.
      - query: SELECT p.id, (SELECT * FROM T6 c WHERE c.id = p.id) AS v FROM T5 p
      - error: SUBQUERY_INCORRECT_COLUMN_COUNT
    -
      # Correlated aggregate subquery in the SELECT list. The row of T5 with id = 3 has no children, so its subquery is
      # empty and yields NULL. An ungrouped aggregate is provably single-row, so no MAX 1 RECORD check is added to the
      # plan.
      - query: SELECT p.id, (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) AS total FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL AS q0 RETURN (q0.id AS id, q0._0 AS total) }"
      - result: [{id: 1, total: 300}, {id: 2, total: 300}, {id: 3, total: !null _}]
    -
      # Uncorrelated aggregate subquery in the SELECT list. No decorrelation is needed at all.
      - query: SELECT p.id, (SELECT SUM(c.i2) FROM T6 c) AS total FROM T5 p
      - explain: "ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) AS q1 RETURN (q1.id AS id, q0._0 AS total) }"
      - result: [{id: 1, total: 600}, {id: 2, total: 600}, {id: 3, total: 600}]
    -
      # Non-aggregate subquery with an equality on the primary key of T6, returning exactly 1 row per outer row. No
      # MAX 1 RECORD check is added, as the planner can see that it’s single-row from the primary-key scan.
      - query: SELECT p.id, (SELECT c.i2 FROM T6 c WHERE c.id = p.id) AS v FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { SCAN([IS T6, EQUALS q0.id]) | MAP (_.i2 AS i2) | DEFAULT NULL AS q1 RETURN (q0.id AS id, q1.i2 AS v) }"
      - result: [{id: 1, v: 100}, {id: 2, v: 200}, {id: 3, v: 300}]
    -
      # Subquery returning 0 rows. It yields NULL rather than dropping the outer row.
      - query: SELECT p.id, (SELECT c.i2 FROM T6 c WHERE c.i1 = 999) AS v FROM T5 p
      - explain: "ISCAN(T6_i1 [EQUALS promote(@c18 AS LONG)]) | MAP (_.i2 AS i2) | MAX 1 RECORD | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) AS q1 RETURN (q1.id AS id, q0.i2 AS v) }"
      - result: [{id: 1, v: !null _}, {id: 2, v: !null _}, {id: 3, v: !null _}]
    -
      # Scalar subquery as part of a larger expression.
      - query: SELECT p.id, p.id + (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) AS total FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL AS q0 RETURN (q0.id AS id, q0.id + q0._0 AS total) }"
      - result: [{id: 1, total: 301}, {id: 2, total: 302}, {id: 3, total: !null _}]
    -
      # More than one scalar subquery in the same SELECT list.
      - query: SELECT (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) AS total,
                      (SELECT SUM(c.id) FROM T6 c WHERE c.i1 = p.id) AS ids
                 FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.id) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL AS q0 RETURN (q0 AS _0, q0 AS _1) } AS q1 RETURN (q1._0._0 AS total, q1._1._0 AS ids) }"
      - result: [{total: 300, ids: 3}, {total: 300, ids: 7}, {total: !null _, ids: !null _}]
    -
      # Scalar subquery inside a CASE expression.
      - query: SELECT p.id, CASE WHEN p.id = 1 THEN (SELECT MAX(c.i2) FROM T6 c) ELSE 0 END AS v FROM T5 p
      - explain: "ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (max_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) AS q1 RETURN (q1.id AS id, pick(ConditionSelector(q1.id equals @c11, TRUE), q0._0, promote(@c26 AS LONG)) AS v) }"
      - result: [{id: 1, v: 300}, {id: 2, v: 0}, {id: 3, v: 0}]
    -
      # SELECT item that mixes an aggregate with a scalar subquery, which is constant for the (single) group.
      - query: SELECT p.id,
                      (SELECT SUM(c.i2) + (SELECT SUM(c2.id) FROM T6 c2) FROM T6 c WHERE c.i1 = p.id) AS total
                 FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | FLATMAP q0 -> { ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (sum_l(_._0.id) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL AS q0 RETURN (q0._0._0 + q0._0 AS _0) } | DEFAULT NULL AS q1 RETURN (q0.id AS id, q1._0 AS total) }"
      - result: [{id: 1, total: 310}, {id: 2, total: 310}, {id: 3, total: !null _}]
    -
      # Scalar subquery that itself contains a scalar subquery.
      - query: SELECT p.id,
                      (SELECT c.i2
                         FROM T6 c
                        WHERE c.id = (SELECT MIN(c2.id) FROM T6 c2 WHERE c2.i1 = p.id)
                      ) AS v
                 FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (min_l(_._0.id) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T6, EQUALS q0._0]) AS q1 RETURN (q1.i2 AS i2) } | DEFAULT NULL AS q2 RETURN (q0.id AS id, q2.i2 AS v) }"
      - result: [{id: 1, v: 100}, {id: 2, v: 300}, {id: 3, v: !null _}]
    -
      # Subquery returning more than 1 row, which is a CARDINALITY_VIOLATION. The rows of T5 with id = 1 and id = 2
      # have two children each. The violation is raised by the MAX 1 RECORD node below the DEFAULT NULL.
      - query: SELECT p.id, (SELECT c.i2 FROM T6 c WHERE c.i1 = p.id) AS v FROM T5 p
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_.i2 AS i2) | MAX 1 RECORD | DEFAULT NULL AS q1 RETURN (q0.id AS id, q1.i2 AS v) }"
      - error: CARDINALITY_VIOLATION
    -
      # Uncorrelated subquery returning more than 1 row, which is a CARDINALITY_VIOLATION as well.
      - query: SELECT p.id, (SELECT c.i2 FROM T6 c) AS v FROM T5 p
      - explain: "ISCAN(T6_i1 <,>) | MAP (_.i2 AS i2) | MAX 1 RECORD | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5]) AS q1 RETURN (q1.id AS id, q0.i2 AS v) }"
      - error: CARDINALITY_VIOLATION
    -
      # LIMIT inside a subquery. This is rejected outright. (It would otherwise be a useful feature, as LIMIT provides a
      # natural way to turn any subquery into a guaranteed single-row query.)
      - query: SELECT p.id, (SELECT c.i2 FROM T6 c WHERE c.i1 = p.id LIMIT 1) AS v FROM T5 p
      - error: UNSUPPORTED_QUERY
    -
      # Scalar subquery in an explicit JOIN…ON clause. Each row of T5 joins to the children of the row named by its own
      # id, so every row matches two children.
      - query: SELECT p.id FROM T5 p JOIN T6 c ON c.i1 = (SELECT MIN(c2.i1) FROM T6 c2 WHERE c2.id = p.id)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { SCAN([IS T6, EQUALS q0.id]) | MAP (_ AS _0) | AGG (min_l(_._0.i1) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { COVERING(T6_i1 [EQUALS q0._0] -> [i1: KEY:[0], id: KEY:[2]]) | MAP (1 AS _0) AS q1 RETURN (1 AS _0) } AS q2 RETURN (q0.id AS id) }"
      - result: [{1}, {1}, {2}, {2}, {3}, {3}]
    -
      # Uncorrelated scalar subquery in the WHERE clause.
      - query: SELECT p.id FROM T5 p WHERE p.id = (SELECT SUM(c.id) FROM T6 c WHERE c.i1 = 1)
      - explain: "ISCAN(T6_i1 [EQUALS promote(@c28 AS LONG)]) | MAP (_ AS _0) | AGG (sum_l(_._0.id) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { SCAN([IS T5, EQUALS q0._0]) AS q1 RETURN (q1.id AS id) }"
      - result: [{3}]
    -
      # Correlated scalar subquery in the WHERE clause.
      - query: SELECT p.id FROM T5 p WHERE (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) > 250
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FILTER _._0 GREATER_THAN promote(@c29 AS LONG) AS q0 RETURN (q0.id AS id) }"
      - result: [{1}, {2}]
    -
      # Correlated scalar subquery in the WHERE clause, as one term of an OR disjunction. The row of T5 with id = 1
      # fails both terms, as its largest child i2 is 200.
      - query: SELECT p.id FROM T5 p WHERE p.id = 3 OR (SELECT MAX(c.i2) FROM T6 c WHERE c.i1 = p.id) > 250
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (max_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FILTER q0.id EQUALS promote(@c12 AS LONG) OR _._0 GREATER_THAN promote(@c35 AS LONG) AS q0 RETURN (q0.id AS id) }"
      - unorderedResult: [{2}, {3}]
    -
      # Empty scalar subquery in the WHERE clause. It yields NULL, and a NULL predicate does not select the row.
      - query: SELECT p.id FROM T5 p WHERE (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) IS NULL
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (sum_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FILTER _._0 IS_NULL AS q0 RETURN (q0.id AS id) }"
      - result: [{3}]
    -
      # Scalar subquery in a join predicate in the WHERE clause.
      - query: SELECT p.id, c.id AS cid
                 FROM T5 p, T6 c
                WHERE c.i1 = p.id
                  AND c.i2 = (SELECT MAX(c2.i2) FROM T6 c2 WHERE c2.i1 = p.id)
      - explain: "SCAN([IS T5]) | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | MAP (_ AS _0) | AGG (max_l(_._0.i2) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FLATMAP q0 -> { ISCAN(T6_i1 [EQUALS q0.id]) | FILTER _.i2 EQUALS q0._0 AS q1 RETURN q1 } AS q1 RETURN (q0.id AS id, q1.id AS cid) }"
      - result: [{id: 1, cid: 2}, {id: 2, cid: 3}]
    -
      # Scalar subquery in GROUP BY. This is not supported.
      - query: SELECT COUNT(*) AS n FROM T6 c GROUP BY (SELECT MAX(c2.id) FROM T6 c2)
      - error: UNSUPPORTED_QUERY
    -
      # Uncorrelated scalar subquery in the HAVING clause, compared with an aggregate. The children of the row of T5
      # with id = 1 have ids summing up to 3; those of the row with id = 2 sum up to 7.
      - query: SELECT c.i1 FROM T6 c GROUP BY c.i1 HAVING SUM(c.id) < (SELECT MAX(c2.id) FROM T6 c2)
      - explain: "ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (sum_l(_._0.id) AS _0) GROUP BY (_._0.i1 AS _0) | FLATMAP q0 -> { ISCAN(T6_i1 <,>) | MAP (_ AS _0) | AGG (max_l(_._0.id) AS _0) GROUP BY () | ON EMPTY NULL | MAP (_._0._0 AS _0) | DEFAULT NULL | FILTER q0._1._0 LESS_THAN _._0 AS q0 RETURN (q0._0._0 AS i1) }"
      - result: [{i1: 1}]
    -
      # Scalar subquery in the SELECT list of a grouped query, correlated to a non-grouping column (`p.id`). It takes a
      # different value for each row of a group, so the query is invalid SQL and must stay rejected, even once
      # subqueries correlated to grouping columns are supported.
      - query: SELECT p.name, (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) AS total FROM T5 p GROUP BY p.name
      - error: GROUPING_ERROR
    -
      # Scalar subquery in ORDER BY. This is not supported.
      - query: SELECT p.id FROM T5 p ORDER BY (SELECT SUM(c.i2) FROM T6 c WHERE c.i1 = p.id) DESC
      - error: UNSUPPORTED_QUERY
    -
      # Scalar subquery supplying a value in INSERT…VALUES. This is not supported.
      - query: INSERT INTO T6 VALUES (10, 1, (SELECT MAX(c.i2) FROM T6 c))
      - error: UNSUPPORTED_QUERY
    -
      # Scalar subquery on the right-hand side of UPDATE…SET. This is not supported.
      - query: UPDATE T6 SET i2 = (SELECT MAX(c.i2) FROM T6 c) WHERE id = 1
      - error: UNSUPPORTED_QUERY
---
# Tests for subqueries in INSERT, UPDATE and DELETE statements.
test_block:
  name: subquery-in-dml
  preset: single_repetition_ordered
  options:
    # Some of these statements write data, so they must not be executed a second time for the cache check.
    check_cache: false
  tests:
    -
      # Correlated EXISTS subquery in the WHERE clause of an UPDATE.
      - query: UPDATE T4 SET i = i WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id AND T1.id > 1) RETURNING "new".id
      - unorderedResult: [{2}, {3}]
    -
      # Uncorrelated scalar subquery in the WHERE clause of an UPDATE.
      - query: UPDATE T4 SET i = i WHERE i = (SELECT MAX(t.i) FROM T4 t) RETURNING "new".id
      - supported_version: !current_version
      - result: [{3}]
    -
      # Uncorrelated EXISTS subquery in the RETURNING clause of an UPDATE.
      - query: UPDATE T4 SET i = i WHERE id = 1 RETURNING "new".id, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e
      - result: [{id: 1, e: true}]
    -
      # EXISTS subquery on the right-hand side of UPDATE…SET. This is not supported.
      - query: UPDATE T4 SET i = CASE WHEN EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) THEN i ELSE 0 END WHERE id = 1
      - supported_version: 4.16.3.0
      - error: UNSUPPORTED_QUERY
    -
      # EXISTS subquery supplying a value in INSERT…VALUES. This is not supported.
      - query: INSERT INTO T4 VALUES (9, CASE WHEN EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) THEN 90 ELSE 0 END)
      - supported_version: 4.16.3.0
      - error: UNSUPPORTED_QUERY
    -
      # Insert a row for the DELETE below.
      - query: INSERT INTO T4 VALUES (8, 80)
      - count: 1
    -
      # Uncorrelated EXISTS subquery in the RETURNING clause of a DELETE.
      - query: DELETE FROM T4 WHERE id = 8 RETURNING id, EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1) AS e
      - result: [{id: 8, e: true}]
---
setup:
  connect: 0
  steps:
    - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_1
    - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_2
    - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_3
    - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_4
    - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_5
---
# Tests for subqueries in views, whose definitions are compiled with the schema template.
test_block:
  name: subquery-in-view-definition
  connect: 0
  preset: single_repetition_ordered
  tests:
    -
      # View with an uncorrelated EXISTS subquery in the HAVING clause of a grouped query.
      - query: CREATE SCHEMA TEMPLATE subquery_view_template_1
                 CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
                 CREATE TABLE T4 (id INTEGER, i INTEGER, PRIMARY KEY(id))
                 CREATE INDEX T4_i AS SELECT i FROM T4
                 CREATE VIEW V AS SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = 1)
      - supported_version: 4.16.3.0
      - count: 0
    -
      - query: DROP SCHEMA TEMPLATE subquery_view_template_1
      - supported_version: 4.16.3.0
      - count: 0
    -
      # View with an EXISTS subquery in the HAVING clause of a grouped query, correlated to a non-grouping column (`T4.id`).
      - query: CREATE SCHEMA TEMPLATE subquery_view_template_2
                 CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
                 CREATE TABLE T4 (id INTEGER, i INTEGER, PRIMARY KEY(id))
                 CREATE INDEX T4_i AS SELECT i FROM T4
                 CREATE VIEW V AS SELECT T4.i FROM T4 GROUP BY T4.i HAVING EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id)
      - error: GROUPING_ERROR
    -
      # Index definition with an EXISTS subquery.
      - query: CREATE SCHEMA TEMPLATE subquery_view_template_3
                 CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
                 CREATE TABLE T4 (id INTEGER, i INTEGER, PRIMARY KEY(id))
                 CREATE INDEX T4_exists AS SELECT T4.i FROM T4 WHERE EXISTS (SELECT id FROM T1 WHERE T1.T2 = T4.id)
      - error: UNSUPPORTED_OPERATION
    -
      # Function with an EXISTS subquery in the default value of a parameter. This is not supported.
      - query: CREATE SCHEMA TEMPLATE subquery_view_template_4
                 CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
                 CREATE FUNCTION F(IN x BOOLEAN DEFAULT EXISTS (SELECT id FROM T1)) AS SELECT id FROM T1 WHERE x
      - supported_version: 4.15.3.0
      - error: UNSUPPORTED_QUERY
    -
      # Macro function with an EXISTS subquery in its body. This is not supported.
      - query: CREATE SCHEMA TEMPLATE subquery_view_template_5
                 CREATE TABLE T1 (id INTEGER, T2 INTEGER, PRIMARY KEY(id))
                 CREATE FUNCTION M(IN x INTEGER) RETURNS BOOLEAN AS EXISTS (SELECT id FROM T1 WHERE T1.id = x)
      - supported_version: 4.15.3.0
      - error: UNSUPPORTED_QUERY
    -
      # Drop the schema templates created above, if any.
      - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_4
      - count: 0
    -
      - query: DROP SCHEMA TEMPLATE IF EXISTS subquery_view_template_5
      - count: 0
...
