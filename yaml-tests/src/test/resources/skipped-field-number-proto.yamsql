# Tests that inserting into and selecting from a table whose proto schema skips
# field numbers works correctly, both at the top level (first_name=1, <2 skipped>,
# last_name=3, id=4, address=5) and inside a nested struct (street=1, <2 skipped>,
# city=3). The gaps must not cause column values to be shifted or misrouted.

---
options:
  supported_version: 4.12.2.0
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template if exists skipped_field_number_proto_template
    - query: drop database if exists /FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML
    - query: create database /FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML
    - load schema template: SKIPPED_FIELD_NUMBER_PROTO_TEMPLATE from com.apple.foundationdb.relational.yamltests.generated.testpersonskippedfield.TestPersonSkippedFieldProto
    - query: create schema /FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML/test with template SKIPPED_FIELD_NUMBER_PROTO_TEMPLATE
---
setup:
  connect: "jdbc:embed:/FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML?schema=TEST"
  steps:
    - query: INSERT INTO Person("first_name", "last_name", "id", "address")
        VALUES ('Alice', 'Smith', 1, ('123 Main St', 'Springfield')),
               ('Bob',   'Jones', 2, ('456 Oak Ave', 'Shelbyville')),
               ('Carol', 'White', 3, null),
               ('Dave',  'Brown', 4, ('789 Pine Rd', 'Shelbyville')),
               ('Eve',   'Davis', 5, null),
               ('Frank', 'White', 6, ('202 Maple Dr', 'Springfield'))
---
test_block:
  connect: "jdbc:embed:/FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML?schema=TEST"
  name: skipped-field-number-proto
  tests:
    -
      - query: select * from Person order by "id"
      - result: [{FIRST_NAME: 'Alice', LAST_NAME: 'Smith', ID: !l 1, ADDRESS: {STREET: '123 Main St', CITY: 'Springfield'}},
                 {FIRST_NAME: 'Bob',   LAST_NAME: 'Jones', ID: !l 2, ADDRESS: {STREET: '456 Oak Ave', CITY: 'Shelbyville'}},
                 {FIRST_NAME: 'Carol', LAST_NAME: 'White', ID: !l 3, ADDRESS: !null },
                 {FIRST_NAME: 'Dave',  LAST_NAME: 'Brown', ID: !l 4, ADDRESS: {STREET: '789 Pine Rd', CITY: 'Shelbyville'}},
                 {FIRST_NAME: 'Eve',   LAST_NAME: 'Davis', ID: !l 5, ADDRESS: !null },
                 {FIRST_NAME: 'Frank', LAST_NAME: 'White', ID: !l 6, ADDRESS: {STREET: '202 Maple Dr', CITY: 'Springfield'}}]
    -
      - query: select "first_name", "last_name" from Person where "id" = 2
      - result: [{FIRST_NAME: 'Bob', LAST_NAME: 'Jones'}]
    -
      - query: select "id", "first_name" from Person where "last_name" = 'White'
      - result: [{ID: !l 3, FIRST_NAME: 'Carol'},
                 {ID: !l 6, FIRST_NAME: 'Frank'}]
    -
      - query: select "address" from Person where "id" = 1
      - result: [{ADDRESS: {STREET: '123 Main St', CITY: 'Springfield'}}]
    -
      - query: select "address"."street", "address"."city" from Person where "id" = 2
      - result: [{STREET: '456 Oak Ave', CITY: 'Shelbyville'}]
---
# The queries below exercise `Type.maximumType()`, which merges the `Address` struct types in array literals,
# COALESCE(), IN lists, UNION ALL and CASE. The merged type must keep the type name and the field numbers 1 and 3.
test_block:
  connect: "jdbc:embed:/FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML?schema=TEST"
  name: skipped-field-number-proto-merged-types
  options:
    connection_options:
      CASE_SENSITIVE_IDENTIFIERS: true
  tests:
    -
      # An array literal over the same nested struct twice preserves its field numbers.
      - query: SELECT [p.address, p.address] AS a FROM PERSON p WHERE id = 1
      - supported_version: !current_version
      - resultMetadata: [{a: {array: [Address, {street: STRING}, {city: STRING}]}}]
      - result: [{a: [{street: '123 Main St', city: 'Springfield'}, {street: '123 Main St', city: 'Springfield'}]}]
    -
      # An array literal over the nested structs of two different rows preserves their field numbers.
      - query: SELECT [p.address, q.address] AS a FROM PERSON p, PERSON q WHERE p.id = 1 AND q.id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: {array: [Address, {street: STRING}, {city: STRING}]}}]
      - result: [{a: [{street: '123 Main St', city: 'Springfield'}, {street: '456 Oak Ave', city: 'Shelbyville'}]}]
    -
      # A COALESCE over the same nested struct twice preserves its field numbers.
      - query: SELECT COALESCE(p.address, p.address) AS a FROM PERSON p WHERE id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: {street: '456 Oak Ave', city: 'Shelbyville'}}]
    -
      # A COALESCE over the nested structs of two different rows, the first being null, preserves their field numbers.
      - query: SELECT COALESCE(p.address, q.address) AS a FROM PERSON p, PERSON q WHERE p.id = 3 AND q.id = 4
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: {street: '789 Pine Rd', city: 'Shelbyville'}}]
    -
      # A COALESCE over three nested structs, the first two being null, preserves their field numbers.
      - query: SELECT COALESCE(p.address, q.address, r.address) AS a FROM PERSON p, PERSON q, PERSON r WHERE p.id = 3 AND q.id = 5 AND r.id = 6
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: {street: '202 Maple Dr', city: 'Springfield'}}]
    -
      # An IN list over the same nested struct twice preserves its field numbers.
      - query: SELECT id FROM PERSON p WHERE p.address IN (p.address, p.address) AND id = 1
      - resultMetadata: [{id: BIGINT}]
      - result: [{id: !l 1}]
    -
      # An IN list over the nested structs of three different rows preserves their field numbers.
      - query: SELECT p.id AS id FROM PERSON p, PERSON q, PERSON r WHERE p.id = 1 AND q.id = 2 AND r.id = 4 AND q.address IN (p.address, r.address, q.address)
      - resultMetadata: [{id: BIGINT}]
      - result: [{id: !l 1}]
    -
      # A UNION ALL over the nested structs of two rows preserves their field numbers.
      - query: SELECT address AS a FROM PERSON WHERE id = 1 UNION ALL SELECT address AS a FROM PERSON WHERE id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - unorderedResult: [{a: {street: '123 Main St', city: 'Springfield'}},
                          {a: {street: '456 Oak Ave', city: 'Shelbyville'}}]
    -
      # A UNION ALL in which one branch yields a null nested struct preserves the field numbers of the other.
      - query: SELECT address AS a FROM PERSON WHERE id = 1 UNION ALL SELECT address AS a FROM PERSON WHERE id = 3
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - unorderedResult: [{a: {street: '123 Main St', city: 'Springfield'}},
                          {a: !null _}]
    -
      # A CASE expression that takes its first branch preserves the field numbers of the nested struct.
      - query: SELECT CASE WHEN p.id = 1 THEN p.address ELSE q.address END AS a FROM PERSON p, PERSON q WHERE p.id = 1 AND q.id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: {street: '123 Main St', city: 'Springfield'}}]
    -
      # A CASE expression that takes its second branch preserves the field numbers of the nested struct.
      - query: SELECT CASE WHEN p.id = 1 THEN p.address ELSE q.address END AS a FROM PERSON p, PERSON q WHERE p.id = 5 AND q.id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: {street: '456 Oak Ave', city: 'Shelbyville'}}]
    -
      # A CASE expression that takes a branch yielding a null nested struct returns null.
      - query: SELECT CASE WHEN p.id = 3 THEN p.address ELSE q.address END AS a FROM PERSON p, PERSON q WHERE p.id = 3 AND q.id = 2
      - supported_version: !current_version
      - resultMetadata: [{a: [Address, {street: STRING}, {city: STRING}]}]
      - result: [{a: !null _}]
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template skipped_field_number_proto_template
    - query: drop database /FRL/SKIPPED_FIELD_NUMBER_PROTO_YAML
...
