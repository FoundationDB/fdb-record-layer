---
options:
  supported_version: 4.10.20.0
---
schema_template:
    create table A(a1 string, primary key(a1))
    create table B(b1 integer, b2 string, primary key(b1))
    create table C(c1 integer, c2 string, primary key(c1))

    create index c2 as select c2 from c order by c2
---
setup:
  steps:
    - query: insert into A values
        (null),
        ('abcdefghijklmnopqrstuvwxyz'),
        ('___abcdef'),
        ('%%abcdef'),
        ('*abcdef'),
        ('ABCDEFGHIJKLMNOPQRSTUVWXYZ'),
        ('école'),
        ('ありがとう'),
        ('学校'),
        ('مدرسة'),
        ('👍abc'),
        ('😮‍💨abc'),
        ('(abcdefghijk)'),
        ('[abcdefghijk]'),
        ('{abcdefghijk}'),
        ('<acdefghijk>'),
        ('^$'),
        ('\\||%'),
        ('%'),
        ('a%z'),
        ('%z'),
        ('\xyz'),
        ('a?xyz')
        ;
    - query: insert into B values
        (1, 'Y'),
        (2, 'Z'),
        (3, 'A'),
        (4, 'Z'),
        (5, 'B');
    - query: insert into C values
        ( 1, 'alphabet'),
        ( 2, 'anticipation'),
        ( 3, 'aplomb'),
        ( 4, 'apple'),
        ( 5, 'appliance'),
        ( 6, 'application'),
        ( 7, 'awry'),
        ( 8, 'banal'),
        ( 9, 'banana'),
        (10, 'bench'),
        (11, 'bento'),
        (12, 'c'),
        (13, 'cabal'),
        (14, 'camel'),
        (15, 'canal'),
        (16, 'capital'),
        (17, 'catch-all'),
        (18, 'cavalry'),
        (19, 'cb')
        ;
---
test_block:
  tests:
    -
      - query: select * from B WHERE B2 LIKE 'X'
      - result: []
    -
      - query: select * from B WHERE B2 LIKE 'Y'
      - result: [{1, 'Y'}]
    -
      - query: select * from B WHERE B2 NOT LIKE 'Z'
      - result: [{1, 'Y'}, {3, 'A'}, {5, 'B'}]
    -
      - query: select * from B WHERE B2 NOT LIKE 'Z' ESCAPE 'Z'
      - supported_version: !current_version
      - error: INVALID_ESCAPE_SEQUENCE
    -
      - query: select * from B WHERE B2 NOT LIKE '\'
      - result: [{1, 'Y'}, {2, 'Z'}, {3, 'A'}, {4, Z}, {5, 'B'}]
    -
      - query: select * from B WHERE B2 NOT LIKE '\' ESCAPE '\'
      - supported_version: !current_version
      - error: INVALID_ESCAPE_SEQUENCE
    -
      - query: select * from B WHERE B2 LIKE 'Z'
      - result: [{2, 'Z'}, {4, 'Z'}]
---
test_block:
  tests:
    -
      - query: select * from A WHERE A1 LIKE NULL
      - initialVersionAtLeast: !current_version
      - result: []
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 NOT LIKE NULL
      - initialVersionAtLeast: !current_version
      - result: []
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE NULL LIKE NULL
      - initialVersionAtLeast: !current_version
      - result: []
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE NULL NOT LIKE NULL
      - initialVersionAtLeast: !current_version
      - result: []
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 LIKE 4
      - initialVersionAtLeast: !current_version
      # LIKE requires a string for its pattern
      - error: INVALID_ARGUMENT_FOR_FUNCTION
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from B WHERE B1 LIKE 'A'
      - initialVersionAtLeast: !current_version
      # LIKE requires a string for text field
      - error: INVALID_ARGUMENT_FOR_FUNCTION
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 LIKE 'A' ESCAPE 4
      # "ESCAPE" expects to be followed by a string literal.
      # Arguably, should be INVALID_ARGUMENT_FOR_FUNCTION
      - error: SYNTAX_ERROR
    -
      - query: select * from A WHERE A1 LIKE 'A' ESCAPE NULL
      # "ESCAPE" expects to be followed by a string literal.
      # Arguably, should be treated just like a missing ESCAPE
      - error: SYNTAX_ERROR
    -
      - query: select * from A WHERE A1 LIKE 'A'
      - result: []
    -
      - query: select * from A WHERE A1 LIKE 'abc'
      - result: []
    -
      - query: select * from A WHERE A1 LIKE '%abc'
      - result: [
          {'👍abc'},
          {'😮‍💨abc'},
        ]
    -
      - query: select * from A WHERE A1 LIKE '%abc%'
      - unorderedResult: [
          {'abcdefghijklmnopqrstuvwxyz'},
          {'___abcdef'},
          {'%%abcdef'},
          {'*abcdef'},
          {'👍abc'},
          {'😮‍💨abc'},
          {'(abcdefghijk)'},
          {'[abcdefghijk]'},
          {'{abcdefghijk}'}]
    -
      # All strings beginning with a single character, then 'abc'.
      # This includes '👍abc' even though '👍' is one Unicode codepoint split across two (UTF-16) chars
      - query: select * from A WHERE A1 LIKE '_abc%'
      - unorderedResult: [
          {'👍abc'},
          {'(abcdefghijk)'},
          {'[abcdefghijk]'},
          {'{abcdefghijk}'},
          {'*abcdef'}]
    -
      # All strings beginning with three characters then 'abc'.
      # This includes '😮‍💨abc' as '😮‍💨' is three Unicode codepoints despite being rendered as a single glyph
      - query: select * from A WHERE A1 LIKE '___abc%'
      - unorderedResult: [
          {'___abcdef'},
          {'😮‍💨abc'},
        ]
    -
      - query: select * from A WHERE A1 LIKE '%ABC%'
      - unorderedResult: [{'ABCDEFGHIJKLMNOPQRSTUVWXYZ'}]
    -
      - query: select * from A WHERE A1 LIKE '%ABC%X_Z'
      - unorderedResult: [{'ABCDEFGHIJKLMNOPQRSTUVWXYZ'}]
    -
      - query: select * from A WHERE A1 LIKE '%ABC%XY_Z'
      - unorderedResult: []
    -
      - query: select * from A WHERE A1 LIKE '__'
      - unorderedResult: [
          {'学校'},
          {'^$'},
          {'%z'}]
    -
      - query: select * from A WHERE A1 LIKE '_____'
      - unorderedResult: [
          {'école'},
          {'ありがとう'},
          {'مدرسة'},
          {'\\||%'},
          {'a?xyz'}]
    -
      - query: select * from C WHERE C2 LIKE '%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1:  1, C2: alphabet},
          { C1:  2, C2: anticipation},
          { C1:  3, C2: aplomb},
          { C1:  4, C2: apple},
          { C1:  5, C2: appliance},
          { C1:  6, C2: application},
          { C1:  7, C2: awry},
          { C1:  8, C2: banal},
          { C1:  9, C2: banana},
          { C1: 10, C2: bench},
          { C1: 11, C2: bento},
          { C1: 12, C2: c},
          { C1: 13, C2: cabal},
          { C1: 14, C2: camel},
          { C1: 15, C2: canal},
          { C1: 16, C2: capital},
          { C1: 17, C2: catch-all},
          { C1: 18, C2: cavalry},
          { C1: 19, C2: cb},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'a%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1:  1, C2: alphabet},
          { C1:  2, C2: anticipation},
          { C1:  3, C2: aplomb},
          { C1:  4, C2: apple},
          { C1:  5, C2: appliance},
          { C1:  6, C2: application},
          { C1:  7, C2: awry},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ap%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1:  3, C2: aplomb},
          { C1:  4, C2: apple},
          { C1:  5, C2: appliance},
          { C1:  6, C2: application},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'a%l%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1:  1, C2: alphabet},
          { C1:  3, C2: aplomb},
          { C1:  4, C2: apple},
          { C1:  5, C2: appliance},
          { C1:  6, C2: application},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'app%'
      - result: [
          { C1:  4, C2: apple},
          { C1:  5, C2: appliance},
          { C1:  6, C2: application},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'b%'
      - result: [
          { C1:  8, C2: banal},
          { C1:  9, C2: banana},
          { C1: 10, C2: bench},
          { C1: 11, C2: bento},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ba%'
      - result: [
          { C1:  8, C2: banal},
          { C1:  9, C2: banana},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ban%'
      - result: [
          { C1:  8, C2: banal},
          { C1:  9, C2: banana},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'bana%'
      - result: [
          { C1:  8, C2: banal},
          { C1:  9, C2: banana},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'banal%'
      - result: [
          { C1:  8, C2: banal},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'be%'
      - result: [
          { C1: 10, C2: bench},
          { C1: 11, C2: bento},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ben%'
      - result: [
          { C1: 10, C2: bench},
          { C1: 11, C2: bento},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'bent%'
      - result: [
          { C1: 11, C2: bento},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'c%'
      - result: [
          { C1: 12, C2: c},
          { C1: 13, C2: cabal},
          { C1: 14, C2: camel},
          { C1: 15, C2: canal},
          { C1: 16, C2: capital},
          { C1: 17, C2: catch-all},
          { C1: 18, C2: cavalry},
          { C1: 19, C2: cb},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ca%'
      # In theory, this could be executed optimally with prefix string scan with the prefix "ca"

      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1: 13, C2: cabal},
          { C1: 14, C2: camel},
          { C1: 15, C2: canal},
          { C1: 16, C2: capital},
          { C1: 17, C2: catch-all},
          { C1: 18, C2: cavalry},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ca_al'
      # In theory, this could be optimized with prefix string scan with the prefix "ca" followed by compensation
      # to handle filtering out based on the tail
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1: 13, C2: cabal},
          { C1: 15, C2: canal},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ca%al'
      # In theory, this could be optimized with prefix string scan with the prefix "ca" followed by compensation
      # to handle matching the tail
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1: 13, C2: cabal},
          { C1: 15, C2: canal},
          { C1: 16, C2: capital},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ca_al%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1: 13, C2: cabal},
          { C1: 15, C2: canal},
          { C1: 18, C2: cavalry},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'ca%al%'
      - explain: "COVERING(C2 <,> -> [C1: KEY:[2], C2: KEY:[0]]) | FILTER _.C2 LIKE @c7 ESCAPE 'null' | FETCH"
      - result: [
          { C1: 13, C2: cabal},
          { C1: 15, C2: canal},
          { C1: 16, C2: capital},
          { C1: 17, C2: catch-all},
          { C1: 18, C2: cavalry},
        ]
    -
      - query: select * from C WHERE C2 LIKE 'd%'
      - result: [
        ]
---
test_block:
  tests:
    -
      - query: select * from A WHERE A1 LIKE '%' ESCAPE 'ab'
      - initialVersionAtLeast: !current_version
      # Escape "character" is too long
      - error: INVALID_ESCAPE_CHARACTER
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 LIKE '%' ESCAPE ''
      - initialVersionAtLeast: !current_version
      # Escape character is empty
      - error: INVALID_ESCAPE_CHARACTER
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 LIKE '%' ESCAPE '👍'
      - initialVersionAtLeast: !current_version
      # Escape character currently treated as a length 2 string as that is the number of UTF-16 chars
      - error: INVALID_ESCAPE_CHARACTER
      - initialVersionLessThan: !current_version
      - error: INTERNAL_ERROR
    -
      - query: select * from A WHERE A1 LIKE '\%'
      - unorderedResult: [{'\\||%'}, {'\xyz'}]
    -
      - query: select * from A WHERE A1 LIKE '\%' ESCAPE '\'
      - result: [{'%'}]
    -
      - query: select * from A WHERE A1 LIKE '|_|_%' ESCAPE '|'
      - result: [{'___abcdef'}]
    -
      - query: select * from A WHERE A1 LIKE '\_%' ESCAPE '\'
      - result: [{'___abcdef'}]
    -
      - query: select * from A WHERE A1 LIKE '\_%' ESCAPE '|'
      - result: [{'\\||%'}, {'\xyz'}]
    -
      - query: select * from A WHERE A1 LIKE '\_%'
      - result: [{'\\||%'}, {'\xyz'}]
    -
      - query: select * from A WHERE A1 LIKE '\_\_\_abcdef' ESCAPE '\'
      - result: [{'___abcdef'}]
    -
      - query: select * from A WHERE A1 LIKE '\_\_\_______' ESCAPE '\'
      - result: [{'___abcdef'}]
    -
      - query: select * from A WHERE A1 LIKE '\__\_______' ESCAPE '\'
      - result: [{'___abcdef'}]
    -
      - query: select * from A WHERE A1 LIKE '\__\______\_' ESCAPE '\'
      - result: []
    -
      - query: select * from A WHERE A1 LIKE '%\%' ESCAPE '\'
      - unorderedResult: [{'\\||%'}, {'%'}]
    -
      - query: select * from A WHERE A1 LIKE '%%'
      - unorderedResult: [
           {'abcdefghijklmnopqrstuvwxyz'},
           {'___abcdef'},
           {'%%abcdef'},
           {'*abcdef'},
           {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'},
           {'école'},
           {'ありがとう'},
           {'学校'},
           {'مدرسة'},
           {'👍abc'},
           {'😮‍💨abc'},
           {'(abcdefghijk)'},
           {'[abcdefghijk]'},
           {'{abcdefghijk}'},
           {'<acdefghijk>'},
           {'^$'},
           {'\\||%'},
           {'%'},
           {'a%z'},
           {'%z'},
           {'\xyz'},
           {'a?xyz'},
      ]
    -
      # Reject using the character '%' as an escape instead of a wildcard.
      # If we did accept this, we'd expect it to only match the literal '%'.
      - query: select * from A WHERE A1 LIKE '%%' ESCAPE '%'
      - supported_version: !current_version
      - error: ESCAPE_CHARACTER_CONFLICT
    -
      - query: select * from A WHERE A1 LIKE '%%%'
      - unorderedResult: [
           {'abcdefghijklmnopqrstuvwxyz'},
           {'___abcdef'},
           {'%%abcdef'},
           {'*abcdef'},
           {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'},
           {'école'},
           {'ありがとう'},
           {'学校'},
           {'مدرسة'},
           {'👍abc'},
           {'😮‍💨abc'},
           {'(abcdefghijk)'},
           {'[abcdefghijk]'},
           {'{abcdefghijk}'},
           {'<acdefghijk>'},
           {'^$'},
           {'\\||%'},
           {'%'},
           {'a%z'},
           {'%z'},
           {'\xyz'},
           {'a?xyz'},
      ]
    -
      # Reject using the character '%' as an escape instead of a wildcard.
      # The odd number here would result in an INVALID_ESCAPE_SEQUENCE if we allowed it
      - query: select * from A WHERE A1 LIKE '%%%' ESCAPE '%'
      - supported_version: !current_version
      - error: ESCAPE_CHARACTER_CONFLICT
    -
      - query: select * from A WHERE A1 NOT LIKE '|_|_%' ESCAPE '|'
      - unorderedResult: [
          {'abcdefghijklmnopqrstuvwxyz'},
          {'%%abcdef'},
          {'*abcdef'},
          {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'},
          {'école'},
          {'ありがとう'},
          {'学校'},
    {'مدرسة'},
          {'👍abc'},
          {'😮‍💨abc'},
          {'(abcdefghijk)'},
          {'[abcdefghijk]'},
          {'{abcdefghijk}'},
          {'<acdefghijk>'},
          {'^$'},
          {'\\||%'},
          {'%'},
          {'a%z'},
          {'%z'},
          {'\xyz'},
          {'a?xyz'},
          ]
    -
      - query: select * from A WHERE A1 NOT LIKE '%'
      - unorderedResult: []
    -
      - query: select * from A WHERE A1 NOT LIKE '%abcde%'
      - unorderedResult: [
          {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'},
          {'<acdefghijk>'},
          {'école'},
          {'ありがとう'},
          {'学校'},
          {'مدرسة'},
          {'👍abc'},
          {'😮‍💨abc'},
          {'^$'},
          {'\\||%'},
          {'%'},
          {'a%z'},
          {'%z'},
          {'\xyz'},
          {'a?xyz'},
          ]
    -
      # Reject pattern where 'b' escapes a non-wildcard 'c'. If we instead interpreted this as dropping the 'b', then we'd find that this excluded '<acdefghijk>'
      - query: select * from A WHERE A1 NOT LIKE '%abcde%' ESCAPE 'b'
      - supported_version: !current_version
      - error: INVALID_ESCAPE_SEQUENCE
    -
      - query: select * from A WHERE A1 LIKE 'a%z'
      - unorderedResult: [
          {'abcdefghijklmnopqrstuvwxyz'},
          {'a%z'},
          {'a?xyz'},
        ]
    -
      # Unorthodox escape character 'a' escaping a wildcard
      - query: select * from A WHERE A1 LIKE 'a%z' ESCAPE 'a'
      - unorderedResult: [
          {'%z'},
        ]
    -
      - query: select * from A WHERE A1 LIKE 'aa%z'
      - unorderedResult: [
        ]
    -
      # Unorthodox escape character 'a' escaping itself. We should match a starting 'a' and then leave the '%' wildcard unescaped
      - query: select * from A WHERE A1 LIKE 'aa%z' ESCAPE 'a'
      - supported_version: !current_version
      # Should not match: \xyz. This string would get matched if double escape character got mapped to \\ in PatternForLikeValue
      - unorderedResult: [
          {'abcdefghijklmnopqrstuvwxyz'},
          {'a%z'},
          {'a?xyz'},
        ]
    -
      # Unorthodox escape character 'a' escaping itself
      - query: select * from A WHERE A1 LIKE 'aabcdefghijklmnopqrstuvwxyz' ESCAPE 'a'
      - supported_version: !current_version
      - unorderedResult: [
          {'abcdefghijklmnopqrstuvwxyz'},
        ]
    -
      - query: select * from A WHERE A1 LIKE 'a?%z' ESCAPE '?'
      - unorderedResult: [
          {'a%z'},
        ]
    -
      - query: select * from A WHERE A1 LIKE 'a??xyz' ESCAPE '?'
      - supported_version: !current_version
      - unorderedResult: [
          {'a?xyz'},
        ]
    -
      - query: select * from A WHERE A1 LIKE 'a??%z' ESCAPE '?'
      - supported_version: !current_version
      - unorderedResult: [
          {'a?xyz'},
        ]
    -
      - query: select * from A WHERE A1 LIKE '_abc%'
      - supported_version: !current_version
      - unorderedResult: [
          {'👍abc'},
          {'*abcdef'},
          {'(abcdefghijk)'},
          {'[abcdefghijk]'},
          {'{abcdefghijk}'},
        ]
    -
      # Reject sequences where the escape character is not followed by a special character
      - query: select * from A WHERE A1 LIKE '_abc%' ESCAPE 'b'
      - supported_version: !current_version
      - error: INVALID_ESCAPE_SEQUENCE
    -
      - query: select * from A WHERE A1 LIKE '%%abc%' ESCAPE 'b'
      - supported_version: !current_version
      # INVALID_ESCAPE_SEQUENCE (as 'b' precedes 'c')
      - error: INVALID_ESCAPE_SEQUENCE
    -
      - query: select * from A WHERE A1 LIKE 'b%b%abc%' ESCAPE 'b'
      - supported_version: !current_version
      # INVALID_ESCAPE_SEQUENCE (as 'b' precedes 'c')
      - error: INVALID_ESCAPE_SEQUENCE
    -
      # No error here as even though 'b' precedes 'c', it's escaped by another 'b'
      - query: select * from A WHERE A1 LIKE 'b%b%abbc%' ESCAPE 'b'
      - supported_version: !current_version
      - unorderedResult: [
          {'%%abcdef'},
        ]
...
