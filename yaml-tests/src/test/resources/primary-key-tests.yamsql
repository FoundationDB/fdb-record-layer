---
schema_template:
    CREATE TYPE AS STRUCT s1(a bigint, b bigint, q bigint, z bigint)
    create table t1(id s1, g bigint, primary key(id.a, id.b))
---
test_block:
  name: primary-key-tests
  preset: single_repetition_ordered
  tests:
    -
      - query: INSERT INTO T1
           VALUES ((1, 2, 3, 4), 5),
                  ((1, 2, 30, 40), 50)
      - error: UNIQUE_CONSTRAINT_VIOLATION
    -
      - query: SELECT COUNT(*) FROM T1
      - explain: "SCAN([IS T1]) | MAP (_ AS _0) | AGG (count_star(*) AS _0) GROUP BY () | ON EMPTY NULL | MAP (coalesce_long(_._0._0, 0l) AS _0)"
      - result: [{0}]
    -
      - query: INSERT INTO T1
          VALUES ((1, 2, 3, 4), 5),
                 ((1, 3, 30, 40), 50)
      - count: 2
    -
      - query: select * from t1;
      - result: [{{1, 2, 3, 4}, 5},
                 {{1, 3, 30, 40}, 50}]
    -
      # Tests that a lookup by a composite primary key can be ordered by a column no index orders by. Both columns of
      # the key are bound by equality, so at most one record qualifies and no sort is needed: the plan is a primary key
      # scan with two equalities.
      - query: SELECT g FROM T1 WHERE id.a = 1 AND id.b = 2 ORDER BY g
      - supported_version: !current_version
      - explain: "SCAN([IS T1, EQUALS promote(@c9 AS LONG), EQUALS promote(@c15 AS LONG)]) | MAP (_.G AS G)"
      - result: [{5}]
    -
      # Tests that binding only the first column of a composite primary key is not enough to order by `g`. Several
      # records qualify, so planning fails.
      - query: SELECT g FROM T1 WHERE id.a = 1 ORDER BY g
      - initialVersionLessThan: 4.17.2.0
      - error: UNSUPPORTED_QUERY
      - initialVersionAtLeast: 4.17.2.0
      - error: UNABLE_TO_PLAN
...
