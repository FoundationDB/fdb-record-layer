---
options:
    supported_version: !current_version
---
schema_template:
    create type as struct st1(y bigint, z string)
    create type as struct st2(w bigint, x bigint)
    create type as struct st3(u st2, v st1)
    create type as enum colour ('red', 'green', 'blue')
    create table nested(id bigint, r st3, primary key(id))
    create function f1 ( in a type st1 )
       as select id, r.v.y from nested where r.v.y = a.y and r.v.z = a.z
    create function f2 (in a type colour)
       as select a from range(1, 2)
---
setup:
  steps:
    - query: INSERT INTO NESTED VALUES (1, ((5, 11), (10, '100')))
---
test_block:
  name: sql-functions-with-struct-parameters
  tests:
    -
      - query: select * from f1((10, '100'));
      - result: [{!l 1, !l 10}]
    -
      - query: select * from temp_f1((10, '100'));
      - setup: create temporary function temp_f1 ( in a type st1 ) on commit drop function as select id, r.v.y from nested where r.v.y = a.y and r.v.z = a.z
      - result: [{!l 1, !l 10}]
    -
      - query: select * from f2('red')
      - result: [ { 'red' } ]
    -
      # TODO: this should be fixed as part of https://github.com/FoundationDB/fdb-record-layer/issues/4183
      - query: select * from f1(struct st1 (10, '100'));
      - error: UNKNOWN
