---
options:
  supported_version: !current_version
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template if exists WITH_AUXILIARY_TYPES_TEMPLATE
    - query: drop database if exists /FRL/WITH_AUXILIARY_TYPES_YAML
    - query: create database /FRL/WITH_AUXILIARY_TYPES_YAML
    - load schema template: WITH_AUXILIARY_TYPES_TEMPLATE from src/test/resources/import-schema-template/with_auxiliary_types_metadata.json
    - query: create schema /FRL/WITH_AUXILIARY_TYPES_YAML/TEST with template WITH_AUXILIARY_TYPES_TEMPLATE
---
setup:
  connect: "jdbc:embed:/FRL/WITH_AUXILIARY_TYPES_YAML?schema=TEST"
  steps:
    - query: INSERT INTO U VALUES
        (1, ( 5, 'foo') ),
        (2, ( 4, 'bar') ),
        (3, ( 3, 'foo') ),
        (4, ( 2, 'bar') ),
        (5, ( 1, 'foo') )
---
test_block:
  connect: "jdbc:embed:/FRL/WITH_AUXILIARY_TYPES_YAML?schema=TEST"
  name: with-auxiliary-types
  tests:
    -
      - query: SELECT * FROM func_a((5l, 'foo'))
      - setup: create temporary function func_a(IN R TYPE X) on commit drop function AS select * from U where R."a" = "x"."a" and R."b" = "x"."b"
      - result: [{ id: !l 1, x: {a: !l 5, b: "foo"} }]
