test_block:
  name: record-store-query-even-odd
  preset: single_repetition_ordered
  tests:
    -
      # query
      - query: select * from my_simple_record where str_value_indexed = 'even'
      - explain: "ISCAN(MY_SIMPLE_RECORD_STR_VALUE_INDEXED [EQUALS promote(@c7 AS STRING)])"
      - unorderedResult: [{REC_NO: 0, STR_VALUE_INDEXED: 'even', NUM_VALUE_UNIQUE: 1000, NUM_VALUE_2: !null _, NUM_VALUE_3_INDEXED: !null _, REPEATER: []},
                          {REC_NO: 2, STR_VALUE_INDEXED: 'even', NUM_VALUE_UNIQUE: 1002, NUM_VALUE_2: !null _, NUM_VALUE_3_INDEXED: !null _, REPEATER: []},
