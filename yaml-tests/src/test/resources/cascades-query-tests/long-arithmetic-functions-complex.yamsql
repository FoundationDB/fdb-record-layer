                          {REC_NO: 47, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 47, NUM_VALUE_2: 2, NUM_VALUE_3_INDEXED: 2, REPEATER: []},
                          {REC_NO: 51, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 51, NUM_VALUE_2: 1, NUM_VALUE_3_INDEXED: 0, REPEATER: []},
                          {REC_NO: 55, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 55, NUM_VALUE_2: 0, NUM_VALUE_3_INDEXED: 1, REPEATER: []},
