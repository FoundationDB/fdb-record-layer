                          {REC_NO: 67, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 67, NUM_VALUE_2: 2, NUM_VALUE_3_INDEXED: 1, REPEATER: []},
                          {REC_NO: 69, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 69, NUM_VALUE_2: 4, NUM_VALUE_3_INDEXED: 0, REPEATER: []},
