                          {SUM: 1, MASK: 0, ID: 66},
                          {SUM: 1, MASK: 4, ID: 70},
                          {SUM: 2, MASK: 0, ID: 72},
                          {SUM: 2, MASK: 4, ID: 76},
                          {SUM: 3, MASK: 4, ID: 78},
                          {SUM: 2, MASK: 0, ID: 80},
