               (67, 6),
               (68, 6),
               (69, 6),
               (70, 7),
               (71, 7),
               (72, 7),
               (73, 7),
               (74, 7),
               (75, 7),
               (76, 7),
               (77, 7),
               (78, 7),
               (79, 7),
               (80, 8),
               (81, 8),
               (82, 8),
