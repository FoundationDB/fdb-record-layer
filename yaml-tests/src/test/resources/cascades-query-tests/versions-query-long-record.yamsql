test_block:
  name: versions-query-long-record
  preset: single_repetition_ordered
  tests:
    -
      # versionsInProjectionOnlyFromScanOfOnlyType
      - query: select "__ROW_VERSION" as version, rec_no from my_long_record
      - explain: "SCAN(<,>) | TFILTER MY_LONG_RECORD | MAP (_.__ROW_VERSION AS VERSION, _.REC_NO AS REC_NO)"
      - unorderedResult: [
          {VERSION: !not_null _, REC_NO: 0},
          {VERSION: !not_null _, REC_NO: 1},
