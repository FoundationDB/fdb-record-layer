simple-query-graph-joins”EXPLAIN select rv.name as reviewerName, sq.rating as reviewRating from restaurant_record as r, (select reviewer, rating from r.reviews) sq, restaurant_reviewer as rv where r.name = 'name' and rv.id = sq.reviewerà-
