---
test_block:
  options:
    # Requires a fix in KeyComparisons that is not present in already-released versions, so this
    # only runs against the current build.
    supported_version: !current_version
  tests:
    -
      # Same logical plan as FDBInQueryTest.testInQueryOrOverlap: an IN list OR'd with another IN
      # list over the same indexed column, whose value sets overlap at 904 and 905. The Cascades
      # planner unions two IN-list index scans on my_simple_record_num_value_unique, deduplicating
      # via a comparison key on (num_value_unique, rec_no).
      - query: select rec_no, num_value_unique from my_simple_record
          where num_value_unique in (903, 905, 901) or num_value_unique in (906, 905, 904)
      - unorderedResult: [
          {REC_NO: 99, NUM_VALUE_UNIQUE: 901},
          {REC_NO: 97, NUM_VALUE_UNIQUE: 903},
          {REC_NO: 96, NUM_VALUE_UNIQUE: 904},
          {REC_NO: 95, NUM_VALUE_UNIQUE: 905},
          {REC_NO: 94, NUM_VALUE_UNIQUE: 906}]
...
