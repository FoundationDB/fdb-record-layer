---
test_block:
  name: versions-query
  preset: single_repetition_ordered
  tests:
    -
      # orderByVersion
      # The source sets no required results, so this returns whole records.
      - query: select * from my_simple_record order by "__ROW_VERSION"
      - explain: "ISCAN(VERSION_INDEX <,>) | MAP (_.REC_NO AS REC_NO, _.STR_VALUE_INDEXED AS STR_VALUE_INDEXED, _.NUM_VALUE_UNIQUE AS NUM_VALUE_UNIQUE, _.NUM_VALUE_2 AS NUM_VALUE_2, _.NUM_VALUE_3_INDEXED AS NUM_VALUE_3_INDEXED, _.REPEATER AS REPEATER)"
      - result: [
          {REC_NO: 0, STR_VALUE_INDEXED: 'even', NUM_VALUE_UNIQUE: 0, NUM_VALUE_2: 0, NUM_VALUE_3_INDEXED: 0, REPEATER: !null _},
          {REC_NO: 100, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 1, NUM_VALUE_2: 1, NUM_VALUE_3_INDEXED: 1, REPEATER: !null _},
          {REC_NO: 200, STR_VALUE_INDEXED: 'even', NUM_VALUE_UNIQUE: 2, NUM_VALUE_2: 2, NUM_VALUE_3_INDEXED: 2, REPEATER: !null _},
          {REC_NO: 300, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 3, NUM_VALUE_2: 0, NUM_VALUE_3_INDEXED: 3, REPEATER: !null _},
