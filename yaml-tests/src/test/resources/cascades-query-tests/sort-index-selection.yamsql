    -
      # testComplexQuery5r — the same, reversed.
      - query: select * from my_simple_record order by num_value_unique desc
      - explain: "ISCAN(MY_SIMPLE_RECORD_NUM_VALUE_UNIQUE <,> REVERSE)"
      - result: [{REC_NO: 0, STR_VALUE_INDEXED: 'even', NUM_VALUE_UNIQUE: 1000, NUM_VALUE_2: 0, NUM_VALUE_3_INDEXED: 0, REPEATER: []},
                 {REC_NO: 1, STR_VALUE_INDEXED: 'odd', NUM_VALUE_UNIQUE: 999, NUM_VALUE_2: 1, NUM_VALUE_3_INDEXED: 1, REPEATER: [0]},
