      - query: select * from my_record where header.num = 1 order by str_value
      - explain: "ISCAN(MY_RECORD_HEADER_NUM [EQUALS promote(@c9 AS INT)])"
      - result: [{HEADER: {REC_NO: 529, PATH: 'root', NUM: 1}, STR_VALUE: '1', REPEATED_INT: !null _}]
