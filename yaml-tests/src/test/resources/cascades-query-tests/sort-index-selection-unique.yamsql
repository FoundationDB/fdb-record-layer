test_block:
  name: sort-index-selection-unique
  preset: single_repetition_ordered
  tests:
    -
      # sortOnly
      - query: select * from my_simple_record order by num_value_unique
      - explain: "ISCAN(MY_SIMPLE_RECORD_NUM_VALUE_UNIQUE <,>)"
      - result: [{REC_NO: 722, STR_VALUE_INDEXED: !null _, NUM_VALUE_UNIQUE: 0, NUM_VALUE_2: !null _, NUM_VALUE_3_INDEXED: !null _, REPEATER: !null _},
