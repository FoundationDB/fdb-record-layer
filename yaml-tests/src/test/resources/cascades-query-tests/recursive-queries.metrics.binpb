recursive-queries-continuationsìEXPLAIN with recursive descendants as ( select id, parent from simple_hierarchical_record where id = 1 union all select h.id, h.parent from descendants as a, simple_hierarchical_record as h where h.parent = a.id) traversal order level_order select id, parent from descendants•0
