*joined-record-type-indexes-in-larger-joinsEXPLAIN SELECT "c"."name", "l"."qty", "qb"."band" FROM "qty_band" AS "qb", "order_note" AS "n", "line_item" AS "l", "state_info" AS "si", "orders" AS "o", "city_info" AS "ci", "customer" AS "c" WHERE "qb"."qty" = "l"."qty" AND "si"."state" = "ci"."state" AND "n"."order_no" = "o"."order_no" AND "l"."order_no" = "o"."order_no" AND "ci"."city" = "c"."city" AND "o"."cust_no" = "c"."cust_no" AND "n"."note" = 'gift'õV
#¶¦ÈÜ¢‚O¡„ Î¬þí(Ó0¡ï’á8ÁG@™„SCAN([IS city_info]) | FLATMAP q0 -> { SCAN([IS state_info, EQUALS q0.state]) | FLATMAP q1 -> { SCAN([IS order_note]) | FILTER _.note EQUALS promote(@c93 AS STRING) | FLATMAP q2 -> { SCAN([IS qty_band]) | FLATMAP q3 -> { ISCAN(mv_customer_items <,>) | FILTER q3.qty EQUALS _.joined_2.qty AND q2.order_no EQUALS _.joined_1.order_no AND q0.city EQUALS _.joined_0.city | MAP (_.joined_2 AS _0, _.joined_0 AS _1) AS q4 RETURN (q3 AS _0, q4._0 AS _1, q4._1 AS _2) } AS q5 RETURN (q5._0 AS _0, q5._1 AS _1, q5._2 AS _2) } AS q6 RETURN (q6._0 AS _0, q6._1 AS _1, q6._2 AS _2) } AS q7 RETURN (q7._2.name AS name, q7._1.qty AS qty, q7._0.band AS band) }ÆQdigraph G {
  fontname=courier;
  rankdir=BT;
  splines=line;
  1 [ label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="8"><tr><td align="left">Nested Loop Join</td></tr><tr><td align="left">FLATMAP (q128._2.name AS name, q128._1.qty AS qty, q128._0.band AS band)</td></tr></table>> color="black" shape="plain" style="solid" fillcolor="black" fontname="courier" fontsize="8" tooltip="RELATION(STRING AS name, LONG AS qty, STRING AS band)" ];
  2 [ label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="8"><tr><td align="left">Scan</td></tr><tr><td align="left">comparisons: [IS city_info]</td></tr></table>> color="black" shape="plain" style="solid" fillcolor="black" fontname="courier" fontsize="8" tooltip="RELATION(STRING AS city, STRING AS state)" ];
  3 [ label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="8"><tr><td align="left">Primary Storage</td></tr><tr><td align="left">record types: [order_note, line_item, qty_band, state_info, city_info, orders, customer]</td></tr></table>> color="black" shape="plain" style="filled" fillcolor="lightblue" fontname="courier" fontsize="8" tooltip="RELATION(STRING AS city, STRING AS state)" ];
