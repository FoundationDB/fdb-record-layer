  6 [ label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="8"><tr><td align="left">Nested Loop Join</td></tr><tr><td align="left">FLATMAP (q3010._0 AS _0, q3010._1 AS _1, q3010._2 AS _2, q26 AS _3)</td></tr></table>> color="black" shape="plain" style="solid" fillcolor="black" fontname="courier" fontsize="8" tooltip="RELATION(LONG AS cust_no, STRING AS name, STRING AS city AS _0, LONG AS order_no, LONG AS cust_no, LONG AS amount AS _1, LONG AS note_no, LONG AS order_no, STRING AS note AS _2, LONG AS qty, STRING AS band AS _3)" ];
