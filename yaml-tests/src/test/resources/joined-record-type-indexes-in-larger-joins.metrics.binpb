*joined-record-type-indexes-in-larger-joins®EXPLAIN SELECT "c"."name", "o"."amount", "l"."qty", "si"."region", "n"."note", "qb"."band" FROM "customer" AS "c", "orders" AS "o", "line_item" AS "l", "city_info" AS "ci", "state_info" AS "si", "order_note" AS "n", "qty_band" AS "qb" WHERE "c"."cust_no" = "o"."cust_no" AND "o"."order_no" = "l"."order_no" AND "c"."city" = "ci"."city" AND "ci"."state" = "si"."state" AND "o"."order_no" = "n"."order_no" AND "l"."qty" = "qb"."qty"×u
"ïþ‘”Î¶N¯x ëÖòŒ(»0øÖñÍ8®5@¨°SCAN([IS line_item]) | FLATMAP q0 -> { SCAN([IS state_info]) | FLATMAP q1 -> { SCAN([IS qty_band]) | FILTER q0.qty EQUALS _.qty | FLATMAP q2 -> { SCAN([IS order_note]) | FLATMAP q3 -> { SCAN([IS orders, EQUALS q0.order_no]) | FILTER _.order_no EQUALS q3.order_no | FLATMAP q4 -> { SCAN([IS customer, EQUALS q4.cust_no]) | FLATMAP q5 -> { SCAN([IS city_info]) | FILTER q5.city EQUALS _.city AND _.state EQUALS q1.state AS q6 RETURN q5 } AS q5 RETURN (q5 AS _0, q4 AS _1) } AS q8 RETURN (q8._0 AS _0, q8._1 AS _1, q3 AS _2) } AS q9 RETURN (q9._0 AS _0, q9._1 AS _1, q9._2 AS _2, q2 AS _3) } AS q10 RETURN (q10._0 AS _0, q10._1 AS _1, q1 AS _2, q10._2 AS _3, q10._3 AS _4) } AS q11 RETURN (q11._0.name AS name, q11._1.amount AS amount, q0.qty AS qty, q11._2.region AS region, q11._3.note AS note, q11._4.band AS band) }ýndigraph G {
