# Regression test for loading metadata JSON whose RecordTypeUnion carries multiple deprecated
# generations of the same record type, distinguished only by the com.apple.ckrecdb.field
# FieldOptions extension (type_id/type_generation_number). CommandUtil.loadRecordMetaDataFromJson
# must recover that extension from the raw JSON since JsonFormat itself cannot parse proto2
# extensions; otherwise the two generations collapse to identical FieldOptions and loading fails
# with "Duplicated options for different generations of Table MyRecord".
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template if exists deprecated_generations_template
    - query: drop database if exists /FRL/DEPRECATED_GENERATIONS_YAML
    - query: create database /FRL/DEPRECATED_GENERATIONS_YAML
    - load schema template: DEPRECATED_GENERATIONS_TEMPLATE from src/test/resources/deprecated-generations-metadata.json
    - query: create schema /FRL/DEPRECATED_GENERATIONS_YAML/test with template DEPRECATED_GENERATIONS_TEMPLATE
    - set schema state: "{\"name\": \"TEST\", \"database_id\": \"/FRL/DEPRECATED_GENERATIONS_YAML\", \"template_name\": \"DEPRECATED_GENERATIONS_TEMPLATE\", \"store_info\" : {\"formatVersion\": 2}}"
---
setup:
  connect: "jdbc:embed:/FRL/DEPRECATED_GENERATIONS_YAML?schema=TEST"
  steps:
    - query: INSERT INTO "MyRecord" VALUES (1), (2), (3)
---
test_block:
  connect: "jdbc:embed:/FRL/DEPRECATED_GENERATIONS_YAML?schema=TEST"
  name: deprecated-generations
  tests:
    -
      - query: select "ID" from "MyRecord" order by "ID"
      - result: [{ID: !l 1}, {ID: !l 2}, {ID: !l 3}]
    -
      - query: select count(*) from "MyRecord"
      - result: [{!l 3}]
---
setup:
  connect: "jdbc:embed:/__SYS?schema=CATALOG"
  steps:
    - query: drop schema template deprecated_generations_template
    - query: drop database /FRL/DEPRECATED_GENERATIONS_YAML
...
