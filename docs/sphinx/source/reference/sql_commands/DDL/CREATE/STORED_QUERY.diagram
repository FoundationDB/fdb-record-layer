Diagram(
    Stack(
        Sequence(
            Terminal('CREATE'),
            Terminal('STORED'),
            Terminal('QUERY'),
            NonTerminal('queryName'),
        ),
        Optional(
            Sequence(
                Terminal('('),
                OneOrMore(
                    Sequence(
                        NonTerminal('parameterName'),
                        NonTerminal('dataType'),
                        Optional(
                            Sequence(
                                Terminal('NOT'),
                                Terminal('NULL')
                            )
                        )
                    ),
                    Terminal(',')
                ),
                Terminal(')')
            )
        ),
        Sequence(
            Optional(
                NonTerminal('declareBlock')
            ),
            Terminal('AS'),
            NonTerminal('query')
        )
    )
)
